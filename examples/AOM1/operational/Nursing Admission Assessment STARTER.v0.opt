                        </interval>
                    </cardinality>
                </attributes>
                <attributes xsi:type="C_SINGLE_ATTRIBUTE">
                    <rm_attribute_name>name</rm_attribute_name>
                    <existence>
                        <lower_included>true</lower_included>
                        <upper_included>true</upper_included>
                        <lower_unbounded>false</lower_unbounded>
                        <upper_unbounded>false</upper_unbounded>
                        <lower>1</lower>
                        <upper>1</upper>
                    </existence>
                    <children xsi:type="C_COMPLEX_OBJECT">
                        <rm_type_name>DV_TEXT</rm_type_name>
                        <occurrences>
                            <lower_included>true</lower_included>
                            <upper_included>true</upper_included>
                            <lower_unbounded>false</lower_unbounded>
                            <upper_unbounded>false</upper_unbounded>
                            <lower>1</lower>
                            <upper>1</upper>
                        </occurrences>
                        <node_id></node_id>
                        <attributes xsi:type="C_SINGLE_ATTRIBUTE">
                            <rm_attribute_name>value</rm_attribute_name>
                            <existence>
                                <lower_included>true</lower_included>
                                <upper_included>true</upper_included>
                                <lower_unbounded>false</lower_unbounded>
                                <upper_unbounded>false</upper_unbounded>
                                <lower>1</lower>
                                <upper>1</upper>
                            </existence>
                            <children xsi:type="C_PRIMITIVE_OBJECT">
                                <rm_type_name>STRING</rm_type_name>
                                <occurrences>
                                    <lower_included>true</lower_included>
                                    <upper_included>true</upper_included>
                                    <lower_unbounded>false</lower_unbounded>
                                    <upper_unbounded>false</upper_unbounded>
                                    <lower>1</lower>
                                    <upper>1</upper>
                                </occurrences>
                                <node_id></node_id>
                                <item xsi:type="C_STRING">
                                    <list>Vital signs</list>
                                </item>
                            </children>
                        </attributes>
                    </children>
                </attributes>
                <archetype_id>
                    <value>openEHR-EHR-SECTION.adhoc.v1</value>
                </archetype_id>
                <term_definitions code="at0000">
                    <items id="text">Vital signs</items>
                    <items id="description">A generic section header which should be renamed in a template to suit a specific clinical context.</items>
                </term_definitions>
            </children>
            <cardinality>
                <is_ordered>false</is_ordered>
                <is_unique>false</is_unique>
                <interval>
                    <lower_included>true</lower_included>
                    <upper_included>false</upper_included>
                    <lower_unbounded>false</lower_unbounded>
                    <upper_unbounded>true</upper_unbounded>
                    <lower>1</lower>
                </interval>
            </cardinality>
        </attributes>
        <archetype_id>
            <value>openEHR-EHR-COMPOSITION.encounter.v1</value>
        </archetype_id>
        <template_id>
            <value>Nursing Admission Assessment STARTER.v0</value>
        </template_id>
        <term_definitions code="at0000">
            <items id="text">Nursing Admission Assessment STARTER</items>
            <items id="description">Interaction, contact or care event between a subject of care and healthcare provider(s).</items>
        </term_definitions>
        <term_definitions code="at0001">
            <items id="text">Tree</items>
            <items id="description">@ internal @</items>
        </term_definitions>
        <term_definitions code="at0002">
            <items id="text">Extension</items>
            <items id="description">Additional information required to extend the model with local content or to align with other reference models or formalisms.</items>
            <items id="comment">For example: local information requirements; or additional metadata to align with FHIR.</items>
        </term_definitions>
    </definition>
    <ontology archetype_id="openEHR-EHR-COMPOSITION.encounter.v1">
        <term_definitions language="pt-br">
            <items code="at0000">
                <items id="text">Nursing Admission Assessment</items>
                <items id="description">Interação, contato ou cuidado entre o sujeito do cuidado e profissional(is) de saúde.</items>
            </items>
            <items code="at0001">
                <items id="text">Tree</items>
                <items id="description">@ internal @</items>
            </items>
            <items code="at0002">
                <items id="text">Extensão</items>
                <items id="description">*Additional information required to extend the model with local content or to align with other reference models or formalisms. (en)</items>
                <items id="comment">*For example: local information requirements; or additional metadata to align with FHIR. (en)</items>
            </items>
        </term_definitions>
        <term_definitions language="sv">
            <items code="at0000">
                <items id="text">Nursing Admission Assessment</items>
                <items id="description">Interaktion, kontakt eller vårdhändelse mellan vårdtagare och vårdgivare inom hälso- och sjukvården.</items>
            </items>
            <items code="at0001">
                <items id="text">Tree</items>
                <items id="description">@ internal @</items>
            </items>
            <items code="at0002">
                <items id="text">Tilläggsinformation</items>
                <items id="description">Plats för tilläggsinformation som krävs för lokala anpassningar eller anpassning till andra referensmodeller eller formella krav.</items>
                <items id="comment">Exempelvis lokala informationskrav eller metadata för anpassning till FHIR.</items>
            </items>
        </term_definitions>
        <term_definitions language="de">
            <items code="at0000">
                <items id="text">Kontakt</items>
                <items id="description">Interaktion, Kontakt oder Versorgungsereignis, zwischen einem Versorgungsempfänger und einem Gesundheitsdienstleister.</items>
            </items>
            <items code="at0001">
                <items id="text">Tree</items>
                <items id="description">@ internal @</items>
            </items>
            <items code="at0002">
                <items id="text">Erweiterung</items>
                <items id="description">*Additional information required to extend the model with local content or to align with other reference models or formalisms. (en)</items>
                <items id="comment">*For example: local information requirements; or additional metadata to align with FHIR. (en)</items>
            </items>
        </term_definitions>
        <term_definitions language="nb">
            <items code="at0000">
                <items id="text">Klinisk kontakt</items>
                <items id="description">Interaksjon, kontakt eller omsorgshendelse mellom et individ og helsepersonell.</items>
            </items>
            <items code="at0001">
                <items id="text">Tree</items>
                <items id="description">@ internal @</items>
            </items>
            <items code="at0002">
                <items id="text">Utvidelse</items>
                <items id="description">Ytterligere informasjon som trengs for å kunne registrere lokalt definert innhold eller for å tilpasse til andre referansemodeller/formalismer.</items>
                <items id="comment">For eksempel lokale informasjonsbehov eller ytterligere metadata for å kunne tilpasse til tilsvarende konsepter i FHIR.</items>
            </items>
        </term_definitions>
    </ontology>
    <component_ontologies archetype_id="openEHR-EHR-EVALUATION.problem_diagnosis.v1">
        <term_definitions language="pt-br">
            <items code="at0000">
                <items id="text">Main Diagnosis</items>
                <items id="description">Detalhes sobre uma única condição de saúde identificada, lesões, deficiência ou qualquer outra questão que tenha impacto sobre o bem-estar físico, mental e / ou social de um indivíduo.</items>
                <items id="comment">Delimitação clara entre o âmbito de um problema em comparação a um diagnóstico, não é fácil de se conseguir na prática. Para fins de documentação clínica com este arquétipo, problema e diagnóstico são considerados como uma continuidade, com níveis crescentes de detalhes e evidência de apoio, geralmente fornecendo peso para o rótulo de "diagnóstico".</items>
            </items>
            <items code="at0001">
                <items id="text">structure</items>
                <items id="description">@ internal @</items>
            </items>
            <items code="at0002">
                <items id="text">Nome do Problema / Diagnóstico</items>
                <items id="description">Identificação do problema ou diagnóstico, por nome.</items>
                <items id="comment">Quando possível, é preferível usar a codificação do nome do problema ou diagnóstico com uma terminologia.</items>
            </items>
            <items code="at0003">
                <items id="text">Data / hora da reconhecimento clínico</items>
                <items id="description">Data / hora, estimada ou real, que o diagnóstico ou o problema foi reconhecido por um profissional de saúde.</items>
                <items id="comment">Datas parciais são aceitáveis. &#13;
Se o tema do cuidado está com idade inferior a um ano, então a data completa ou no mínimo o mês e o ano são necessários para permitir cálculos de idade precisos, por exemplo, se usado para conduzir apoio à decisão. Os dados capturados / importados como "Idade no momento do reconhecimento clínico" deve ser convertida para uma data usando o sujeito data de nascimento.</items>
            </items>
            <items code="at0005">
                <items id="text">Severidade</items>
                <items id="description">Uma avaliação global da severidade do problema ou diagnóstico.</items>
                <items id="comment">Se a severidade está incluída no nome do Problema / diagnóstico através de códigos pré-coordenados, este elemento de dados torna-se redundante. &#13;
Nota: a classificação mais específica da gravidade pode ser gravada utilizando os detalhes específicos SLOT.</items>
            </items>
            <items code="at0009">
                <items id="text">Descrição clínica</items>
                <items id="description">Descrição narrativa sobre o problema ou diagnóstico.</items>
                <items id="comment">Usar para fornecer conhecimento e contexto, incluindo evolução, episódios ou exacerbações, progresso e quaisquer outros detalhes relevantes, sobre o problema ou diagnóstico.</items>
            </items>
            <items code="at0012">
                <items id="text">Local do corpo</items>
                <items id="description">Simples identificação de um local do corpo para a localização do problema ou diagnóstico.</items>
                <items id="comment">A codificação do nome da localização anatômica com uma terminologia é preferível, quando possível.&#13;
Utilize este elemento de dados para gravar localizações anatômicas precoordenadas. Se os requisitos para gravar a localização anatômica são determinados em tempo real através da aplicação ou requerem uma modelagem mais complexa, como localizações relativas, em seguida, use o CLUSTER.anatomical_location ou CLUSTER.relative_location dentro do SLOT 'localização anatômica estruturada' neste arquétipo. Ocorrências para este elemento de dados são ilimitadas para permitir cenários clínicos tais como a descrição de uma erupção cutânea em vários locais, mas em que todos os outros atributos são idênticos. Se a localização anatômica é incluída ao nome do Problema / diagnóstico, através de códigos pré-coordenados, este elemento de dados torna-se redundante.</items>
            </items>
            <items code="at0030">
                <items id="text">Data /tempo de resolução</items>
                <items id="description">Data / tempo, estimado ou atual, de resolução ou de dispensa desse problema ou diagnóstico, como determinado por um profissional de saúde.</items>
                <items id="comment">Datas parciais são aceitáveis. &#13;
Se o tema do cuidado está com idade inferior a um ano, então a data completa ou no mínimo o mês e o ano são necessários para permitir cálculos de idade precisos, por exemplo, se usado para conduzir apoio à decisão. Os dados capturados / importados como "Idade na ocasião da resolução" deve ser convertida para uma data usando o sujeito data de nascimento.</items>
            </items>
            <items code="at0032">
                <items id="text">Tree(en)</items>
                <items id="description">@ internal @</items>
            </items>
            <items code="at0039">
                <items id="text">Local estruturado do corpo</items>
                <items id="description">A localização anatômica estruturada para o problema ou diagnóstico.</items>
                <items id="comment">Use esse SLOT para inserir os arquétipos CLUSTER.anatomical_location ou CLUSTER.relative_location se os requisitos para gravar a localização anatômica são determinados em tempo real através da aplicação ou requer uma modelagem mais complexa, como localizações relativas.&#13;
&#13;
Se a localização anatômica está incluída ao nome Problema / diagnóstico, através de códigos pré-coordenados, o uso deste SLOT torna-se redundante.</items>
            </items>
            <items code="at0043">
                <items id="text">Detalhes específicos</items>
                <items id="description">Detalhes que são adicionalmente necessários para gravar atributos como únicos deste problema ou diagnóstico.</items>
                <items id="comment">Pode incluir detalhes estruturados sobre a classificação ou a realização do diagnóstico; critérios de diagnóstico, critérios de classificação ou avaliação formal da severidade, como os critérios de terminologia comum para eventos adversos.</items>
            </items>
            <items code="at0046">
                <items id="text">Estado</items>
                <items id="description">Detalhes estruturados para localização, domínio, episódio ou aspectos específicos do fluxo de trabalho do processo de diagnóstico.</items>
                <items id="comment">Use o estado ou os qualificadores contexto com cuidado, pois eles são variáveis quando usados na prática e a interoperabilidade não pode ser assegurada, salvo se o uso está claramente definido com a comunidade de uso. &#13;
Por exemplo: evolução do estado: inicial, inativo, resolvido, em remissão; estado de evolução: inicial, provisório / trabalhando, final; estado temporal: presente, passado; estado do episodio: primeiro, novo, em curso; estado de admissão: admissão, alta; ou estado de prioridade: primário, secundário.</items>
            </items>
            <items code="at0047">
                <items id="text">Suave</items>
                <items id="description">O problema ou o diagnóstico não interfere na atividade normal ou causa danos à saúde, se não for tratado.</items>
            </items>
            <items code="at0048">
                <items id="text">Moderado</items>
                <items id="description">O problema ou o diagnóstico interfere na atividade normal ou prejudicará a saúde, se não for tratado.</items>
            </items>
            <items code="at0049">
                <items id="text">Severo</items>
                <items id="description">O problema ou diagnóstico impede a atividade normal ou causará sérios danos à saúde se não tratado.</items>
            </items>
            <items code="at0069">
                <items id="text">Comentário</items>
                <items id="description">Narrativa adicional sobre o problema ou diagnóstico, não capturados em outros campos.</items>
            </items>
            <items code="at0070">
                <items id="text">Ultima atualização</items>
                <items id="description">A data este problema ou diagnóstico foi atualizado pela última vez.</items>
            </items>
            <items code="at0071">
                <items id="text">Extensão</items>
                <items id="description">Informações adicionais necessárias para capturar o conteúdo local ou para alinhar com outros modelos de referência / formalismos.</items>
                <items id="comment">Por exemplo: requisitos de informação locais ou metadados adicionais para alinhar com FHIR ou CIMI equivalentes.</items>
            </items>
            <items code="at0072">
                <items id="text">Descrição do curso</items>
                <items id="description">Descrição narrativa sobre o curso do problema ou diagnóstico, desde o início.</items>
            </items>
            <items code="at0073">
                <items id="text">Certeza do diagnóstico</items>
                <items id="description">O nível de confiança da identificação do diagnóstico.</items>
                <items id="comment">*If an alternative valueset is required, these values can be added to the DV_TEXT data type in a template.(en)</items>
            </items>
            <items code="at0074">
                <items id="text">Suspeito</items>
                <items id="description">O diagnóstico foi identificado com um nível baixo de convicção.</items>
            </items>
            <items code="at0075">
                <items id="text">Provável</items>
                <items id="description">O diagnóstico foi identificado com um elevado grau de certeza.</items>
            </items>
            <items code="at0076">
                <items id="text">confirmado</items>
                <items id="description">O diagnóstico foi confirmado com base em critérios reconhecidos.</items>
            </items>
            <items code="at0077">
                <items id="text">Data / tempo de início</items>
                <items id="description">Data / tempo, estimada ou real, que os sinais ou sintomas do problema / diagnóstico foram observados pela primeira vez.</items>
                <items id="comment">Os dados capturados / importados como "A idade de início" devem ser convertidos para uma data, usando o sujeito data de nascimento.</items>
            </items>
            <items code="at0078">
                <items id="text">*Cause (en)</items>
                <items id="description">*A cause, set of causes, or manner of causation of the problem or diagnosis.(en)</items>
                <items id="comment">*Also known as 'aetiology' or 'etiology'. Coding with an external terminology is preferred, where possible.(en)</items>
            </items>
            <items code="at0079">
                <items id="text">*Variant (en)</items>
                <items id="description">*Specific variant or subtype of the Diagnosis, if relevant. (en)</items>
                <items id="comment">*For example: 'acute motor axonal neuropathy' as a variant of Guillain-Barre Syndrome. Coding of the name of the variant with a terminology is preferred, where possible.  (en)</items>
            </items>
            <items code="at0080">
                <items id="text">*DV_TEXT (en)</items>
                <items id="description"></items>
            </items>
        </term_definitions>
        <term_definitions language="sv">
            <items code="at0000">
                <items id="text">Main Diagnosis</items>
                <items id="description">Detaljer av ett enskilt identifierat hälsotillstånd, skada, funktionshinder eller något annat problem som påverkar individens fysiska, psykiska och eller sociala välbefinnande.</items>
                <items id="comment">Det är inte lätt att i praktiken uppnå en tydlig avgränsning mellan ett problem och en diagnos. Vid tillämpning av klinisk dokumentation med denna arketyp betraktas problem och diagnos som ett kontinuum, med plats för fler detaljer och stödjande bevis som vanligtvis ger tyngd till etiketten ”diagnos”.</items>
            </items>
            <items code="at0001">
                <items id="text">structure</items>
                <items id="description">@ internal @</items>
            </items>
            <items code="at0002">
                <items id="text">Benämning på problem/diagnos</items>
                <items id="description">Problemets eller diagnosens benämning.</items>
                <items id="comment">Om möjligt, koda problemet eller diagnosen med en terminologi.</items>
            </items>
            <items code="at0003">
                <items id="text">Datum och tid för klinisk bekräftelse</items>
                <items id="description">Uppskattat eller reellt datum och tid när problemets eller diagnosens tecken eller symtom först bekräftades av sjukvårdspersonal.</items>
                <items id="comment">Partiellt datum är acceptabelt. Om patienten är under ett år, är ett fullständigt datum eller minimum månad och år nödvändigt för korrekta åldersberäkningar, exempelvis om de används för beslutsstöd. Dokumenterad eller importerad "bekräftad debutålder" bör beräknas till ett datum för debut baserat på födelsedatum.</items>
            </items>
            <items code="at0005">
                <items id="text">Svårighetsgrad</items>
                <items id="description">En bedömning av problemets eller diagnosens totala svårighetsgrad.</items>
                <items id="comment">Det här fältet är överflödigt om svårighetsgraden är inkluderad i benämningen av problemet eller diagnosen med prekoordinerade koder. En mer specifik svårighetsgrad kan dokumenteras i SLOT ”Specifika detaljer”.</items>
            </items>
            <items code="at0009">
                <items id="text">Klinisk beskrivning</items>
                <items id="description">Beskrivning av problemet eller diagnosen.</items>
                <items id="comment">Används för att ge en bakgrund och sammanhang, inklusive utveckling, episoder, framsteg och andra relevanta detaljer om problemet eller diagnosen.</items>
            </items>
            <items code="at0012">
                <items id="text">Anatomisk plats</items>
                <items id="description">Identifiering av problemets eller diagnosens anatomiska plats.</items>
                <items id="comment">Om möjligt, koda den anatomiska platsens namn med en terminologi. Använd det här fältet för att dokumentera prekoordinerade anatomiska platser. &#13;
&#13;
Om kraven på dokumentation av den anatomiska platsen bestäms vid körning av applikationen eller kräver mer komplex modellering, till exempel relativa platser (exempelvis 3 cm ovanför vänster knä), använd CLUSTER.anatomical_location eller CLUSTER.relative_location i SLOT "Strukturerad anatomisk plats" i denna arketyp. Förekomster av detta dataelement är obegränsat för att möjliggöra kliniska scenarier som att beskriva utslag på flera platser, men där alla andra egenskaper är identiska. Om den anatomiska platsen ingår i "Benämning på problem/diagnos" genom prekoordinerade koder blir detta fält överflödigt.</items>
            </items>
            <items code="at0030">
                <items id="text">Datum och tid för tillfrisknande</items>
                <items id="description">Av sjukvårdspersonal uppskattat eller faktiskt datum och tid för tillfrisknande eller remission.</items>
                <items id="comment">Partiellt datum är acceptabelt. Om patienten är under ett år, är ett fullständigt datum eller minimum månad och år nödvändigt för korrekta åldersberäkningar, exempelvis om de används för beslutsstöd. Dokumenterad eller importerad "bekräftat tillfrisknande" bör beräknas till ett datum för tillfrisknande baserat på födelsedatum.</items>
            </items>
            <items code="at0032">
                <items id="text">Tree</items>
                <items id="description">@ internal @</items>
            </items>
            <items code="at0039">
                <items id="text">Strukturerad kroppslokalisation</items>
                <items id="description">En strukturerad anatomisk lokalisation för problemet eller diagnosen.</items>
                <items id="comment">Använd denna SLOT för att infoga CLUSTER.anatomical_location- eller CLUSTER.relative_location-arketyper om kroppslokalisationen bestäms automatiskt av vissa IT-system eller kräver mer komplicerad modellering, som exempelvis relativa platser. Det här datafältet är överflödigt om kroppslokalisationen är inkluderad i benämningen av problemet eller diagnosen med prekoordinerade koder.</items>
            </items>
            <items code="at0043">
                <items id="text">Specifika detaljer</items>
                <items id="description">Ytterligare detaljer som krävs för att dokumentera de egenskaper som är unika för problemet eller diagnosen.</items>
                <items id="comment">Datafältet kan innehålla strukturerade detaljer om klassificering eller stadieindelning av diagnosen, som diagnostiska kriterier, klassificeringskriterier eller formella bedömningar av allvarlighetsgraden, såsom Common Terminology Criteria for Adverse Events.</items>
            </items>
            <items code="at0046">
                <items id="text">Status</items>
                <items id="description">Strukturerade specifika detaljer om den diagnostiska processen såsom plats, område, episod eller arbetsflöde.</items>
                <items id="comment">Använd datafältet med försiktighet, eftersom användningen varierar i praktiken och interoperabilitet endast kan säkerställas om användningen är tydligt definierad. &#13;
Exempelvis status på:&#13;
- Aktivitet, såsom aktiv, inaktiv, tillfrisknad, i remission&#13;
- Förlopp, såsom initial, interimistisk, preliminär, slutlig&#13;
- Tid, såsom nuvarande, tidigare&#13;
- Episod, såsom första, nytt, pågående&#13;
- Vårdtillfälle, såsom inskrivning, utskrivning&#13;
- Klassificering, såsom primär, sekundär</items>
            </items>
            <items code="at0047">
                <items id="text">Lindrig</items>
                <items id="description">Problemet eller diagnosen påverkar inte normal aktivitet och kan inte orsaka skador på hälsan utan behandling.</items>
            </items>
            <items code="at0048">
                <items id="text">Måttlig</items>
                <items id="description">Problemet eller diagnosen stör normal aktivitet och kan skada hälsan utan behandling.</items>
            </items>
            <items code="at0049">
                <items id="text">Svår</items>
                <items id="description">Problemet eller diagnosen förhindrar normal aktivitet och kan allvarligt skada hälsan utan behandling.</items>
            </items>
            <items code="at0069">
                <items id="text">Kommentar</items>
                <items id="description">Ytterligare beskrivning av problemet eller diagnosen som inte dokumenterats i andra fält.</items>
            </items>
            <items code="at0070">
                <items id="text">Senast uppdaterad</items>
                <items id="description">Datum då dokumentation om problemet eller diagnosen senast uppdaterades.</items>
            </items>
            <items code="at0071">
                <items id="text">Tilläggsinformation</items>
                <items id="description">Plats för tilläggsinformation som krävs för lokala anpassningar eller anpassning till andra referensmodeller eller formella krav.</items>
                <items id="comment">Exempelvis lokala informationskrav eller metadata för anpassning till FHIR.</items>
            </items>
            <items code="at0072">
                <items id="text">Förlopp</items>
                <items id="description">Beskrivning av problemets eller diagnosens förlopp sedan debuten.</items>
            </items>
            <items code="at0073">
                <items id="text">Diagnostisk säkerhet</items>
                <items id="description">Graden av säkerhet vid fastställande av diagnosen.</items>
                <items id="comment">Använd datatypen DV_TEXT i en template om en alternativ graderingsskala krävs.&#13;
&#13;
</items>
            </items>
            <items code="at0074">
                <items id="text">Misstänkt</items>
                <items id="description">Diagnosen har bekräftats med en låg grad av säkerhet.</items>
            </items>
            <items code="at0075">
                <items id="text">Sannolik</items>
                <items id="description">Diagnosen har bekräftats med en hög grad av säkerhet.</items>
            </items>
            <items code="at0076">
                <items id="text">Bekräftad</items>
                <items id="description">Diagnosen har bekräftats utifrån kända kriterier.</items>
            </items>
            <items code="at0077">
                <items id="text">Datum och tid för debut</items>
                <items id="description">Uppskattat eller reellt datum och tid när problemets eller diagnosens tecken eller symtom först observerades.</items>
                <items id="comment">Dokumenterad eller importerad "debutålder" bör beräknas till ett datum för debut baserat på födelsedatum.</items>
            </items>
            <items code="at0078">
                <items id="text">Orsak</items>
                <items id="description">En eller flera orsaker till problemet eller diagnosen, eller dess uppkomstsätt.</items>
                <items id="comment">Även känt som "etiologi". Om möjligt, koda med en terminologi.</items>
            </items>
            <items code="at0079">
                <items id="text">Specificering</items>
                <items id="description">Specificering av diagnosen, där det är relevant.</items>
                <items id="comment">Exempelvis "akut motorisk axonal neuropati" som en specificering av Guillain-Barre-syndromet. Om möjligt, koda specificeringen med en terminologi.</items>
            </items>
            <items code="at0080">
                <items id="text">Påverkan</items>
                <items id="description">Övergripande bedömning av hur ett hälsoproblem påverkar patienten.</items>
                <items id="comment">Samma diagnos, med samma allvarlighetsgrad, kan ha olika påverkan på olika patienter. Den samlade påverkan av hälsoproblemet justeras i detta datafält utifrån patientens individuella förutsättningar.&#13;
&#13;
Exempel: Två patienter har diagnosen ytlig brännskada. Den ena är frisk, medan den andra har diabetes. För en patient med diabetes är påverkan av problemet större, eftersom risken för infektion är högre och läkningstiden längre.&#13;
&#13;
Detta datafält är avsett att fånga flera typer av påverkan, inklusive men inte begränsat till klinisk behandling, funktion i hemmet och vardagen, arbetsliv och yrkesutövning.</items>
            </items>
        </term_definitions>
        <term_definitions language="de">
            <items code="at0000">
                <items id="text">Main Diagnosis</items>
                <items id="description">*Details about a single identified health condition, injury, disability or any other issue which impacts on the physical, mental and/or social well-being of an individual.(en)</items>
                <items id="comment">*Clear delineation between the scope of a problem versus a diagnosis is not easy to achieve in practice. For the purposes of clinical documentation with this archetype, problem and diagnosis are regarded as a continuum, with increasing levels of detail and supportive evidence usually providing weight towards the label of 'diagnosis'.(en)</items>
            </items>
            <items code="at0001">
                <items id="text">Structure</items>
                <items id="description">@ internal @</items>
            </items>
            <items code="at0002">
                <items id="text">Diagnose-/Symptombezeichnung</items>
                <items id="description">Namentliche Bezeichnung des Symptoms ("medical Problem") oder der Diagnose.</items>
                <items id="comment">Wo möglich, ist die Kodierung des Problems oder der Diagnose über eine Terminologie zu bevorzugen.</items>
            </items>
            <items code="at0003">
                <items id="text">Datum/Zeitpunkt der klinischen Feststellung</items>
                <items id="description">Geschätzte oder exakte Zeit (bzw. Datum), zu der die Diagnose oder das Problem von einer medizinischen Fachkraft festgestellt wurde.</items>
                <items id="comment">Unvollständige Datumsangaben sind zulässig. Wenn der Patient unter einem Jahr alt ist, dann ist das vollständige Datum oder ein Minimum von Monat und Jahr notwendig, um genaue Altersberechnungen zu ermöglichen - z.B. wenn es zur Entscheidungsunterstützung verwendet wird. Datumswerte, die als "Alter zum Zeitpunkt der klinischen Feststellung" erfasst/importiert werden, sollten anhand des Geburtsdatums der Person in ein Datum umgewandelt werden.</items>
            </items>
            <items code="at0005">
                <items id="text">Schweregrad</items>
                <items id="description">Eine Gesamtbeurteilung des Schweregrades des Problems oder der Diagnose.</items>
                <items id="comment">Ist der Schweregrad über vordefinierte Codes im Element "Name des Problems/ der Diagnose" enthalten, wird dieses Datenelement überflüssig. Hinweis: Eine spezifischere Einstufung des Schweregrads kann mit Hilfe des SLOTs "Spezifische Angaben" angegeben werden.</items>
            </items>
            <items code="at0009">
                <items id="text">Klinische Beschreibung</items>
                <items id="description">Beschreibung des Problems oder der Diagnose.</items>
                <items id="comment">Wird verwendet, um Hintergrund und Kontext, einschließlich Entwicklung, Episoden oder Verschlechterungen, Fortschritt und andere relevante Details über das Problem oder die Diagnose zu liefern.</items>
            </items>
            <items code="at0012">
                <items id="text">Körperstelle</items>
                <items id="description">Identifikation einer einfachen Körperstelle zur Lokalisierung des Problems oder der Diagnose.</items>
                <items id="comment">Wo dies möglich ist, ist die Kodierung der anatomischen Lokalisation über eine Terminologie zu bevorzugen. Verwenden Sie dieses Datenelement, um vorab präkoordinierte anatomische Lokalisationen zu erfassen. Wenn die Anforderungen an die Erfassung der anatomischen Lokalisation zur Laufzeit durch die Anwendung bestimmt werden oder komplexere Modellierungen, wie z.B. relative Lokalisationen erforderlich sind, dann verwenden Sie in diesem Archetyp den CLUSTER.anatomical_location oder CLUSTER.relative_location innerhalb des SLOT 'Structured anatomical location'. Die Anzahl für dieses Datenelement ist unbegrenzt, um klinische Szenarien wie die Beschreibung eines Hautausschlags an mehreren Stellen zu ermöglichen, wobei jedoch alle anderen Attribute identisch sind. Falls die anatomische Lage über präkoordinierte Codes im Namen des Problems/Diagnose enthalten ist, wird dieses Datenelement überflüssig.</items>
            </items>
            <items code="at0030">
                <items id="text">Datum/Zeitpunkt der Genesung</items>
                <items id="description">Geschätzte oder exakte Zeit (bzw. Datum), zu der von einer medizinischen Fachkraft die Genesung oder die Remission des Problems oder der Diagnose festgestellt wurde.</items>
                <items id="comment">Unvollständige Datumsangaben sind zulässig. Wenn der Patient unter einem Jahr alt ist, dann ist das vollständige Datum oder ein Minimum von Monat und Jahr notwendig, um genaue Altersberechnungen zu ermöglichen - z.B. wenn es zur Entscheidungsunterstützung verwendet wird. Datumswerte, die als "Alter zum Zeitpunkt der Genesung" erfasst/importiert werden, sollten anhand des Geburtsdatums der Person in ein Datum umgewandelt werden.</items>
            </items>
            <items code="at0032">
                <items id="text">Tree</items>
                <items id="description">@ internal @</items>
            </items>
            <items code="at0039">
                <items id="text">Strukturierte Körperstelle</items>
                <items id="description">Eine strukturierte anatomische Beschreibung der Körperstelle, an der das Problem oder die Diagnose auftreten.</items>
                <items id="comment">Verwenden Sie diesen SLOT, um die Archetypen CLUSTER.anatomical_location oder CLUSTER.relative_location einzufügen, wenn die Anforderungen für die Aufnahme der anatomischen Position zur Laufzeit der Anwendung bestimmt werden oder komplexere Modellierungen wie z.B. relative Positionen erforderlich sind. Ist die anatomische Körperstelle über präkoordinierte Codes im Namen des Problems/Diagnose enthalten, wird die Verwendung dieses SLOT überflüssig.</items>
            </items>
            <items code="at0043">
                <items id="text">Spezifische Angaben</items>
                <items id="description">Zusätzlich benötigte Angaben, welche als eindeutige Merkmale des Problem/der Diagnose erfasst werden sollten.</items>
                <items id="comment">Hier können strukturierte Angaben über die Einstufung oder das Stadium der Diagnose enthalten sein; diagnostische Kriterien, Klassifizierungskriterien oder formale Bewertungen des Schweregrades wie z.B. "Common Terminology Criteria for Adverse Events".</items>
            </items>
            <items code="at0046">
                <items id="text">Status</items>
                <items id="description">Strukturierte Angaben zu standort-, domänen-, episoden- oder workflow-spezifischen Aspekten des diagnostischen Prozesses.</items>
                <items id="comment">Verwenden Sie Status- oder Kontext-Merkmale mit Vorsicht, da sie in der Praxis variabel eingesetzt werden und die Interoperabilität nicht gewährleistet werden kann, sofern die Verwendung nicht mit der Nutzungsgemeinschaft klar abgestimmt wird. Beispiel: aktiver Status - aktiv, inaktiv, genesen, in Remission; Entwicklungsstatus - initial, interim/working, final; zeitlicher Status - aktuell, vergangen; Episodenstatus - erstmalig, neu, laufend; Aufnahmestatus - Aufnahme, Entlassung; oder Prioritätsstatus - primär, sekundär.</items>
            </items>
            <items code="at0047">
                <items id="text">Leicht</items>
                <items id="description">Das Problem oder die Diagnose beeinträchtigt die normale Aktivität nicht, bzw. verursacht nicht bleibende gesundheitliche Schäden, falls es nicht behandelt wird.</items>
            </items>
            <items code="at0048">
                <items id="text">Mäßig</items>
                <items id="description">Das Problem oder die Diagnose beeinträchtigt die normale Aktivität oder verursacht bleibende gesundheitliche Schäden, falls es nicht behandelt wird.</items>
            </items>
            <items code="at0049">
                <items id="text">Schwer</items>
                <items id="description">Das Problem oder die Diagnose verhindert die normale Aktivität oder verursacht schwerwiegende gesundheitliche Schäden, falls es nicht behandelt wird.</items>
            </items>
            <items code="at0069">
                <items id="text">Kommentar</items>
                <items id="description">Ergänzende Beschreibung des Problems oder der Diagnose, die nicht anderweitig erfasst wurde.</items>
            </items>
            <items code="at0070">
                <items id="text">Zuletzt aktualisiert</items>
                <items id="description">Datum der letzten Aktualisierung der Diagnose bzw. des Problems.</items>
            </items>
            <items code="at0071">
                <items id="text">Erweiterung</items>
                <items id="description">Zusätzliche Informationen zur Erfassung lokaler Inhalte oder Anpassung an andere Referenzmodelle/Formalismen.</items>
                <items id="comment">Zum Beispiel: Lokaler Informationsbedarf oder zusätzliche Metadaten zur Anpassung an FHIR-Ressourcen oder CIMI-Modelle.</items>
            </items>
            <items code="at0072">
                <items id="text">Beschreibung des Verlaufs</items>
                <items id="description">Beschreibung des Problem-/ Diagnoseverlaufs seit Beginn.</items>
            </items>
            <items code="at0073">
                <items id="text">Diagnostische Sicherheit</items>
                <items id="description">Grad der Sicherheit, mit der die Diagnose festgestellt wurde.</items>
                <items id="comment">Wenn ein alternativer Wertesatz benötigt wird, können diese Werte in einem Template zum Datentyp DV_TEXT hinzugefügt werden.</items>
            </items>
            <items code="at0074">
                <items id="text">Vermutet</items>
                <items id="description">Die Diagnose wurde mit einem niedrigen Grad an Sicherheit gestellt.</items>
            </items>
            <items code="at0075">
                <items id="text">Wahrscheinlich</items>
                <items id="description">Die Diagnose wurde mit einem hohen Maß an Sicherheit gestellt.</items>
            </items>
            <items code="at0076">
                <items id="text">Bestätigt</items>
                <items id="description">Die Diagnose wurde anhand anerkannter Kriterien bestätigt.</items>
            </items>
            <items code="at0077">
                <items id="text">Datum/ Zeitpunkt des Auftretens/ der Erstdiagnose</items>
                <items id="description">Geschätzte oder exakte Zeit (bzw. Datum), zu der die Krankheitsanzeichen oder Symptome zum ersten mal beobachtet wurden.</items>
                <items id="comment">Datumswerte, die als "Alter zu Beginn" erfasst/importiert werden, sollten anhand des Geburtsdatums der Person in ein Datum umgewandelt werden.</items>
            </items>
            <items code="at0078">
                <items id="text">Ätiologie</items>
                <items id="description">Die Ursache, eine Reihe von Ursachen oder eine Art und Weise der Verursachung des Problems oder der Diagnose.</items>
                <items id="comment">Die Codierung mit einer externen Terminologie wird nach Möglichkeit bevorzugt.</items>
            </items>
            <items code="at0079">
                <items id="text">Subtyp</items>
                <items id="description">Spezifische Variante oder Subtyp der Diagnose, falls relevant.</items>
                <items id="comment">Zum Beispiel: „Akute motorische axonale Neuropathie“ als Variante des Guillain-Barre-Syndroms. Wo möglich, ist die Kodierung des Namens der Variante über eine Terminologie zu bevorzugen.</items>
            </items>
            <items code="at0080">
                <items id="text">Auswirkungen</items>
                <items id="description">Gesamtbeurteilung der Auswirkungen der Diagnose/des Symptoms auf den Patienten.</items>
                <items id="comment">Dieselbe Diagnose mit demselben Schweregrad kann sich bei jedem Patienten unterschiedlich auswirken. Dieser Relevanzfaktor bedeutet, dass die Gesamtbelastung durch dieses Gesundheitsproblem entsprechend den Merkmalen des Patienten angepasst werden muss.&#13;
Beispiel: Zwei Patienten haben dieselbe Diagnose: Verbrennungen ersten Grades.&#13;
Der eine ist gesund, der andere leidet an Diabetes.&#13;
Die Belastung durch dieses Problem ist bei einem Diabetiker GRÖSSER (höheres Infektionsrisiko …, längere Heilungsdauer).&#13;
Dieses Element soll verschiedene Arten von Auswirkungen berücksichtigen, darunter unter anderem: klinische Behandlung, Alltag zu Hause, Berufsleben.</items>
            </items>
        </term_definitions>
        <term_definitions language="nb">
            <items code="at0000">
                <items id="text">Main Diagnosis</items>
                <items id="description">Detaljer om én identifisert helsetilstand, skade, funksjonshemming eller annet forhold som påvirker et individs fysiske, mentale og/eller sosiale velvære.&#13;
</items>
                <items id="comment">Det er i praksis ikke lett å oppnå et klart skille mellom et problem og en diagnose. I klinisk dokumentasjon med denne arketypen ses problem og diagnose som et kontinuum, med økende krav til detaljer og støttende evidens for å underbygge en diagnose.</items>
            </items>
            <items code="at0001">
                <items id="text">structure</items>
                <items id="description">@ internal @</items>
            </items>
            <items code="at0002">
                <items id="text">Problem/diagnosenavn</items>
                <items id="description">Identifisering av problemet eller diagnosen ved hjelp av navn.</items>
                <items id="comment">Koding av navnet på problemet eller diagnosen med en terminologi er foretrukket hvis mulig.</items>
            </items>
            <items code="at0003">
                <items id="text">Dato/tid for klinisk bekreftelse</items>
                <items id="description">Anslått eller faktisk dato/tid da diagnosen eller problemet ble bekreftet av helsepersonell.</items>
                <items id="comment">Delvise datoer er tillatt. Dersom individet er under ett år gammel, må komplett dato eller som et minimum måned og år oppgis for å muliggjøre presise beregninger av alder, f.eks. ved bruk i beslutningsstøttesystemer. Data registrert eller importert som "alder ved tidspunkt når diagnosen stilles" bør konverteres til en dato ved hjelp av individets fødselsdato.</items>
            </items>
            <items code="at0005">
                <items id="text">Alvorlighetsgrad</items>
                <items id="description">En vurdering av problemet eller diagnosens overordnede alvorlighetsgrad.</items>
                <items id="comment">Dersom alvorlighetsgrad inkluderes i feltet "Problem/diagnosenavn" via prekoordinerte koder blir dette dataelementet overflødig. Merk: Mer spesifikk gradering av alvorlighetsgrad kan registreres ved å bruke SLOTet "Spesifikke detaljer"</items>
            </items>
            <items code="at0009">
                <items id="text">Klinisk beskrivelse</items>
                <items id="description">Fritekstbeskrivelse av problemet eller diagnosen.</items>
                <items id="comment">Brukes til å gi bakgrunn og kontekst, inkludert utvikling, episoder eller forverringer, fremgang og alle andre relevante detaljer, om problemet eller diagnosen.</items>
            </items>
            <items code="at0012">
                <items id="text">Anatomisk lokalisering</items>
                <items id="description">Registrering av et enkelt og usammensatt anatomisk sted der problemet eller diagnosen er lokalisert.</items>
                <items id="comment">Koding av navnet på den anatomiske lokaliseringen ved hjelp av en terminologi er foretrukket når dette er mulig. &#13;
Bruk dette dataelementet for å registrere prekoordinerte anatomiske lokaliseringer. Dersom behovene for å registrere anatomisk sted bestemmes i applikasjonen eller trenger større grad av kompleksitet som f.eks. relativ lokalisering, er det anbefalt å bruke CLUSTER.anatomical_location eller CLUSTER.relative_location innenfor SLOTet "Strukturert anatomisk lokalisering" i denne arketypen. Dette dataelementet kan ha ubegrenset antall forekomster, for å gjøre det mulig å registrere kliniske scenarier som f.eks. å beskrive et utslett som opptrer flere steder på kroppen, men der alle andre attributter er identiske. Dersom den anatomiske lokaliseringen inkluderes i feltet "Problem/diagnosenavn" via prekoordinerte koder blir dette dataelementet overflødig.</items>
            </items>
            <items code="at0030">
                <items id="text">Dato/tid for bedring/remisjon</items>
                <items id="description">Estimert eller faktisk dato/tid for bedring eller remisjon av det aktuelle problemet eller diagnosen, fastslått av helsepersonell.</items>
                <items id="comment">Delvise datoer er tillatt. Dersom individet er under ett år gammel, må komplett dato eller som et minimum måned og år oppgis for å muliggjøre presise beregninger av alder, f.eks. ved bruk i beslutningsstøttesystemer.&#13;
Data registrert eller importert som "alder ved bedring" bør konverteres til en dato ved hjelp av individets fødselsdato.</items>
            </items>
            <items code="at0032">
                <items id="text">Tree</items>
                <items id="description">@ internal @</items>
            </items>
            <items code="at0039">
                <items id="text">Strukturert anatomisk lokalisering</items>
                <items id="description">SLOT som kan inneholde en eller flere detaljerte og strukturerte anatomiske lokaliseringer.</items>
                <items id="comment">Dersom behovene for å registrere anatomisk sted bestemmes i applikasjonen eller trenger større grad av kompleksitet som f.eks. relativ lokalisering, er det anbefalt å bruke CLUSTER.anatomical_location eller CLUSTER.relative_location i dette SLOTet. &#13;
&#13;
Dersom den anatomiske lokaliseringen inkluderes i feltet "Problem/diagnosenavn" via prekoordinerte koder blir dette dataelementet overflødig.</items>
            </items>
            <items code="at0043">
                <items id="text">Spesifikke detaljer</items>
                <items id="description">Detaljer som er nødvendige for å registrere det aktuelle problemet eller diagnosens unike egenskaper.</items>
                <items id="comment">Kan omfatte strukturerte detaljer om klassifisering eller stadier av diagnosen; diagnosiske kriterier, klassifikasjon eller formelle vurderinger av alvorlighetsgrad, som f.eks. Common Terminology Criteria for Adverse Events.</items>
            </items>
            <items code="at0046">
                <items id="text">Status</items>
                <items id="description">Strukturerte detaljer for lokalisering-, fagområde-, episode- eller arbeidsflytsspesifikke aspekter av den diagnostiske prosessen.</items>
                <items id="comment">Bruk status eller kontekstkvalifikatorer med omhu, da bruken varierer og interoperabilitet kan ikke garanteres med mindre bruken er klart definert innen miljøet som bruker dem. F.eks. aktiv status - aktiv, inaktiv, løst, i bedring; utviklingsstatus - første, midlertidig, endelig; tidsstatus - nåværende, tidligere; episodisk status - første, ny, pågående; innleggelsesstatus - innleggelse, utskriving; eller prioritetsstatus - primær, sekundær.</items>
            </items>
            <items code="at0047">
                <items id="text">Mild</items>
                <items id="description">Problemet eller diagnosen forstyrrer ikke normal aktivitet.</items>
            </items>
            <items code="at0048">
                <items id="text">Moderat</items>
                <items id="description">Problemet eller diagnosen forstyrrer normal aktivitet.</items>
            </items>
            <items code="at0049">
                <items id="text">Alvorlig</items>
                <items id="description">Problemet eller diagnosen forhindrer normal aktivitet.</items>
            </items>
            <items code="at0069">
                <items id="text">Kommentar</items>
                <items id="description">Utdypende fritekst om problemet eller diagnosen, som ikke passer i andre felt.</items>
            </items>
            <items code="at0070">
                <items id="text">Sist oppdatert</items>
                <items id="description">Datoen da problemet eller diagnosen sist ble oppdatert.</items>
            </items>
            <items code="at0071">
                <items id="text">Tilleggsinformasjon</items>
                <items id="description">Ytterligere informasjon som trengs for å kunne registrere lokalt definert innhold eller for å tilpasse til andre referansemodeller/formalismer.</items>
                <items id="comment">For eksempel lokale informasjonsbehov, eller ytterligere metadata for å kunne tilpasse til tilsvarende konsepter i FHIR.</items>
            </items>
            <items code="at0072">
                <items id="text">Forløpsbeskrivelse</items>
                <items id="description">Fritekstbeskrivelse av forløpet av problemet eller diagnosen siden debut.</items>
            </items>
            <items code="at0073">
                <items id="text">Diagnostisk sikkerhet</items>
                <items id="description">Grad av sikkerhet i identifikasjonen av diagnosen.</items>
                <items id="comment">Hvis et alternativt verdisett er nødvendig, kan disse verdiene legges til DV_TEXT-datatypen i et templat.</items>
            </items>
            <items code="at0074">
                <items id="text">Mistenkt</items>
                <items id="description">Diagnoses er identifisert med en lav grad av sikkerhet.</items>
            </items>
            <items code="at0075">
                <items id="text">Sannsynlig</items>
                <items id="description">Diagnosen er identifisert med en stor grad av sikkerhet.</items>
            </items>
            <items code="at0076">
                <items id="text">Bekreftet</items>
                <items id="description">Diagnosen er bekreftet opp mot anerkjente kriterier.</items>
            </items>
            <items code="at0077">
                <items id="text">Dato/ tid for debut</items>
                <items id="description">Antatt eller faktisk dato/tid da tegn eller symptomer på problemet eller diagnosen først ble observert.</items>
                <items id="comment">Data registrert eller importert som "alder ved debut" bør konverteres til en dato ved hjelp av individets fødselsdato.</items>
            </items>
            <items code="at0078">
                <items id="text">Årsak</items>
                <items id="description">En årsak, kjede av årsaker til, eller hendelsesforløp forut for problemet eller diagnosen.</items>
                <items id="comment">Også kjent som 'etiologi'. Det anbefales å kode "Årsak" med en ekstern terminologi dersom det er mulig.</items>
            </items>
            <items code="at0079">
                <items id="text">Variant</items>
                <items id="description">Spesifikk variant eller subtype av diagnose, hvis det er relevant.</items>
                <items id="comment">For eksempel "akutt motorisk aksonal nevropati" som en variant av Guillain-Barre Syndrom. Koding av navnet på varianten med en terminologi er foretrukket hvis mulig.</items>
            </items>
            <items code="at0080">
                <items id="text">Innvirkning</items>
                <items id="description">Overordnet vurdering av innvirkningen et helseproblem har for individet.</items>
                <items id="comment">Den samme diagnosen, med samme alvorlighetsgrad, kan ha ulik innvirkning på ulike pasienter. Denne relevanskvalifikatoren innebærer å justere den totale påvirkningen av helseproblemet basert på pasientens individuelle medisinske og funksjonelle forutsetninger. For eksempel: To pasienter har samme diagnose – en førstegradsforbrenning. Den ene er frisk, den andre har diabetes. Innvirkningen for en diabetiker er høyere (større risiko for infeksjon, lengre tilhelingstid osv.). Dette elementet er ment å åpne for registrering av flere typer påvirkning, for eksempel innen klinisk behandling, funksjonsevne i hjemmet eller arbeidsliv.</items>
            </items>
        </term_definitions>
    </component_ontologies>
    <component_ontologies archetype_id="openEHR-EHR-OBSERVATION.story.v1">
        <term_definitions language="pt-br">
            <items code="at0000">
                <items id="text">Patient History</items>
                <items id="description">A história clínica subjetiva do sujeito do cuidado como registrada diretamente por ele, ou relatada a um médico pelo sujeito ou por um cuidador.</items>
            </items>
            <items code="at0001">
                <items id="text">Event Series</items>
                <items id="description">@ internal @</items>
            </items>
            <items code="at0002">
                <items id="text">Algum Evento</items>
                <items id="description">Padrão, ponto indeterminado no tempo ou intervalo do evento que pode ser explicitamente definido em um modelo ou em tempo de execução.</items>
            </items>
            <items code="at0003">
                <items id="text">Tree</items>
                <items id="description">@ internal @</items>
            </items>
            <items code="at0004">
                <items id="text">História</items>
                <items id="description">Descrição narrativa da história ou da história clínica para o sujeito do cuidado.</items>
            </items>
            <items code="at0006">
                <items id="text">Detalhes Estruturados</items>
                <items id="description">Detalhes estruturados sobre a história do indivíduo ou a história do paciente.</items>
                <items id="comment">Por exemplo: um sintoma específico, tais como náuseas ou dor; um evento como uma queda de bicicleta; ou um problema como o desejo de parar de usar tabaco.</items>
            </items>
            <items code="at0007">
                <items id="text">Tree</items>
                <items id="description">@ internal @</items>
            </items>
            <items code="at0008">
                <items id="text">Extensão</items>
                <items id="description">Informações adicionais necessárias para capturar o conteúdo local ou para se alinhar com outros modelos/formalismos de referência.</items>
                <items id="comment">*For example: Local information requirements or additional metadata to align with FHIR equivalents. (en)</items>
            </items>
        </term_definitions>
        <term_definitions language="sv">
            <items code="at0000">
                <items id="text">Sjukdomshistoria</items>
                <items id="description">Vårdtagarens subjektiva sjukdomshistoria som registrerats direkt av vårdgivaren, eller rapporterats till en kliniker av vårdtagaren eller vårdgivaren.</items>
            </items>
            <items code="at0001">
                <items id="text">Event Series</items>
                <items id="description">@ internal @</items>
            </items>
            <items code="at0002">
                <items id="text">Ospecificerad händelse</items>
                <items id="description">Ospecificerad standardhändelse vid en tidpunkt eller inom ett tidsintervall som explicit kan definieras i en mall eller genereras automatiskt av vissa IT-system.</items>
            </items>
            <items code="at0003">
                <items id="text">Tree</items>
                <items id="description">@ internal @</items>
            </items>
            <items code="at0004">
                <items id="text">Sjukdomshistoria</items>
                <items id="description">Berättande beskrivning av vårdtagarens sjukdomshistoria.</items>
            </items>
            <items code="at0006">
                <items id="text">Strukturerade detaljer</items>
                <items id="description">Strukturerade detaljer om individens eller vårdtagarens sjukdomshistoria.</items>
                <items id="comment">Till exempel: ett specifikt symptom som illamående eller smärta; en händelse som att falla av en cykel; eller ett problem som en önskan om att sluta använda tobak.</items>
            </items>
            <items code="at0007">
                <items id="text">Tree</items>
                <items id="description">@ internal @</items>
            </items>
            <items code="at0008">
                <items id="text">Tilläggsinformation</items>
                <items id="description">Plats för att infoga tilläggsinformation som krävs för lokala anpassningar eller anpassning till andra referensmodeller eller formella krav.</items>
                <items id="comment">*For example: Local information requirements or additional metadata to align with FHIR equivalents. (en)</items>
            </items>
        </term_definitions>
        <term_definitions language="de">
            <items code="at0000">
                <items id="text">Erzählung/Vorgeschichte</items>
                <items id="description">Die subjektive klinische Vorgeschichte der betreuten Person, wie sie direkt von der Person aufgezeichnet oder einem Kliniker von der Person oder einem Betreuer berichtet wird.</items>
            </items>
            <items code="at0001">
                <items id="text">Event Series</items>
                <items id="description">@ internal @</items>
            </items>
            <items code="at0002">
                <items id="text">Beliebiges Ereignis</items>
                <items id="description">Standardwert, ein undefinierter/s Zeitpunkt oder Intervallereignis, das explizit im Template oder zur Laufzeit der Anwendung definiert werden kann.</items>
            </items>
            <items code="at0003">
                <items id="text">Tree</items>
                <items id="description">@ internal @</items>
            </items>
            <items code="at0004">
                <items id="text">Geschichte</items>
                <items id="description">Beschreibung der Geschichte oder der klinischen Vorgeschichte für die betreute Person.</items>
            </items>
            <items code="at0006">
                <items id="text">Strukturierte Angabe</items>
                <items id="description">Strukturierte Angaben über die Vorgeschichte der Person oder des Patienten.</items>
                <items id="comment">Zum Beispiel: ein spezifisches Symptom wie Übelkeit oder Schmerzen; ein Ereignis wie ein Sturz vom Fahrrad; oder ein Anliegen wie der Wunsch, mit dem Tabakkonsum aufzuhören.</items>
            </items>
            <items code="at0007">
                <items id="text">Tree</items>
                <items id="description">@ internal @</items>
            </items>
            <items code="at0008">
                <items id="text">Erweiterung</items>
                <items id="description">Zusätzliche Informationen, die zur Erfassung lokaler Inhalte oder zur Anpassung an andere Referenzmodelle/Formalismen erforderlich sind.</items>
                <items id="comment">Zum Beispiel: Lokale Informationsanforderungen oder zusätzliche Metadaten, um Verknüpfungen mit FHIR Äquivalenten herzustellen.</items>
            </items>
        </term_definitions>
        <term_definitions language="nb">
            <items code="at0000">
                <items id="text">Patient History</items>
                <items id="description">Et individs sykehistorie/anamnese, som fortalt til kliniker eller dokumentert direkte av individet.</items>
            </items>
            <items code="at0001">
                <items id="text">Event Series</items>
                <items id="description">@ internal @</items>
            </items>
            <items code="at0002">
                <items id="text">Uspesifisert hendelse</items>
                <items id="description">Standard, uspesifisert tidspunkt eller tidsintervall som kan defineres mer eksplisitt i en templat eller i en applikasjon.</items>
            </items>
            <items code="at0003">
                <items id="text">Tree</items>
                <items id="description">@ internal @</items>
            </items>
            <items code="at0004">
                <items id="text">Anamnese</items>
                <items id="description">Narrativ beskrivelse av sykehistorie/anamnese for et individ.</items>
            </items>
            <items code="at0006">
                <items id="text">Strukturerte detaljer</items>
                <items id="description">Ytterligere detaljer i strukturert form, knyttet til individets sykehistorie/anamnese.</items>
                <items id="comment">Eksempel: et spesifikt symptom som kvalme eller smerte, en hendelse som en sykkelvelt, eller en problemstilling som et ønske om å slutte med tobakk.</items>
            </items>
            <items code="at0007">
                <items id="text">*Tree(en)</items>
                <items id="description">*@ internal @(en)</items>
            </items>
            <items code="at0008">
                <items id="text">Tilleggsinformasjon</items>
                <items id="description">Ytterligere informasjon som trengs for å kunne registrere lokalt definert innhold eller for å tilpasse til andre referansemodeller/formalismer.</items>
                <items id="comment">For eksempel lokale informasjonsbehov eller ytterligere metadata for å kunne tilpasse til tilsvarende konsepter i FHIR.</items>
            </items>
        </term_definitions>
    </component_ontologies>
    <component_ontologies archetype_id="openEHR-EHR-SECTION.adhoc.v1">
        <term_definitions language="pt-br">
            <items code="at0000">
                <items id="text">Vital signs</items>
                <items id="description">Um cabeçalho de sessão genérico que deve ser renomeado no template para adequar-se a um contexto clínico específico.</items>
            </items>
        </term_definitions>
        <term_definitions language="sv">
            <items code="at0000">
                <items id="text">Vital signs</items>
                <items id="description">En generisk avsnittsrubrik som döps om i en template för att passa in i en specifik klinisk kontext.</items>
            </items>
        </term_definitions>
        <term_definitions language="de">
            <items code="at0000">
                <items id="text">Ad hoc Überschrift</items>
                <items id="description">Eine generische Abschnittsüberschrift eines Templates, welche entsprechend dem spezifischen klinischen Kontext umbenannt werden sollte.</items>
            </items>
        </term_definitions>
        <term_definitions language="nb">
            <items code="at0000">
                <items id="text">Vital signs</items>
                <items id="description">En generisk seksjonsheading som bør gis nytt navn i en template for å passe i en gitt klinisk kontekst.</items>
            </items>
        </term_definitions>
    </component_ontologies>
    <component_ontologies archetype_id="openEHR-EHR-OBSERVATION.body_temperature.v2">
        <term_definitions language="pt-br">
            <items code="at0000">
                <items id="text">Temperatura Corporal</items>
                <items id="description">Registrar a temperatura aferida de uma pessoa - substituto para temperatura corporal central.</items>
            </items>
            <items code="at0001">
                <items id="text">Single</items>
                <items id="description">*</items>
            </items>
            <items code="at0002">
                <items id="text">History</items>
                <items id="description">@ internal @</items>
            </items>
            <items code="at0003">
                <items id="text">Qualquer evento</items>
                <items id="description">Padrão, ponto indeterminado no tempo ou evento intervalar que pode ser explicitamente definido em um template ou em tempo de execução.</items>
            </items>
            <items code="at0004">
                <items id="text">Temperatura</items>
                <items id="description">*The measured temperature. (en)</items>
            </items>
            <items code="at0020">
                <items id="text">Protocol</items>
                <items id="description">@ internal @</items>
            </items>
            <items code="at0021">
                <items id="text">Local de aferição</items>
                <items id="description">*Simple description about the site of measurement. (en)</items>
            </items>
            <items code="at0022">
                <items id="text">Boca</items>
                <items id="description">A temperatura é aferida no interior da boca.</items>
            </items>
            <items code="at0023">
                <items id="text">Canal auditivo</items>
                <items id="description">A temperatura é aferida no canal auditivo externo.</items>
            </items>
            <items code="at0024">
                <items id="text">Axilla</items>
                <items id="description">A temperatura é aferida na pele da axila com o braço posicionado ao lado do corpo.</items>
            </items>
            <items code="at0025">
                <items id="text">Reto</items>
                <items id="description">A temperatura é aferida no reto.</items>
            </items>
            <items code="at0026">
                <items id="text">Nasofaringe</items>
                <items id="description">A temperatura é aferida dentro da nasofaringe.</items>
            </items>
            <items code="at0027">
                <items id="text">Bexiga</items>
                <items id="description">A temperatura é aferida na bexiga.</items>
            </items>
            <items code="at0028">
                <items id="text">Intravascular</items>
                <items id="description">A temperatura é aferida no sistema vascular.</items>
            </items>
            <items code="at0029">
                <items id="text">Estado</items>
                <items id="description">Informações sobre o estado do paciente.</items>
            </items>
            <items code="at0030">
                <items id="text">Exposição do corpo</items>
                <items id="description">O grau de exposição do indivíduo no momento da medição.</items>
            </items>
            <items code="at0031">
                <items id="text">Despido</items>
                <items id="description">Sem roupas, camisola ou capa.</items>
            </items>
            <items code="at0032">
                <items id="text">Vestuário reduzido</items>
                <items id="description">A pessoa está vestida com quantidade de roupa ou lençóis menor do que a apropriada para as circunstâncias ambientais.</items>
            </items>
            <items code="at0033">
                <items id="text">Apropriadamente vestido</items>
                <items id="description">A pessoa está coberta por uma quantidade de roupa ou lençóis considerada apropriada para as circunstâncias ambientais.</items>
            </items>
            <items code="at0034">
                <items id="text">Excessivamente vestido</items>
                <items id="description">A pessoa está coberta por uma quantidade de roupas ou lençóis maior do que a apropriada para as circunstâncias ambientais.</items>
            </items>
            <items code="at0041">
                <items id="text">Descrição de estresse térmico</items>
                <items id="description">*Narrative description of the conditions applied to the subject that might influence their measured body temperature. (en)</items>
            </items>
            <items code="at0043">
                <items id="text">Pele</items>
                <items id="description">A temperatura é aferida a partir da pele exposta.</items>
            </items>
            <items code="at0051">
                <items id="text">Vagina</items>
                <items id="description">A temperatura é aferida no interior da vagina.</items>
            </items>
            <items code="at0054">
                <items id="text">Esôfago</items>
                <items id="description">A temperatura é aferida no esôfago.</items>
            </items>
            <items code="at0055">
                <items id="text">Região inguinal</items>
                <items id="description">A temperatura é medida no sulco inguinal da pele entre a perna e a parede abdominal.</items>
            </items>
            <items code="at0056">
                <items id="text">Condições ambientais</items>
                <items id="description">Detalhes sobre as condições ambientais no momento da aferição de temperatura.</items>
            </items>
            <items code="at0057">
                <items id="text">Esforço</items>
                <items id="description">Detalhes sobre esforço que a pessoa fez no momento da aferição da temperatura.</items>
            </items>
            <items code="at0059">
                <items id="text">Dispositivo</items>
                <items id="description">*Details about the device used to measure body temperature. (en)</items>
            </items>
            <items code="at0060">
                <items id="text">Têmpora</items>
                <items id="description">A temperatura é medida na têmpora, sobre a artéria temporal superficial.</items>
            </items>
            <items code="at0061">
                <items id="text">Testa</items>
                <items id="description">A temperatura é aferida na testa.</items>
            </items>
            <items code="at0062">
                <items id="text">Extensão</items>
                <items id="description">*Additional information required to extend the model with local content or to align with other reference models or formalisms. (en)</items>
                <items id="comment">*For example: local information requirements; or additional metadata to align with FHIR. (en)</items>
            </items>
            <items code="at0063">
                <items id="text">Comentário</items>
                <items id="description">Comentário adicional sobre a aferição de temperatura não capturado em outros campos.</items>
            </items>
            <items code="at0064">
                <items id="text">Localização estruturada de aferição</items>
                <items id="description">*Structured details about the location of measurement. (en)</items>
            </items>
            <items code="at0065">
                <items id="text">Dia do ciclo menstrual</items>
                <items id="description">*Current day of the menstrual cycle.(en)</items>
                <items id="comment">*The first day of menstruation is considered to be Day 1 of each menstrual cycle. (en)</items>
            </items>
            <items code="at0066">
                <items id="text">*DV_TEXT (en)</items>
                <items id="description">*Additional issues or factors that may impact on the measurement of body temperature, not captured in other fields. (en)</items>
            </items>
            <items code="Cel">
                <items id="text">°C</items>
                <items id="description">degrees Celsius</items>
            </items>
            <items code="[degF]">
                <items id="text">°F</items>
                <items id="description">degrees Fahrenheit</items>
            </items>
        </term_definitions>
        <term_definitions language="sv">
            <items code="at0000">
                <items id="text">Kroppstemperatur</items>
                <items id="description">En registrering av kroppstemperaturen hos en individ som ett indirekt mått på kroppens kärntemperatur.</items>
            </items>
            <items code="at0001">
                <items id="text">Tree</items>
                <items id="description">@ internal @</items>
            </items>
            <items code="at0002">
                <items id="text">History</items>
                <items id="description">@ internal @</items>
            </items>
            <items code="at0003">
                <items id="text">Ospecificerad händelse</items>
                <items id="description">Ospecificerad standardhändelse vid en tidpunkt eller inom ett tidsintervall som explicit kan definieras i en mall eller genereras automatiskt av vissa IT-system.</items>
            </items>
            <items code="at0004">
                <items id="text">Temperatur</items>
                <items id="description">Den uppmätta temperaturen.</items>
            </items>
            <items code="at0020">
                <items id="text">Protocol</items>
                <items id="description">@ internal @</items>
            </items>
            <items code="at0021">
                <items id="text">Mätställe</items>
                <items id="description">Kortfattad beskrivning av det anatomiska stället för mätningen.</items>
            </items>
            <items code="at0022">
                <items id="text">Mun</items>
                <items id="description">Temperaturmätning i munnen.</items>
            </items>
            <items code="at0023">
                <items id="text">Hörselgång</items>
                <items id="description">Temperaturmätning i yttre hörselgången.</items>
            </items>
            <items code="at0024">
                <items id="text">Axill</items>
                <items id="description">Temperaturmätning i armhålan, med armen placerad längs med sidan.</items>
            </items>
            <items code="at0025">
                <items id="text">Rektum</items>
                <items id="description">Temperaturmätning i ändtarmen.</items>
            </items>
            <items code="at0026">
                <items id="text">Nasofarynx</items>
                <items id="description">Temperaturmätning i bakre delen av näshålan.</items>
            </items>
            <items code="at0027">
                <items id="text">Urinblåsa</items>
                <items id="description">Temperaturmätning i urinblåsan.</items>
            </items>
            <items code="at0028">
                <items id="text">Intravaskulär</items>
                <items id="description">Temperaturmätning i kärlsystemet.</items>
            </items>
            <items code="at0029">
                <items id="text">Tillstånd</items>
                <items id="description">Information om patientens tillstånd.</items>
            </items>
            <items code="at0030">
                <items id="text">Kroppsexponering</items>
                <items id="description">Graden av exponering av individens kropp vid tidpunkten för mätningen.</items>
            </items>
            <items code="at0031">
                <items id="text">Naken</items>
                <items id="description">Inga kläder, sängkläder eller filtar.</items>
            </items>
            <items code="at0032">
                <items id="text">Minskad klädsel/sängkläder</items>
                <items id="description">Individen är täckt av mindre kläder eller sängkläder än vad som bedöms vara lämpligt med hänsyn till miljöförhållandena.</items>
            </items>
            <items code="at0033">
                <items id="text">Lämplig klädsel/sängkläder</items>
                <items id="description">Individen är täckt av den mängd kläder eller sängkläder som bedöms vara lämplig med hänsyn till miljöförhållanden.</items>
            </items>
            <items code="at0034">
                <items id="text">Ökad klädsel/sängkläder</items>
                <items id="description">Individen är täckt av mer kläder eller sängkläder än vad som bedöms vara lämpligt med hänsyn till miljöförhållanden.</items>
            </items>
            <items code="at0041">
                <items id="text">Beskrivning av termisk stress</items>
                <items id="description">Beskrivning av de möjliga faktorer som kan påverka individens uppmätta kroppstemperatur.</items>
            </items>
            <items code="at0043">
                <items id="text">Hud</items>
                <items id="description">Temperaturmätning på exponerad hud.</items>
            </items>
            <items code="at0051">
                <items id="text">Vagina</items>
                <items id="description">Temperaturmätning i vagina.</items>
            </items>
            <items code="at0054">
                <items id="text">Esofagus</items>
                <items id="description">Temperaturmätning i matstrupen.</items>
            </items>
            <items code="at0055">
                <items id="text">Ljumskveck</items>
                <items id="description">Temperaturmätning i ljumskens hudveck mellan benet och bukväggen.</items>
            </items>
            <items code="at0056">
                <items id="text">Miljöförhållanden</items>
                <items id="description">Detaljer om miljöförhållanden vid tidpunkten för temperaturmätningen.</items>
            </items>
            <items code="at0057">
                <items id="text">Ansträngningsgrad</items>
                <items id="description">Uppgifter om individens fysiska ansträngningsgrad vid tidpunkten för temperaturmätningen.</items>
            </items>
            <items code="at0059">
                <items id="text">Utrustning</items>
                <items id="description">Beskrivning av den utrustning som används för att mäta kroppstemperaturen.</items>
            </items>
            <items code="at0060">
                <items id="text">Tinning</items>
                <items id="description">Temperaturmätning vid tinningen, över den ytliga tinningartären.</items>
            </items>
            <items code="at0061">
                <items id="text">Panna</items>
                <items id="description">Temperaturmätning på pannan.</items>
            </items>
            <items code="at0062">
                <items id="text">Tilläggsinformation</items>
                <items id="description">Plats för tilläggsinformation som krävs för lokala anpassningar eller anpassning till andra referensmodeller eller formella krav.</items>
                <items id="comment">Exempelvis lokala informationskrav eller metadata för anpassning till FHIR-motsvarigheter.</items>
            </items>
            <items code="at0063">
                <items id="text">Kommentar</items>
                <items id="description">Kommentarer avseende mätningen av kroppstemperaturen som inte beskrivs i övriga datafält.</items>
            </items>
            <items code="at0064">
                <items id="text">Strukturerat mätställe</items>
                <items id="description">Strukturerad beskrivning av det anatomiska stället för mätningen.</items>
            </items>
            <items code="at0065">
                <items id="text">Dag i menstruationscykeln</items>
                <items id="description">Nuvarande dag i menstruationscykeln.</items>
                <items id="comment">Den första dagen av menstruationen anses vara dag 1 i menstruationscykeln.</items>
            </items>
            <items code="at0066">
                <items id="text">Möjliga felkällor</items>
                <items id="description">Beskrivning av faktorer och felkällor som kan påverka bedömningen av mätningen av kroppstemperaturen och som inte beskrivs i övriga datafält.</items>
            </items>
            <items code="Cel">
                <items id="text">°C</items>
                <items id="description">degrees Celsius</items>
            </items>
            <items code="[degF]">
                <items id="text">°F</items>
                <items id="description">degrees Fahrenheit</items>
            </items>
        </term_definitions>
        <term_definitions language="de">
            <items code="at0000">
                <items id="text">Körpertemperatur</items>
                <items id="description">Eine Messung der Körpertemperatur, als Surrogat für die Temperatur des gesamten Körper der Person.</items>
            </items>
            <items code="at0001">
                <items id="text">Single</items>
                <items id="description">*</items>
            </items>
            <items code="at0002">
                <items id="text">History</items>
                <items id="description">@ internal @</items>
            </items>
            <items code="at0003">
                <items id="text">Beliebiges Ereignis</items>
                <items id="description">Standardwert, ein undefinierter/s Zeitpunkt oder Intervallereignis, das explizit im Template oder zur Laufzeit der Anwendung definiert werden kann.</items>
            </items>
            <items code="at0004">
                <items id="text">Temperatur</items>
                <items id="description">Die gemessene Körpertemperatur.</items>
            </items>
            <items code="at0020">
                <items id="text">Protocol</items>
                <items id="description">@ internal @</items>
            </items>
            <items code="at0021">
                <items id="text">Lokalisation der Messung</items>
                <items id="description">Einfache Beschreibung der Stelle der Messung.</items>
            </items>
            <items code="at0022">
                <items id="text">Mund</items>
                <items id="description">Messung der Temperatur im Mund.</items>
            </items>
            <items code="at0023">
                <items id="text">Ohrkanal</items>
                <items id="description">Messung der Temperatur innerhalb des äußeren Gehörgangs.</items>
            </items>
            <items code="at0024">
                <items id="text">Achselhöhle</items>
                <items id="description">Messung der Temperatur an der Haut der Achselhöhle mit seitlich angelegtem Arm.</items>
            </items>
            <items code="at0025">
                <items id="text">Rektum</items>
                <items id="description">Messung der Temperatur innerhalb des Rektums.</items>
            </items>
            <items code="at0026">
                <items id="text">Nasopharynx</items>
                <items id="description">Messung der Temperatur innerhalb des Nasopharynxs (Nasenrachens).</items>
            </items>
            <items code="at0027">
                <items id="text">Harnblase</items>
                <items id="description">Messung der Temperatur in der Harnblase.</items>
            </items>
            <items code="at0028">
                <items id="text">Intravaskulär</items>
                <items id="description">Messung der Temperatur innerhalb des vaskulären Systems.</items>
            </items>
            <items code="at0029">
                <items id="text">Status</items>
                <items id="description">Statusinformationen über den Patienten.</items>
            </items>
            <items code="at0030">
                <items id="text">Körperexposition</items>
                <items id="description">Der Expositionsgrad der Person, deren Temperatur gemessen wird.</items>
            </items>
            <items code="at0031">
                <items id="text">Nackt</items>
                <items id="description">Keine Kleidung, Bettzeug oder andere Bedeckung.</items>
            </items>
            <items code="at0032">
                <items id="text">Reduzierte Kleidung/Bettzeug</items>
                <items id="description">Die Person wird bedeckt von einer geringeren Menge an Kleidung oder Bettzeug als für die Umgebungsbedingungen angemessen erscheint.</items>
            </items>
            <items code="at0033">
                <items id="text">Angemessene Kleidung/Bettzeug</items>
                <items id="description">Die Person wird bedeckt von einer Menge an Kleidung oder Bettzeug, die den Umgebungsbedingungen angemessen erscheint.</items>
            </items>
            <items code="at0034">
                <items id="text">Erhöhte Kleidung/Bettzeug</items>
                <items id="description">Die Person wird bedeckt von einer größeren Menge an Kleidung oder Bettzeug als für die Umgebungsbedingungen angemessen erscheint.</items>
            </items>
            <items code="at0041">
                <items id="text">Beschreibung der Wärmebelastung</items>
                <items id="description">Beschreibung von Bedingungen, denen die Person ausgesetzt ist, welche die gemessene Körpertemperatur beeinflussen könnten.</items>
            </items>
            <items code="at0043">
                <items id="text">Haut</items>
                <items id="description">Messung der Temperatur an freiliegender Haut.</items>
            </items>
            <items code="at0051">
                <items id="text">Vagina</items>
                <items id="description">Messung der Temperatur innerhalb der Vagina.</items>
            </items>
            <items code="at0054">
                <items id="text">Oesophagus</items>
                <items id="description">Messung der Temperatur innerhalb des Oesophagus.</items>
            </items>
            <items code="at0055">
                <items id="text">Inguinale Hautfalte</items>
                <items id="description">Messung der Temperatur in der inguinalen Hautfalte zwischen Bein und Abdominalwand.</items>
            </items>
            <items code="at0056">
                <items id="text">Umgebungsbedingungen</items>
                <items id="description">Details über die Umgebungsbedingungen zum Zeitpunkt der Temperaturmessung</items>
            </items>
            <items code="at0057">
                <items id="text">Betätigung</items>
                <items id="description">Details über die Betätigung der Person zum Zeitpunkt der Messung der Temperatur.</items>
            </items>
            <items code="at0059">
                <items id="text">Gerät</items>
                <items id="description">Details über das Gerät, das zur Temperaturmessung benutzt wurde.</items>
            </items>
            <items code="at0060">
                <items id="text">Schläfe</items>
                <items id="description">Messung der Temperatur an der Schläfe, über der oberflächlichen Schläfenarterie.</items>
            </items>
            <items code="at0061">
                <items id="text">Stirn</items>
                <items id="description">Messung der Temperatur auf der Stirn.</items>
            </items>
            <items code="at0062">
                <items id="text">Erweiterung</items>
                <items id="description">Zusätzliche Informationen zur Erfassung lokaler Inhalte oder Anpassung an andere Referenzmodelle/Formalismen.</items>
                <items id="comment">Zum Beispiel: Lokaler Informationsbedarf oder zusätzliche Metadaten zur Anpassung an FHIR-Ressourcen.</items>
            </items>
            <items code="at0063">
                <items id="text">Kommentar</items>
                <items id="description">Zusätzliche Informationen über die Körpertemperatur, die nicht in anderen Bereichen dargestellt wurden.</items>
            </items>
            <items code="at0064">
                <items id="text">Strukturierte Lokalisation der Messung</items>
                <items id="description">Strukturierte anatomische Lokalisation, an dem die Messung vorgenommen wurde.</items>
            </items>
            <items code="at0065">
                <items id="text">Tag des Menstruationszyklus</items>
                <items id="description">Aktueller Tag des Menstruationszyklus.</items>
                <items id="comment">Der erste Tag der Menstruation gilt als Tag 1 jedes Menstruationszyklus.</items>
            </items>
            <items code="at0066">
                <items id="text">Störfaktoren</items>
                <items id="description">Zusätzliche Probleme oder Faktoren, die sich auf die Messung der Körpertemperatur auswirken können und in anderen Bereichen nicht dargestellt werden.</items>
            </items>
            <items code="Cel">
                <items id="text">°C</items>
                <items id="description">degrees Celsius</items>
            </items>
            <items code="[degF]">
                <items id="text">°F</items>
                <items id="description">degrees Fahrenheit</items>
            </items>
        </term_definitions>
        <term_definitions language="nb">
            <items code="at0000">
                <items id="text">Kroppstemperatur</items>
                <items id="description">Måling av kroppstemperatur som skal gjenspeile et individs kjernetemperatur.</items>
            </items>
            <items code="at0001">
                <items id="text">*Single(en)</items>
                <items id="description">**(en)</items>
            </items>
            <items code="at0002">
                <items id="text">*History(en)</items>
                <items id="description">*@ internal @(en)</items>
            </items>
            <items code="at0003">
                <items id="text">Uspesifisert hendelse</items>
                <items id="description">Standard, uspesifisert tidspunkt eller tidsintervall som kan defineres mer eksplisitt i en template eller i en applikasjon.</items>
            </items>
            <items code="at0004">
                <items id="text">Temperatur</items>
                <items id="description">Den målte temperaturen.</items>
            </items>
            <items code="at0020">
                <items id="text">*Protocol(en)</items>
                <items id="description">*@ internal @(en)</items>
            </items>
            <items code="at0021">
                <items id="text">Målested</items>
                <items id="description">Enkel beskrivelse av målestedet.</items>
            </items>
            <items code="at0022">
                <items id="text">Munn</items>
                <items id="description">Temperatur målt i munnhulen (under tungen).</items>
            </items>
            <items code="at0023">
                <items id="text">Øre</items>
                <items id="description">Temperatur måles fra den ytre øregangen.</items>
            </items>
            <items code="at0024">
                <items id="text">Armhule</items>
                <items id="description">Temperatur er målt i armhulen med armen posisjonert ned langs siden.</items>
            </items>
            <items code="at0025">
                <items id="text">Endetarm</items>
                <items id="description">Temperatur målt i endetarm (rektum).</items>
            </items>
            <items code="at0026">
                <items id="text">Nesesvelg</items>
                <items id="description">Temperatur målt i nesesvelget (nasofarynks).</items>
            </items>
            <items code="at0027">
                <items id="text">Urinblære</items>
                <items id="description">Temperatur målt i urinblære.</items>
            </items>
            <items code="at0028">
                <items id="text">Intravaskulært</items>
                <items id="description">Temperatur målt intravaskulært.</items>
            </items>
            <items code="at0029">
                <items id="text">Tilstanden</items>
                <items id="description">Informasjon om tilstanden til en pasient.</items>
            </items>
            <items code="at0030">
                <items id="text">Kroppseksponering</items>
                <items id="description">Grad av tildekking av individet da temperaturen ble målt.</items>
            </items>
            <items code="at0031">
                <items id="text">Naken</items>
                <items id="description">Ingen klær eller tildekking</items>
            </items>
            <items code="at0032">
                <items id="text">Redusert påkledning/tildekking</items>
                <items id="description">Individet er mindre påkledt eller tildekket enn temperaturen i omgivelsene skulle tilsi.</items>
            </items>
            <items code="at0033">
                <items id="text">Passende påkleding/tildekking</items>
                <items id="description">Individet er passende påkledt eller tildekket i forhold til hva temperaturen i omgivelsene skulle tilsi.</items>
            </items>
            <items code="at0034">
                <items id="text">Økt påkledning/tildekking</items>
                <items id="description">Individet er mer påkledt eller tildekket enn temperaturen i omgivelsene skulle tilsi.</items>
            </items>
            <items code="at0041">
                <items id="text">Beskrivelse termisk belastning</items>
                <items id="description">Narrativ beskrivelse av forholdene som kan påvirker den målte kroppstemperaturen til individet.)</items>
            </items>
            <items code="at0043">
                <items id="text">Hud</items>
                <items id="description">Temperaturen målt på eksponert hud.</items>
            </items>
            <items code="at0051">
                <items id="text">Skjede</items>
                <items id="description">Temperatur målt i skjeden (vagina).</items>
            </items>
            <items code="at0054">
                <items id="text">Spiserør</items>
                <items id="description">Temperatur målt i spiserøret (øsofagus).</items>
            </items>
            <items code="at0055">
                <items id="text">Lyske</items>
                <items id="description">Temperatur målt i lysken.</items>
            </items>
            <items code="at0056">
                <items id="text">Miljøpåvirkninger</items>
                <items id="description">Detaljer om miljøforholdene på tidspunktet for temperaturmåling.</items>
            </items>
            <items code="at0057">
                <items id="text">Fysisk anstrengelse</items>
                <items id="description">Detaljer om anstrengelse/aktivitet hos individet da temperaturen ble målt.</items>
            </items>
            <items code="at0059">
                <items id="text">Måleinstrument</items>
                <items id="description">Detaljer om måleinstrument som ble brukt til å måle temperaturen</items>
            </items>
            <items code="at0060">
                <items id="text">Tinning</items>
                <items id="description">Temperatur målt i tinningen over arteria temporalis.</items>
            </items>
            <items code="at0061">
                <items id="text">Panne</items>
                <items id="description">Temperatur målt på pannen.</items>
            </items>
            <items code="at0062">
                <items id="text">Tilleggsinformasjon</items>
                <items id="description">Ytterligere informasjon som trengs for å kunne registrere lokalt definert innhold eller for å tilpasse til andre referansemodeller/formalismer.</items>
                <items id="comment">For eksempel lokale informasjonsbehov eller ytterligere metadata for å kunne tilpasse til tilsvarende konsepter i FHIR.</items>
            </items>
            <items code="at0063">
                <items id="text">Kommentar</items>
                <items id="description">Ytterligere beskrivelse av målingen av kroppstemperatur som ikke dekkes i andre felt.</items>
            </items>
            <items code="at0064">
                <items id="text">Strukturert målested</items>
                <items id="description">Strukturerte detaljer om målestedet.</items>
            </items>
            <items code="at0065">
                <items id="text">Menstruasjonssyklusdag</items>
                <items id="description">Nåværende dag i menstruasjonssyklusen.</items>
                <items id="comment">Den første dagen av menstruasjonen anses å være dag 1 i hver menstruasjonssyklus.</items>
            </items>
            <items code="at0066">
                <items id="text">Konfunderende faktorer</items>
                <items id="description">Ytterligere problemstillinger eller faktorer som kan påvirke målingen av kroppstemperaturen og som ikke er dekket i andre felt.</items>
            </items>
            <items code="Cel">
                <items id="text">°C</items>
                <items id="description">degrees Celsius</items>
            </items>
            <items code="[degF]">
                <items id="text">°F</items>
                <items id="description">degrees Fahrenheit</items>
            </items>
        </term_definitions>
    </component_ontologies>
    <component_ontologies archetype_id="openEHR-EHR-INSTRUCTION.medication_order.v3">
        <term_definitions language="pt-br">
            <items code="at0000">
                <items id="text">Prescrição de Medicamentos</items>
                <items id="description">Prescrição de medicamentos, vacina, produtos nutricionais ou outro item de tratamento para um indivíduo identificado.</items>
            </items>
            <items code="at0001">
                <items id="text">Prescrição</items>
                <items id="description">Detalhes da prescrição solicitada.</items>
            </items>
            <items code="at0002">
                <items id="text">Tree</items>
                <items id="description">@ internal @</items>
            </items>
            <items code="at0004">
                <items id="text">Outros identificadores</items>
                <items id="description">Identificador unívoco do ítem prescrito.</items>
                <items id="comment">Este elemento possui múltiplas ocorrências e deve ser explicitado em tempo de execução, se assim for exigido.</items>
            </items>
            <items code="at0005">
                <items id="text">Tree</items>
                <items id="description">@ internal @</items>
            </items>
            <items code="at0008">
                <items id="text">Extensão</items>
                <items id="description">Informações adicionais necessárias para capturar o conteúdo local ou para se alinhar com outros modelos de referência / formalismos.</items>
                <items id="comment">Por exemplo: requisitos de informações locais ou metadados adicionais para alinhar com os equivalentes FHIR ou CIMI.</items>
            </items>
            <items code="at0009">
                <items id="text">Instruções Gerais da Prescrição</items>
                <items id="description">Narrativa completa da descrição de como o item deve ser utilizado.</items>
                <items id="comment">Esta narrativa deve normalmente incluir os dados capturados em "quantidade de dose", "Duração da dose" e quaisquer instruções adicionais de uso. Ainda que o detalhamento da dose esteja totalmente representado de forma estruturada e computável, esse elemento deve também representar o equivalente narrativo, geralmente gerado automaticamente. Se não for possível representar o detalhamento da dose do medicamento na forma computável, não se recomenda a representação parcial destes itens, Neste caso, deve ser registradas somente em forma narrativa usando este elemento de dados.&#13;
</items>
            </items>
            <items code="at0011">
                <items id="text">Critério para o início da prescrição</items>
                <items id="description">Uma condição que, quando encontrada, exige o início da administração ou uso.</items>
                <items id="comment">Por exemplo: "Iniciar se o sintoma reaparecerem". Isso se destina a uma pré-condição geral que deve desencadear o uso da medicamento, e não para as administrações "se necessário" de uma prescrição em andamento.</items>
            </items>
            <items code="at0012">
                <items id="text">Data/Hora do início prescrição</items>
                <items id="description">A data e hora opcional para iniciar o uso do medicamento prescrito.</items>
            </items>
            <items code="at0013">
                <items id="text">Data/hora do final da prescrição</items>
                <items id="description">A data e hora opcional quando está planejado finalizar a utilização do ítem prescrito</items>
            </items>
            <items code="at0016">
                <items id="text">Critérios para interromper a prescrição</items>
                <items id="description">Uma condição que se existente, exige a interrupção da administração ou uso.</items>
                <items id="comment">Por exemplo: "Interromper após o desaparecimento dos sintomas".</items>
            </items>
            <items code="at0018">
                <items id="text">Indicação Clínica</items>
                <items id="description">A indicação clínica para o uso do item prescrito.</items>
                <items id="comment">Por exemplo: "Angina". Sempre que possível, a codificação da indicação clínica com uma terminologia deve existir. Este elemento de dados permite múltiplas ocorrências. Não se destina a fornecer uma indicação para fins de autorização administrativa.</items>
            </items>
            <items code="at0044">
                <items id="text">Instruções adicionais</items>
                <items id="description">Instruções adicionais sobre como usar ou armazenar o ítem prescrito.</items>
                <items id="comment">Por exemplo: alertas sobre "tomar com alimentos", "evitar frutas", "dissolver em água","guardar em geladeira, lugar seco". Este elemento de dados permite múltiplas ocorrências e deve ser codificado com uma terminologia de referência, sempre que possível.</items>
            </items>
            <items code="at0047">
                <items id="text">Orientação para parsear texto</items>
                <items id="description">Uma representação em texto parseável das orientações.</items>
                <items id="comment">Normalmente isto é utilizado somente quando passando informações entre sistemas legados.</items>
            </items>
            <items code="at0050">
                <items id="text">Duração do uso do ítem da prescrição</items>
                <items id="description">O período de tempo em que o indíviduo/paciente vem fazendo uso do item prescrito com parte da duração total do tratamento, antes da execução da prescrição atual.</items>
                <items id="comment">Por exemplo: para registrar que o paciente está fazendo uso de antibióticos por 3 dias, num total de 7 dias previstos para o tratamento, antes da internação hospitalar.</items>
            </items>
            <items code="at0051">
                <items id="text">Dose máxima</items>
                <items id="description">Detalhes sobre a dose máxima cumulativa permitida durante um período definido para o item prescrito.</items>
                <items id="comment">Por exemplo: "até 1 grama por dia". Este cluster permite múltiplas ocorrências para permitir a representação de múltiplas doses máximas que se aplicam a diferentes períodos de tempo. A dose máxima ao longo da vida não deve ser aplicada aqui, pois se refere a múltiplas prescrições ao longo do tempo.</items>
            </items>
            <items code="at0053">
                <items id="text">Periodo de tempo permitido</items>
                <items id="description">O período do tempo durante o qual a dose máxima é calculada.</items>
                <items id="comment">Exemplo: 24 horas.</items>
            </items>
            <items code="at0060">
                <items id="text">Administrações finalizadas</items>
                <items id="description">O número de administrações realizadas do item prescrito, como parte da prescrição total, antes da execução da prescrição atual.</items>
                <items id="comment">Por exemplo: para registrar que o paciente tomou os dois primeiros comprimidos de antibiótico de três dias de tratamento, antes da alta hospitalar para a casa de repouso.</items>
            </items>
            <items code="at0062">
                <items id="text">Segurança de medicamentos</items>
                <items id="description">Detalhes sobre a segurança de medicamentos prescritos.</items>
            </items>
            <items code="at0064">
                <items id="text">Cancelamento excepcional do alerta?</items>
                <items id="description">Confirmação pelo prescritor de que a dose normal ou outro limite de segurança foi ultrapassado, por circunstâncias excepcionais.</items>
            </items>
            <items code="at0065">
                <items id="text">Quantidade a ser dispensada</items>
                <items id="description">Detalhes sobre a quantidade do item prescrito a ser dispensada.</items>
                <items id="comment">Este SLOT possibilita ajustes locais para acomodar as legislações vigentes sobre como as quantidades do ítem prescrito devem ser dispensadas.</items>
            </items>
            <items code="at0069">
                <items id="text">Informações da autorização</items>
                <items id="description">Detalhes da autorização do ítem prescrito, incluindo o local de administração e políticas de reembolso.</items>
                <items id="comment">Por exemplo: detalhes sobre a renovação da prescrição. Este SLOT possibilita o gerenciamento das diferenças regionais a respeito das autorizações. No caso Brasileiro, não existe "refill"de prescrições.</items>
            </items>
            <items code="at0070">
                <items id="text">Item da prescrição de medicamentos</items>
                <items id="description">Nome do medicamento, vacina ou outro item terapêutico/prescritível a ser solicitado.</items>
                <items id="comment">Dependendo do contexto da prescrição, esse campo pode ser utilizado para uma prescrição de medicamentos genériicos ou comerciais. Este campo de dados pode ser utilizado para registrar prescrições relacionadas de vários medicamentos diferentes quando estão são prescritos como um único pacote. É altamente recomendável que o "item de medicação" seja codificado com uma terminologia capaz de desencadear o suporte à decisão, sempre que possível. A extensão da codificação pode variar do nome simples do item de medicação até os detalhes estruturados sobre o a embalagem da medicação a ser utilizada. A entrada de texto livre só deve ser utilizada se não houver uma terminologia apropriada disponível.</items>
            </items>
            <items code="at0091">
                <items id="text">Via de Administração</items>
                <items id="description">A via de administração pela qual o item prescrito deve ser administrada à pessoa.</items>
                <items id="comment">Por exemplo: 'oral', 'intravenosa', ou 'cutâena.'&#13;
É desejável que avia de administração seja condificada com uma terminologia, sempre que possível. Várias vias de administração potenciais poderão ser especificadas.</items>
            </items>
            <items code="at0092">
                <items id="text">Local do corpo</items>
                <items id="description">Nome do local de administração do item prescrito.</items>
                <items id="comment">Por exemplo: "braço esquerdo", "catéter intravenoso da mão direita˜.&#13;
Sempre que possível, é desejável que o local do corpo seja codificado com uma terminologia.</items>
            </items>
            <items code="at0093">
                <items id="text">Local do corpo estruturado</items>
                <items id="description">Descrição estruturada do local da administração do item prescrito.</items>
            </items>
            <items code="at0094">
                <items id="text">*Administration method(en)</items>
                <items id="description">*The technique or device by which the ordered item is to be administered.(en)</items>
                <items id="comment">*For example: ' via Z-track injection'; 'via nebuliser'. Coding of the method with a terminology is preferred, where possible.(en)</items>
            </items>
            <items code="at0095">
                <items id="text">*Administration device(en)</items>
                <items id="description">*Details of the medical device used to assist administration of the ordered item.(en)</items>
            </items>
            <items code="at0105">
                <items id="text">Informações do paciente</items>
                <items id="description">Informações adicionais direcionadas principalmente para o indivíduo/paciente ou cuidador.</items>
                <items id="comment">Por exemplo: "Para reduzir sua pressão sanguínea". Este elemento de dados permite múltiplas ocorrências e deve ser codificado com uma terminologia de referência, sempre que possível. Se necessário, é possível usar um atributo LINK para associar esse elemento, por exemplo, ao "diagnóstico original" separado de uma lista de problemas, mas a indicação deve ser explicitamente registrada aqui, pois o objetivo do link pode mudar ao longo do tempo.</items>
            </items>
            <items code="at0106">
                <items id="text">Instruções para a dispensação</items>
                <items id="description">Instruções adicionais direcionadas primariamente para a pessoa responsável pela dispensação do ítem prescrito.</items>
                <items id="comment">Exemplo: Instruções detalhadas da dispensão de opiáceos em etapas.</items>
            </items>
            <items code="at0107">
                <items id="text">Monitoramento da instrução</items>
                <items id="description">Instruções adicionais que advertem sobre o monitoramento dos itens prescritos.</items>
                <items id="comment">Por exemplo: "Por favor, verificar função renal em 2 semanas". Este elemento de dados permite múltiplas ocorrências.</items>
            </items>
            <items code="at0112">
                <items id="text">Sumário da prescrição</items>
                <items id="description">Informações sumarizadas sobre o uso do item prescrito, tais como: status atual, datas chave, geralmente utilizado fora do contexto da prescrição.</items>
                <items id="comment">Pode ser necessário gerar um sumário da prescrição quando for necessário trocar informações sobre os medicamentos em uso no padrão FHIR. Por exemplo, como parte do processo de encaminhamento, um sumário do atendimento da emergência ou nota de alta.</items>
            </items>
            <items code="at0113">
                <items id="text">Prescrição detalhada</items>
                <items id="description">Detalhes sobre a prescrição como um todo.</items>
            </items>
            <items code="at0129">
                <items id="text">Orientações para a dispensação</items>
                <items id="description">Orientações sobre a dispensação do ítem prescrito.</items>
            </items>
            <items code="at0130">
                <items id="text">Quantidade máxima</items>
                <items id="description">*The maximum, cumulative amount of medication which should be administered within the allowed period. (en)</items>
                <items id="comment">*For example: 1 ml, 1.5 mg, 0.125 g. (en)</items>
            </items>
            <items code="at0132">
                <items id="text">Orientações para substituição</items>
                <items id="description">Permissão para substituir item prescrito por outro bioequivalente.</items>
                <items id="comment">Em várias alçadas, é permitida a substituição de um ítem prescrito por outro como genérico ou comercial, classificados como bioequivalentes no momento da dispensação ou compra. Em outras situações, a substituição é sempre considerada e o prescritor deve explicitar que NÃO aceita substituições.</items>
            </items>
            <items code="at0139">
                <items id="text">Prioridade</items>
                <items id="description">Indicador da urgência de dispensação do ítem prescrito.</items>
                <items id="comment">Por exemplo: 'urgente'. Estes domínios devem ser informados quer no template, quer como especializações do arquétipo para acomodar as necessidades locais. Por exemplo, 'urgente' pode estar acordado que indida que esta medicação deve ser dispensada o mais rápido possível.</items>
            </items>
            <items code="at0143">
                <items id="text">*Medication details (en)</items>
                <items id="description">*Structured details about the overall medication including strength, form and constituent substances. (en)</items>
                <items id="comment">Use este SLOT quando os detalhes do item prescrito precisam ser explicitamente declarado. Por exemplo: a forma, a concentração, algum diluente ou mistura de ingredientes.</items>
            </items>
            <items code="at0148">
                <items id="text">Intenção terapêutica</items>
                <items id="description">A intenção terapêutica sobre o item prescrito.</items>
                <items id="comment">Por exemplo: "Alívio da dor", "cuidado paliativo"; "baixa-dose profilática", "rehidratação", "infusão nutricional".</items>
            </items>
            <items code="at0150">
                <items id="text">Dose efetiva total diária</items>
                <items id="description">Detalhes sobre a quantidade total diária do item prescrito a ser administrado.</items>
                <items id="comment">A doses total diária registra a dose efetiva esperada e, portanto, suporta a titulação a partir de uma dose baixa inicial até a dose eficaz, ao longo de um período de tempo. não se trata da dose alvo ou objetivo, mas sim da dose diária efetiva real em relação a este objetivo. Em algumas circunstâncias, a dose diária total será calculada a partir de instruções computáveis, em outras, talvez seja necessário inserir a informação manualmente.</items>
            </items>
            <items code="at0151">
                <items id="text">Quantidade diária total</items>
                <items id="description">A quantidade do item prescrito que será ingerida diariamente se administrada conforme pretendido.</items>
                <items id="comment">*For example '20 mg'. (en)</items>
            </items>
            <items code="at0154">
                <items id="text">Justificativa para a não substituição</items>
                <items id="description">Motivo pelo qual o ítem prescrito não deve ser substituído no momento da dispensação.</items>
                <items id="comment">Por exemplo: preparação do genérico não bioequivalente.</items>
            </items>
            <items code="at0155">
                <items id="text">Data do início da dispensação</items>
                <items id="description">Data inicial permitida para a primeira dispensação do ítem prescrito.</items>
                <items id="comment">Pode ser utilizado para controlar o período de dispensação de medicamentos que potencialmente podem levar a uso inadequado.</items>
            </items>
            <items code="at0161">
                <items id="text">Data de validade da dispensação</items>
                <items id="description">Data a partir da qual a dispensação não é mais válida.</items>
                <items id="comment">Em algumas alçadas as prescrições podem incorporar uma data de validade, informando que a partir desta data o ítem não pode ser dispensado. No Brasil ver regras locais da ANVISA para medicamentos controlados, por exemplo.</items>
            </items>
            <items code="at0162">
                <items id="text">Justificativa do cancelamento do alerta</items>
                <items id="description">O motivo pelo qual um item de segurança clínica ou de uma dose máxima não foi cumprido.</items>
                <items id="comment">Por exemplo: "Não responsivo a dose máxima recomendada. Situação crítica", "Penicilina é o único tratamento válido, probabilidade de alergia a penicilina é baixa".</items>
            </items>
            <items code="at0165">
                <items id="text">Propósito</items>
                <items id="description">Descrição do motivo para registrar a dose efetiva diária total.</items>
                <items id="comment">Por exemplo: "Controle da Hipertensão", "dose alvo diária 20 mg". A descrição poderia ser utilizada para identificar o nome, frase ou parágrafo sobre o propósito de registrar a dose efetiva diária total, geralmente para permitir a titulação em direção a uma dose alvo específica. O objetivo ou a dose alvo podem ser registradas aqui ou mais frequentemente podem ser parte do arquétipo 'goal' EVALUATION.</items>
            </items>
            <items code="at0166">
                <items id="text">Detalhes adicionais</items>
                <items id="description">Detalhes adicionais estruturados sobre o ítem prescrito, não capturados em outros campos.</items>
            </items>
            <items code="at0167">
                <items id="text">Comentários</items>
                <items id="description">Comentários adicionais sobre o ítem prescrito em texto livre, não capturados em outros campos.</items>
            </items>
            <items code="at0168">
                <items id="text">Perimitido</items>
                <items id="description">Permitir a subsituição do medicamento por medicamento bioequivalente.</items>
            </items>
            <items code="at0169">
                <items id="text">Não permitidio</items>
                <items id="description">Não é permitido subsituir medicamento por medicamento bioequivalente.</items>
            </items>
            <items code="at0170">
                <items id="text">Detalhes da dispensação</items>
                <items id="description">Detalhes adicionais das instruções de dispensação.</items>
                <items id="comment">Este SLOT possibilita que as variações locais sejam incorporadas no que diz respeito a legislação de dispensação de medicamentos.</items>
            </items>
            <items code="at0171">
                <items id="text">Aviso de segurança cancelado</items>
                <items id="description">Uma questão de segurança conhecida ou reconhecida de uma pessoa ecom relação ao item prescrito, tais como, alergia, aviso de duplicidade de drogas ou contra-indicação. Este elemento normalmente é registrado apenas quando este aviso de segurança é cancelado.</items>
                <items id="comment">Por exemplo: "Alergia a penicilina", "Atenolol duplicado".</items>
            </items>
            <items code="at0173">
                <items id="text">Orientações específicas</items>
                <items id="description">Descrição em texto de uma parte das orientações globais.</items>
                <items id="comment">Em algumas situações é comum separar as orientações em segmentos de narrativas mais específicas. Por exemplo: é comum num hospital separar as orientações em 'quantidade da dose' e 'duração da dose', ambas como texto. Estes termos podem se aplicados no template ou durante a excecução do sistema.</items>
            </items>
            <items code="at0174">
                <items id="text">Justificativa da dosagem</items>
                <items id="description">A descrição da justificativa utilizada para calcular a dose total ou taxa da administração quando esta é dependente de algum outro fator.</items>
                <items id="comment">Por exemplo: "Ajustado por causa da amputação".</items>
            </items>
            <items code="at0177">
                <items id="text">Orientações estuturadas de dose e duração</items>
                <items id="description">Detalhes das orientações estuturadas de dose e duração.</items>
                <items id="comment">*This SLOT has been designed to be used with the CLUSTER.therapeutic_direction archetype to enable recording of a complex set of dosage and timing directions. While it's possible to use other CLUSTER archetypes within this SLOT, it's strongly advised to do so only when predictable queryability is not a priority. (en)</items>
            </items>
            <items code="at0178">
                <items id="text">*Safety override(en)</items>
                <items id="description">*Overriding of a known or recognised safety issue which applies to this subject and the ordered item, such as an allergy, drug duplication warning or contraindication.(en)</items>
            </items>
            <items code="at0179">
                <items id="text">*Clinician guidance (en)</items>
                <items id="description">*Advice to future prescribers/dispensers about the ongoing, long term order. (en)</items>
                <items id="comment">*For example: 'don't allow brand substitution' or advice regarding using a specific brand to avoid fillers that cause reactions. (en)</items>
            </items>
        </term_definitions>
        <term_definitions language="sv">
            <items code="at0000">
                <items id="text">Läkemedelsbeställning</items>
                <items id="description">En beställning av ett läkemedel, vaccin, näringspreparat eller annat terapeutiskt produkt för en identifierad individ.</items>
            </items>
            <items code="at0001">
                <items id="text">Order</items>
                <items id="description">Information om den begärda ordern.</items>
            </items>
            <items code="at0002">
                <items id="text">Tree</items>
                <items id="description">@ internal @</items>
            </items>
            <items code="at0004">
                <items id="text">Beställnings-ID</items>
                <items id="description">Unik identifikator för läkemedelsbeställningen.</items>
                <items id="comment">Detta dataelement möjliggör exakt identifiering av flera ordrar samtidigt.</items>
            </items>
            <items code="at0005">
                <items id="text">Tree</items>
                <items id="description">@ internal @</items>
            </items>
            <items code="at0008">
                <items id="text">Tilläggsinformation</items>
                <items id="description">Plats för att infoga tilläggsinformation som krävs för lokala anpassningar eller anpassning till andra referensmodeller eller formella krav.</items>
                <items id="comment">Exempelvis lokala informationskrav eller metadata för anpassning till FHIR- eller CIMI-motsvarigheter.</items>
            </items>
            <items code="at0009">
                <items id="text">Fullständig beskrivning av anvisningar</items>
                <items id="description">Komplett beskrivning om hur den beställda artikeln ska användas.</items>
                <items id="comment">Beskrivningen ska normalt sammanfoga data som registrerats i "Dosmängd", "Tidpunkt för dos" och eventuella ytterligare bruksanvisningar. Where the medication dose directions are fully carried by the structured, computable dose directions, this element should carry the narrative equivalent, generally auto-generated. If it is not possible to represent the intended 'Dose direction' fully in computable form, partial representation is not recommended, and the directions should be only recorded in narrative form using this data element.</items>
            </items>
            <items code="at0011">
                <items id="text">Startkriterium för order</items>
                <items id="description">Det villkor som måste vara uppfyllt innan administrering eller användning påbörjas.</items>
                <items id="comment">Till exempel: "Påbörja om symptomen återkommer". Detta är ett generellt förhandsvillkor som bör leda till att hela läkemedelsbehandlingen startar, och inte för "vid behov"-administreringar av en pågående order.</items>
            </items>
            <items code="at0012">
                <items id="text">Datum/tid för påbörjad order</items>
                <items id="description">Datum och tid (valfritt) då användning av den beställda artikeln planeras påbörja.</items>
            </items>
            <items code="at0013">
                <items id="text">Datum/tid för avslutad order</items>
                <items id="description">Datum och tid (valfritt) då användning av den beställda artikeln planeras upphöra.</items>
            </items>
            <items code="at0016">
                <items id="text">Stoppkriterium för order</items>
                <items id="description">Det villkor som måste vara uppfyllt innan administrering eller användning upphör.</items>
                <items id="comment">Till exempel: "Stoppa efter att symptomen försvinner".</items>
            </items>
            <items code="at0018">
                <items id="text">Klinisk indikation</items>
                <items id="description">Klinisk orsak till användning av den beställda artikeln.</items>
                <items id="comment">Till exempel: "Angina pectoris". Om möjligt, benämn den kliniska indikationen med en terminologi. Dataelementet tillåter flera förekomster. Är dock ej avsedd att innehålla indikation för administrativa tillståndsändamål.</items>
            </items>
            <items code="at0044">
                <items id="text">Ytterligare instruktioner</items>
                <items id="description">Ytterligare instruktioner för hur beställd produkt ska brukas.</items>
                <items id="comment">Exempelvis försiktighetsåtgärder som "Ta med mat", "Undvik grapefrukt", "Lös upp i vatten", "Förvara på en sval, torr plats". Detta dataelement tillåter flera förekomster och bör kodas med en referensterminologi där det är möjligt.</items>
            </items>
            <items code="at0047">
                <items id="text">Tolkningsanvisningar</items>
                <items id="description">En tolkbar, computable textrepresentation av anvisningarna.</items>
                <items id="comment">Generellt används detta endast när information skickas mellan äldre system. Till exempel: "10 mg bd; 20 mg n" som används av NHS dos-syntax (under utveckling).</items>
            </items>
            <items code="at0050">
                <items id="text">Varaktighet för slutförd order</items>
                <items id="description">Den tidsperiod under vilken individen/patienten redan har använt den beställda artikeln. Detta är en del av den avsedda totala beställningen, men före utfärdandet av denna beställning.</items>
                <items id="comment">Exempelvis för att registrera att patienten hade tagit antibiotika tre dagar före inskrivning på sjukhus i samband med en 7-dagarskur.</items>
            </items>
            <items code="at0051">
                <items id="text">Maximal dos</items>
                <items id="description">Detaljer om den maximala, kumulativa dosen av den beställda artikeln som tillåts under en definierad period.</items>
                <items id="comment">Till exempel: "upp till 1 gram per dag". För att möjliggöra representation av flera maximala doser som gäller för olika tidsperioder, tillåts flera dosvärden i detta kluster. Maximal dos under en livstid bör inte tas till hänsyn här eftersom det hänvisar till flera beställningar över tiden.</items>
            </items>
            <items code="at0053">
                <items id="text">Tillåten period</items>
                <items id="description">Tidsperioden under vilken den maximala dosen är beräknad.</items>
                <items id="comment">Exempelvis 24 timmar.</items>
            </items>
            <items code="at0060">
                <items id="text">Slutförda administrationer</items>
                <items id="description">Antalet slutförda administrationer av den beställda artikeln. Detta är en del av den avsedda totala beställningen, men före utfärdandet av denna beställning.</items>
                <items id="comment">Exempelvis för att registrera att patienten har tagit de två första antibiotikatabletterna under en 3-dagarskur före utskrivning från sjukhuset till ett vårdhem.</items>
            </items>
            <items code="at0062">
                <items id="text">Läkemedelssäkerhet</items>
                <items id="description">Detaljer om medicinsk säkerhet för den beställda artikeln.</items>
            </items>
            <items code="at0064">
                <items id="text">Säkerhet åsidosatt?</items>
                <items id="description">Bekräftelse från ordineraren att normal dos eller annan säkerhetsgräns har åsidosatts på grund av exceptionella omständigheter.</items>
            </items>
            <items code="at0065">
                <items id="text">Dispenseringsmängd</items>
                <items id="description">Detaljer om den mängden av beställd artikel som ska dispenseras.</items>
                <items id="comment">Denna SLOT gör det möjligt att hantera lokal variation i olika jurisdiktioner angående läkemedelsdispensering.</items>
            </items>
            <items code="at0069">
                <items id="text">Anvisningar om auktorisering</items>
                <items id="description">Detaljer om auktorisering av den beställda artikeln, inklusive stöd för lokal självadministrering, utförda och godkännandepolicyer.</items>
                <items id="comment">Exempelvis information om upprepning/påfyllning. Denna SLOT gör det möjligt att hantera lokal variation i de olika jurisdiktionerna med avseende på medicineringstillstånd och återbehörighet.</items>
            </items>
            <items code="at0070">
                <items id="text">Läkemedelsartikel</items>
                <items id="description">Benämning på det läkemedel, vaccin eller annan terapeutisk/ordinerbar artikel som beställs.&#13;
</items>
                <items id="comment">Beroende på ordinationstyp, kan detta fält användas för antingen generisk eller produktbaserad ordination. Detta datafält kan användas för att registrera relaterade beställningar av olika läkemedel när de ordineras som enpack. Om möjligt, benämn läkemedelsartikeln med en terminologi. Omfattningen av benämningen kan variera från namn på läkemedelsartikeln till detaljer om själva läkemedelspaketet. Fri textinmatning bör endast användas om det inte finns någon lämplig terminologi tillgänglig.</items>
            </items>
            <items code="at0091">
                <items id="text">Administreringsväg</items>
                <items id="description">Sättet genom vilken den beställda artikeln ska administreras i patientens kropp.</items>
                <items id="comment">Till exempel: "oralt", "intravenöst" eller "lokalt". Om möjligt, benämn administreringsvägen med en terminologi. Flera potentiella administreringsvägar kan specificeras.</items>
            </items>
            <items code="at0092">
                <items id="text">Kroppsområde</items>
                <items id="description">Beskrivning av administrationsstället för den beställda artikeln.</items>
                <items id="comment">Till exempel: "vänster överarm", "intravenös kateter, höger hand". Om möjligt, benämn den anatomiska lokaliseringen med en terminologi.</items>
            </items>
            <items code="at0093">
                <items id="text">Strukturerat kroppsområde</items>
                <items id="description">Strukturerad beskrivning av administrationsstället för den beställda produkten.</items>
            </items>
            <items code="at0094">
                <items id="text">Administreringsmetod</items>
                <items id="description">Den teknik eller utrustning med vilken den beställda artikeln ska administreras.</items>
                <items id="comment">Till exempel: "via Z-teknik"; "via nebulisator". Om möjligt, benämn metoden med en terminologi.</items>
            </items>
            <items code="at0095">
                <items id="text">Administreringsutrustning</items>
                <items id="description">Information om den medicinska utrustning som används vid administrering av läkemedlet.</items>
            </items>
            <items code="at0105">
                <items id="text">Patientinformation</items>
                <items id="description">Ytterligare instruktion främst riktad till vårdtagaren eller vårdgivaren.</items>
                <items id="comment">Till exempel: "Att sänka ditt blodtryck", "Att tona ut ditt blod". Detta dataelement tillåter flera förekomster och bör kodas med en referensterminologi där det är möjligt. Vid behov är det även möjligt att använda ett LINK-attribut för att associera detta element till exempelvis den ''ursprungliga diagnosen'' i en separat komposition. En indikation bör dock explicit registreras här, eftersom lLINK-attributet kan förändras över tiden.</items>
            </items>
            <items code="at0106">
                <items id="text">Instruktion för dispensering</items>
                <items id="description">Ytterligare instruktion riktad främst till den individ som ska dispensera den beställda artikeln.</items>
                <items id="comment">Exempelvis detaljerade instruktioner för fasvis dosering av opiater.</items>
            </items>
            <items code="at0107">
                <items id="text">Övervakningsinstruktioner</items>
                <items id="description">Ytterligare instruktion om rekommenderad eller begärd övervakning av den beställda artikeln.</items>
                <items id="comment">Till exempel: "Kontrollera njurfunktionen om två veckor". Detta dataelement tillåter flera förekomster.</items>
            </items>
            <items code="at0112">
                <items id="text">Ordersammanfattning</items>
                <items id="description">Sammanfattad information om användning av den beställda artikeln, såsom aktuell status eller nyckeldatum som vanligtvis används i receptfria sammanhang.</items>
                <items id="comment">Översikt av kuren kan krävas vid överföring av läkemedelsinformation mellan system eller vid representation av ett FHIR-läkemedelsuttalande. Exempelvis som en del av en remiss, översikt av patient på akutavdelning eller utskrivning.</items>
            </items>
            <items code="at0113">
                <items id="text">Orderdetaljer</items>
                <items id="description">Detaljer om läkemedelsbeställningen.</items>
            </items>
            <items code="at0129">
                <items id="text">Anvisningar för dispensering</items>
                <items id="description">Anvisningar för dispensering av den beställda artikeln.</items>
            </items>
            <items code="at0130">
                <items id="text">Maximal dosmängd</items>
                <items id="description">*The maximum, cumulative amount of medication which should be administered within the allowed period.(en)</items>
                <items id="comment">*For example: 1 ml, 1.5 mg, 0.125 g.(en)</items>
            </items>
            <items code="at0132">
                <items id="text">Anvisningar för substitution</items>
                <items id="description">Tillstånd för att ersätta en bioekvivalent artikel.</items>
                <items id="comment">I många jurisdiktioner är det möjligt att vid dispenseringstillfället ersätta en beställd artikel med en generisk sort eller med ett annat varumärke, förutsatt att bioekvivalens är uppnått. I andra fall antas substitution vara tillåtet, såvida en kliniker explicit inte begär annat.</items>
            </items>
            <items code="at0139">
                <items id="text">Prioritet</items>
                <items id="description">Indikation på hur brådskande den beställda artikeln ska dispenseras.</items>
                <items id="comment">Till exempel "Brådskande". Detta ska modelleras eller specialiseras enligt lokala värdesatser. Vissa jurisdiktioner tillåter att instruktioner om dispensering markeras som ”brådskande” så att apoteket hanterar dem snabbt.</items>
            </items>
            <items code="at0143">
                <items id="text">Läkemedelsdetaljer</items>
                <items id="description">Strukturerade detaljer på övergripande nivå inklusive styrka, beredningsform och beståndsdelar.</items>
                <items id="comment">Använd denna SLOT om beskrivningen av den beställda artikeln måste anges explicit. Till exempel: formen, styrkan, eventuella utspädningsmedel eller blandning av ingredienser.</items>
            </items>
            <items code="at0148">
                <items id="text">Behandlingsavsikt</items>
                <items id="description">Den övergripande behandlingsavsikten med den beställda artikeln.</items>
                <items id="comment">Till exempel: "smärtlindring"; "palliativ vård"; "lågdosprofylakse"; "rehydrering"; "näringsinfusion".</items>
            </items>
            <items code="at0150">
                <items id="text">Total daglig effektiv dos</items>
                <items id="description">Detaljer om den totala mängden per dag för den beställda artikeln som förväntas administreras.</items>
                <items id="comment">Den totala dagliga dosen registrerar den förväntade effektiva dosen. På så vis stödjs titrering av en initial låg dos mot den effektiva dosen över viss tidsperiod. Detta är inte måldosen i sig, utan den effektiva dagliga dosen som resulterar i måldosen. Under vissa omständigheter kan den totala dagliga dosen beräknas från beräkningsbara anvisningar, i andra fall kan den behöva anges manuellt.</items>
            </items>
            <items code="at0151">
                <items id="text">Total daglig dos</items>
                <items id="description">Mängd av beställd produkt som kommer att tas varje dag om avsedda administreringsanvisningar följs.</items>
                <items id="comment">*For example '20 mg'.(en)</items>
            </items>
            <items code="at0154">
                <items id="text">Skäl till ej tillåten substitution</items>
                <items id="description">Anledningen till att en beställd artikel inte ska ersättas vid dispensering.</items>
                <items id="comment">Till exempel "Generisk beredning inte bioekvivalent".</items>
            </items>
            <items code="at0155">
                <items id="text">Startdatum för dispensering</items>
                <items id="description">Det datum från vilket den beställda artikeln får dispenseras för första gången.</items>
                <items id="comment">Kan användas för att kontrollera tidpunkten för dispensering av läkemedel med risk för missbruk. Exempelvis bensodiazepiner eller analgetika.</items>
            </items>
            <items code="at0161">
                <items id="text">Utgångsdatum för dispensering</items>
                <items id="description">Datumet efter det att den beställda artikeln inte längre är giltig för laglig dispensering</items>
                <items id="comment">I vissa jurisdiktioner kan ordrar om utdelning ha ett utgångsdatum efter vilket receptet kanske inte ges ut.</items>
            </items>
            <items code="at0162">
                <items id="text">Anledning för åsidosättning</items>
                <items id="description">Anledningen till åsidosättning av en klinisk säkerhet eller överskridande av maximal dos.</items>
                <items id="comment">Till exempel: "Inte mottaglig för maximal rekommenderad dos. Kritisk situation.", "Peniciilin är endast giltig behandling, sannolikheten för sann penicillinallergi är låg".</items>
            </items>
            <items code="at0165">
                <items id="text">Syfte</items>
                <items id="description">Beskrivning av anledningen till registrering av en total daglig effektiv dos.</items>
                <items id="comment">Till exempel: "Hypertonikontroll", "Måldos 20 mg dagligen". Beskrivningen kan användas för att identifiera ett namn, en fras eller ett stycke om syftet med att registrera den totala dagliga effektiva dosen, vanligtvis för att möjliggöra titrering mot en specifik måldos. Målet eller måldosen kan registreras här eller som en del av bifogad EVALUATION "Mål"-arketyp.</items>
            </items>
            <items code="at0166">
                <items id="text">Ytterligare information</items>
                <items id="description">Ytterligare strukturerad information om den beställda artikeln som inte fångats i andra fält.</items>
            </items>
            <items code="at0167">
                <items id="text">Kommentar</items>
                <items id="description">Kommentarer avseende läkemedelsbeställningen som inte beskrivs i övriga fält.</items>
            </items>
            <items code="at0168">
                <items id="text">Tillåtet</items>
                <items id="description">Ersättning av läkemedlet med ett bioekvivalent alternativ är tillåtet.</items>
            </items>
            <items code="at0169">
                <items id="text">Ej tillåtet</items>
                <items id="description">Ersättning av läkemedlet med ett bioekvivalent alternativ är inte tillåtet.</items>
            </items>
            <items code="at0170">
                <items id="text">Detaljer om dispensering</items>
                <items id="description">Ytterligare information om dispenseringsanvisningar.</items>
                <items id="comment">Denna SLOT möjliggör lokal variation i de olika jurisdiktionerna när det gäller läkemedelsdispensering.</items>
            </items>
            <items code="at0171">
                <items id="text">Åsidosatta säkerhetsanvisningar</items>
                <items id="description">En känd säkerhetsfråga som gäller för vårdtagaren och den beställda artikeln, såsom en allergi, varning om läkemedel eller kontraindikation. Detta element registreras normalt bara när säkerhetsanvisningarna åsidosätts.</items>
                <items id="comment">Till exempel: "Allergiskt mot penicillin", "Atenolol duplicerat".</items>
            </items>
            <items code="at0173">
                <items id="text">Specifika anvisningar</items>
                <items id="description">Beskrivning av en specifik del av de övergripande anvisningarna.</items>
                <items id="comment">I vissa fall är det vanligt att fördela övergripande anvisningar i mer specifika segment. I exempelvis sjukhussammanhang kan det vara vanligt att dela upp anvisningarna i "Dosmängd" och "Tidpunkt för dos", båda som berättande text. These terms can be applied at template or run-time.</items>
            </items>
            <items code="at0174">
                <items id="text">Motivering till dos</items>
                <items id="description">Motivering till beräkning av dosmängd eller administreringshastighet där detta är beroende av utomstående faktor.</items>
                <items id="comment">Till exempel: "Justerad för amputation".</items>
            </items>
            <items code="at0177">
                <items id="text">Strukturerad dos och tidsanvisningar</items>
                <items id="description">Detaljer om strukturerad dos och tidsanvisningar.</items>
                <items id="comment">*This SLOT has been designed to be used with the CLUSTER.therapeutic_direction archetype to enable recording of a complex set of dosage and timing directions. While it's possible to use other CLUSTER archetypes within this SLOT, it's strongly advised to do so only when predictable queryability is not a priority.(en)</items>
            </items>
            <items code="at0178">
                <items id="text">Åsidosättande av säkerhet</items>
                <items id="description">Åsidosättande av en känd säkerhetsfråga som gäller för vårdtagaren och den beställda artikeln, såsom en allergi, varning om läkemedelsdubblering eller kontraindikation.</items>
            </items>
            <items code="at0179">
                <items id="text">*Clinician guidance(en)</items>
                <items id="description">*Advice to future prescribers/dispensers about the ongoing, long term order.(en)</items>
                <items id="comment">*For example: 'don't allow brand substitution' or advice regarding using a specific brand to avoid fillers that cause reactions.(en)</items>
            </items>
        </term_definitions>
        <term_definitions language="de">
            <items code="at0000">
                <items id="text">Verordnung von Arzneimittel</items>
                <items id="description">Verschreibung eines Medikaments, Impfstoffs, Ernährungsprodukts oder anderen therapeutischen Mittels für eine bestimmte Person.</items>
            </items>
            <items code="at0001">
                <items id="text">Verordnung</items>
                <items id="description">Angaben zur Verordnung.</items>
            </items>
            <items code="at0002">
                <items id="text">Tree</items>
                <items id="description">@ internal @</items>
            </items>
            <items code="at0004">
                <items id="text">ID der Verordnung</items>
                <items id="description">Eindeutige Kennung der Medikamentenverordnung / des Rezeptes.</items>
                <items id="comment">Dieses Datenelement ermöglicht während der Laufzeit der Anwendung eine genauere Spezifikation von mehrfach auftretenden Instanzen, wenn notwendig.</items>
            </items>
            <items code="at0005">
                <items id="text">Tree</items>
                <items id="description">@ internal @</items>
            </items>
            <items code="at0008">
                <items id="text">Erweiterung</items>
                <items id="description">Zusätzliche Informationen zur Erfassung lokaler Inhalte oder Anpassung an andere Referenzmodelle/Formalismen.</items>
                <items id="comment">Zum Beispiel: Lokaler Informationsbedarf oder zusätzliche Metadaten zur Anpassung an FHIR-Ressourcen oder CIMI-Modelle.</items>
            </items>
            <items code="at0009">
                <items id="text">Allgemeine Beschreibung der Anweisungen</items>
                <items id="description">Gesamtbeschreibung, wie das verordneten Medikament zu verwenden ist.</items>
                <items id="comment">Wenn die Anweisungen zur Dosierung vollständig strukturiert dargestellt werden können, sollte dieses Element ein Freitextäquivalent enthalten, das normalerweise automatisch generiert wird. Wenn es nicht möglich ist, die gewünschten Dosisanweisungen vollständig in strukturierter Form darzustellen, wird eine Teildarstellung nicht empfohlen. Stattdessen sollte die Anweisung nur als Freitext in diesem Datenelement aufgezeichnet werden.</items>
            </items>
            <items code="at0011">
                <items id="text">Startkriterium für die Verordnung</items>
                <items id="description">Eine Bedingung für den Beginn der Verwendung des verordneten Arzneimittels.</items>
                <items id="comment">Zum Beispiel: "Start, wenn die Symptome wieder auftreten". Dies ist als Voraussetzung gedacht, die den Beginn des gesamten Medikationsverlaufs auslösen soll, und nicht für Verabreichungen "bei Bedarf" innerhalb einer laufenden Verordnung.</items>
            </items>
            <items code="at0012">
                <items id="text">Beginn der Verordnung</items>
                <items id="description">Datum und optionale Uhrzeit für den Beginn der Verwendung des verordneten Arzneimittels.</items>
            </items>
            <items code="at0013">
                <items id="text">Ende der Verordnung</items>
                <items id="description">Datum und optionale Uhrzeit, wann die Verwendung des verordneten Arzneimittels eingestelt werden soll.</items>
            </items>
            <items code="at0016">
                <items id="text">Stopkriterium für die Verordnung</items>
                <items id="description">Eine Bedingung für das Einstellen der Verwendung des verordneten Arzneimittels.</items>
                <items id="comment">Zum Beispiel: "Beenden nach Abklingen der Symptome".</items>
            </items>
            <items code="at0018">
                <items id="text">Klinische Indikation</items>
                <items id="description">Der klinische Grund für die Verwendung des verordneten Arzneimittels.</items>
                <items id="comment">Zum Beispiel: "Angina". Die Kodierung der klinischen Indikation mit einer Terminologie wird nach Möglichkeit bevorzugt. Dieses Datenelement kann mehrfach vorkommen. Es ist nicht beabsichtigt, eine Angabe für behördliche Genehmigungszwecke mitzuführen.</items>
            </items>
            <items code="at0044">
                <items id="text">Zusätzliche Anweisung</items>
                <items id="description">Ein zusätzlicher Hinweis zur Verwendung oder Lagerung des verordneten Arzneimittels.</items>
                <items id="comment">Zum Beispiel: Vorsichtsmaßnahmen wie "Mit dem Essen nehmen", "Grapefruit vermeiden", "In Wasser auflösen", "An einem kühlen, trockenen Ort aufbewahren". Dieses Datenelement kann mehrfach vorkommen und sollte nach Möglichkeit mit einer Referenz-Terminologie kodiert werden.</items>
            </items>
            <items code="at0047">
                <items id="text">Maschinenlesbare Anweisungen</items>
                <items id="description">Eine maschinenlesbare, berechenbare Textdarstellung der Anweisung.</items>
                <items id="comment">Wird normalerweise zum Austausch von Informationen zwischen Legacy-Systemen verwendet. Zum Beispiel: "10mg bd; 20 mg n", wie von der NHS-Dosissyntax verwendet (in Entwicklung).</items>
            </items>
            <items code="at0050">
                <items id="text">Dauer der durchgeführten Verordnung</items>
                <items id="description">Der Zeitraum, in dem die Person / der Patient das verordnete Arzneimittel noch vor der Ausstellung dieser Verordnung bereits angewendet hat.</items>
                <items id="comment">Zum Beispiel: Zur Darstellung, dass der Patient vor einem Krankenhausaufenthalt, im Kontext eines 7-tägigen Kurs, 3 Tage lang Antibiotika eingenommen hat.</items>
            </items>
            <items code="at0051">
                <items id="text">Maximale Dosis</items>
                <items id="description">Details zur maximal zulässigen kumulativen Dosis über einen definierten Zeitraum für das verordnete Arzneimittel.</items>
                <items id="comment">Zum Beispiel: "Bis zu 1 Gramm pro Tag". Dieses Cluster kann mehrmals vorkommen, um die Darstellung mehrerer Maximaldosen zu ermöglichen, die für verschiedene Zeiträume gelten. Die lebenslange Maximaldosis sollte hier nicht mitgeführt werden, da sie sich auf mehrere Aufträge im Zeitverlauf bezieht.</items>
            </items>
            <items code="at0053">
                <items id="text">Zulässige Dauer</items>
                <items id="description">Der Zeitraum, für den die maximale Dosis berechnet wird.</items>
                <items id="comment">Beispiel: 24 Stunden.</items>
            </items>
            <items code="at0060">
                <items id="text">Anwendungen durchgeführt</items>
                <items id="description">Die Anzahl der Verabreichungen des verordneten Arzneimittels, die im Rahmen der geplanten Gesamtverordnung, bereits vor dieser Ausgabe, durchgeführt wurden.</items>
                <items id="comment">Zum Beispiel: Zur Darstellung, dass der Patient die beiden ersten Antibiotika-Tabletten eines dreitägigen Kurses eingenommen hat, bevor er aus dem Krankenhaus in ein Pflegeheim entlassen wurde.</items>
            </items>
            <items code="at0062">
                <items id="text">Arzneimittelsicherheit</items>
                <items id="description">Angaben über die Arzneimittelsicherheit des verordneten Medikaments.</items>
            </items>
            <items code="at0064">
                <items id="text">Beabsichtigte Sicherheitsüberschreitung?</items>
                <items id="description">Bestätigung durch den verschreibenden Arzt, ob die normale Dosis oder andere Sicherheitsgrenzen aufgrund besonderer Umstände überschritten wurden.</items>
            </items>
            <items code="at0065">
                <items id="text">Abgabemenge</items>
                <items id="description">Detaillierte Angaben zur Menge des verordneten Arzneimittels, das abgegeben werden soll.</items>
                <items id="comment">Dieser SLOT ermöglicht die lokaler Unterschiede in den verschiedenen Rechtsordnungen in Bezug auf die Abgabemenge von Arzneimitteln zu verwalten.</items>
            </items>
            <items code="at0069">
                <items id="text">Anweisungen zur Genehmigung</items>
                <items id="description">Details der Autorisierung für das verordnete Arzneimittel, einschließlich Unterstützung der lokalen Richtlinien zur Selbstverwaltung, Ausgabe und Bestätigung.</items>
                <items id="comment">Zum Beispiel: Angaben über Wiederholung oder Nachbereitung. Dieser SLOT ermöglicht lokale Unterschiede zwischen verschiedenen Rechtsordnungen hinsichtlich der Genehmigung und Re-Autorisierung von Arzneimitteln zu verwalten.</items>
            </items>
            <items code="at0070">
                <items id="text">Arzneimittel</items>
                <items id="description">Name des verordneten Medikaments, Impfstoffs oder anderen therapeutischen / verschreibungsfähigen Mittels.</items>
                <items id="comment">Je nach Kontext kann dieses Feld entweder für die generische oder die produktbasierte Verschreibung verwendet werden. In diesem Datenelement können eng gebundene Verordnungen verschiedener Medikamente dargestellt werden, wenn diese als Einzelpackung verschrieben werden. Es wird dringend empfohlen, das „Arzneimittel“ mit einer Terminologie zu kodieren, die nach Möglichkeit eine Entscheidungsunterstützung triggern kann. Der Umfang der Kodierung kann vom einfachen Medikamentennamen bis zu strukturierten Details über die tatsächlich zu verwendende Medikamentenpackung variieren. &#13;
Die Freitexteingabe sollte nur verwendet werden, wenn keine entsprechende Terminologie verfügbar ist.</items>
            </items>
            <items code="at0091">
                <items id="text">Verabreichungsweg</items>
                <items id="description">Die Angabe darüber, auf welche Art das verordnete Arzneimittel am Körper des Patienten angewendet wird.</items>
                <items id="comment">Zum Beispiel: "oral", "intravenös" oder "topisch". &#13;
Die Kodierung des Verabreichungswegs mit einer Terminologie wird nach Möglichkeit bevorzugt. Es können mehrere mögliche Verabreichungswege angegeben werden.</items>
            </items>
            <items code="at0092">
                <items id="text">Körperstelle</items>
                <items id="description">Name der Körperstelle, an der das Arzneimittel verabreicht wird.</items>
                <items id="comment">Zum Beispiel: "linker Oberarm", "intravenöser Katheter rechte Hand".&#13;
Die Kodierung der Körperstelle mit einer Terminologie ist nach Möglichkeit bevorzugt.</items>
            </items>
            <items code="at0093">
                <items id="text">Lokalisation</items>
                <items id="description">Strukturierte Beschreibung der Körperstelle, an der das Arzneimittel verabreicht wird.</items>
            </items>
            <items code="at0094">
                <items id="text">Methode der Verabreichung</items>
                <items id="description">Die Technik oder das Gerät mit dem das versordnete Arzneimittel verabreicht werden soll.</items>
                <items id="comment">Zum Beispiel: "via Z-track Injektion"; "via Vernebler". Die Kodierung der Methode mit einer Terminologie, wenn möglich, wird bevorzugt.</items>
            </items>
            <items code="at0095">
                <items id="text">Verabreichungsmittel</items>
                <items id="description">Details zu der Vorrichtung mit der das verordnete Arzneimittel verabreicht wird.</items>
            </items>
            <items code="at0105">
                <items id="text">Patienteninformation</items>
                <items id="description">Ein zusätzlicher Hinweis, der sich in erster Linie an die Person/ den Patienten oder Angehörige richtet.</items>
                <items id="comment">Zum Beispiel: "Zur Senkung Ihres Blutdruckes", "Zur Blutverdünnung". Dieses Datenelement kann mehrfach vorkommen und sollte nach Möglichkeit mit einer entsprechenden Terminologie kodiert werden. Bei Bedarf ist es möglich, dieses Element über ein LINK-Attribut z.B. der "ursprünglichen Diagnose" in einer separaten Problemliste zuzuordnen, und die Angabe sollte hier explizit dargestellt werden, da sich das Ziel des Links im Laufe der Zeit ändern kann.</items>
            </items>
            <items code="at0106">
                <items id="text">Abgabehinweis</items>
                <items id="description">Ein zusätzlicher Hinweis richtet sich in erster Linie an die Person, die das verordnete Arzneimittel verteilt.</items>
                <items id="comment">Beispiel: Detaillierte Anweisungen für die schrittweise Abgabe von Opiaten.</items>
            </items>
            <items code="at0107">
                <items id="text">Überwachungshinweis</items>
                <items id="description">Eine zusätzliche Anweisung mit Hinweisen auf die empfohlene oder erforderliche Überwachung bei Verwendung des verordneten Arzneimittels.</items>
                <items id="comment">Zum Beispiel: "Bitte um Überprüfung der Nierenfunktion in 2 Wochen". Dieses Datenelement kann mehrfach vorkommen.</items>
            </items>
            <items code="at0112">
                <items id="text">Zusammenfassung der Verordnung</items>
                <items id="description">Zusammenfassende Informationen zur Verwendung des verordneten Arzneimittels, z. B. aktueller Status oder Schlüsseldaten, die normalerweise in anderen Kontexten außer Verordnung verwendet werden.</items>
                <items id="comment">Eine Zusammenfassung der Verordnung kann erforderlich sein, wenn Arzneimittelinformationen zwischen Systemen übertragen oder eine FHIR- "Medication Statement" dargestellt werden. Zum Beispiel: Als Teil einer Überweisung, einer Übersicht über Notfallpatienten oder Kommunikation bei der Entlassung.</items>
            </items>
            <items code="at0113">
                <items id="text">Detaillierte Angaben zu der Verordnung</items>
                <items id="description">Detaillierte Angaben zu der gesamten Medikamentenverordnung.</items>
            </items>
            <items code="at0129">
                <items id="text">Anweisungen zur Abgabe</items>
                <items id="description">Anweisungen zur Abgabe des verordneten Arzneimittels.</items>
            </items>
            <items code="at0130">
                <items id="text">Höchstmenge</items>
                <items id="description">Die maximale, kumulative Menge an Medikamenten, die innerhalb des zulässigen Zeitraums verabreicht werden sollte.</items>
                <items id="comment">Zum Beispiel: 1 ml, 1,5 mg, 0,125 g.</items>
            </items>
            <items code="at0132">
                <items id="text">Substitutionsanweisung</items>
                <items id="description">Erlaubnis zum Ersatz durch ein bioäquivalentes Arzneimittel.</items>
                <items id="comment">In vielen Ländern ist der Ersatz eines verordneten Arzneimittels mit einer generischen Form oder mit einem anderen Markennamen, der als bioäquivalent bestimmt wurde, zum Zeitpunkt der Abgabe oder Bereitstellung zulässig. In anderen Fällen wird von einer Substitution ausgegangen und der Arzt muss ausdrücklich die Substitution ablehnen.</items>
            </items>
            <items code="at0139">
                <items id="text">Priorität</items>
                <items id="description">Ein Indikator wie dringlich das verordnete Arzneimittel abgegeben werden soll.</items>
                <items id="comment">Zum Beispiel: "Dringend". Dies bleibt dem Template vorbehalten oder auf die lokalen Wertesätze zu spezialisieren. In einigen Rechtsbereichen ist es erlaubt, Anweisungen zur Abgabe als "dringend" zu kennzeichnen, so dass die Apotheke sie schnell bearbeitet.</items>
            </items>
            <items code="at0143">
                <items id="text">Angaben zur Medikation</items>
                <items id="description">Strukturierte Angaben über das gesamte Medikament, einschließlich Stärke, Form und Inhaltsstoffe.</items>
                <items id="comment">Verwenden Sie diesen SLOT, wenn detaillierte Beschreibung des verordneten Arzneimittels explizit angegeben werden muss. Zum Beispiel: Form, Stärke, Verdünnungsmittel oder Mischung von Inhaltsstoffen.</items>
            </items>
            <items code="at0148">
                <items id="text">Therapiezweck</items>
                <items id="description">Gesamttherapeutischer Zweck des verordneten Arzneimittels.</items>
                <items id="comment">Zum Beispiel: "Schmerzlinderung"; "Palliativversorgung"; "Niedrigdosis-Prophylaxe"; "Rehydratation"; "Ernährungsinfusion".</items>
            </items>
            <items code="at0150">
                <items id="text">Tägliche effektive Gesamtdosis</items>
                <items id="description">Angaben zur täglichen Gesamtmenge des verordneten Arzneimittels, das verabreicht werden soll.</items>
                <items id="comment">Die tägliche Gesamtdosis zeichnet die erwartete wirksame Dosis auf und unterstützt somit die Titration einer anfänglichen niedrigen Dosis in Richtung der wirksamen Dosis über einen Zeitraum. Dies ist nicht die Zieldosis oder das Ziel, sondern die tatsächlich wirksame Tagesdosis innerhalb dieses Ziels. In einigen Fällen kann die tägliche Gesamtdosis aus maschinenlesbaren Anweisungen berechnet werden, in anderen Fällen muss sie möglicherweise manuell eingegeben werden.</items>
            </items>
            <items code="at0151">
                <items id="text">Tägliche Gesamtdosis</items>
                <items id="description">Die Gesamtmenge des Arzneimittels, die bei bestimmungsgemäßer Verabreichung täglich angewendet wird.</items>
                <items id="comment">Zum Beispiel "20 mg".</items>
            </items>
            <items code="at0154">
                <items id="text">Ablehnungsgrund der Substitution</items>
                <items id="description">Der Grund warum eine Substitution des verordneten Arzneimittels nicht zulässig ist.</items>
                <items id="comment">Zum Beispiel "Generika sind nicht bioäquivalent".</items>
            </items>
            <items code="at0155">
                <items id="text">Beginn der Abgabe</items>
                <items id="description">Das Datum, ab dem das verordnete Arzneimittel zum ersten Mal abgegeben werden darf.</items>
                <items id="comment">Kann verwendet werden, um die Abgabezeit von Arzneimitteln mit Missbrauchspotenzial zu kontrollieren. Zum Beispiel: Benzodiazepine oder Analgetika.</items>
            </items>
            <items code="at0161">
                <items id="text">Ablaufdatum der Abgabe</items>
                <items id="description">Das Datum, ab dem das Rezept für die legale Abgabe des Arzneimittels nicht mehr gültig ist.</items>
                <items id="comment">In einigen Ländern haben Rezepte zur Abgabe des Arzneimittels ein Ablaufdatum, nach dem die Verordnung nicht mehr abgegeben werden darf.</items>
            </items>
            <items code="at0162">
                <items id="text">Grund der Überschreitung</items>
                <items id="description">Der Grund für eine Überschreitung der klinischen Sicherheit oder maximalen Dosis.</items>
                <items id="comment">Zum Beispiel: "Nicht ansprechbar bei der empfohlenen Höchstdosis. Kritische Situation.", "Penicillin ist die einzige gültige Behandlung, die Wahrscheinlichkeit einer echten Penicillin-Allergie ist gering".</items>
            </items>
            <items code="at0165">
                <items id="text">Zweck</items>
                <items id="description">Beschreibung des Grundes für die Erfassung einer täglichen effektiven Gesamtdosis.</items>
                <items id="comment">Zum Beispiel: "Hypertoniekontrolle", "Zieldosis 20 mg täglich". Die Beschreibung könnte verwendet werden, um einen Namen, Ausdruck oder einen Absatz über den Aufzeichnungszweck der gesamten täglichen Dosis zu identifizieren. Üblicherweise um eine Titration auf eine bestimmte Zieldosis zu ermöglichen.&#13;
Das Ziel oder die Zieldosis kann hier als Teil eines verknüpften EVALUATION-Archetyps "Ziel" (EVALUATION.goal) dargestellt werden.</items>
            </items>
            <items code="at0166">
                <items id="text">Zusätzliche Information</items>
                <items id="description">Zusätzliche strukturierte Angaben über verordnetes Arzneimittel, die nicht in anderen Feldern erfasst wurden.</items>
            </items>
            <items code="at0167">
                <items id="text">Kommentar</items>
                <items id="description">Zusätzliche Kommentare über die Medikamentenverordnung, die nicht in anderen Feldern erfasst wurden.</items>
            </items>
            <items code="at0168">
                <items id="text">Erlaubt</items>
                <items id="description">Die Substitution des Arzneimittels mit einem bioequivalenten Arzneimittel ist erlaubt.</items>
            </items>
            <items code="at0169">
                <items id="text">Nicht erlaubt</items>
                <items id="description">Die Substitution des Arzneimittels mit einem bioequivalenten Arzneimittel ist nicht erlaubt.</items>
            </items>
            <items code="at0170">
                <items id="text">Details der Abgabe</items>
                <items id="description">Weitere detaillierte Angaben zu den Anweisungen zur Abgabe.</items>
                <items id="comment">Dieser Slot erlaubt lokale Unterschiede in den verschiedenen Rechtsbereichen bezüglich der Arzneimittelabgabe.</items>
            </items>
            <items code="at0171">
                <items id="text">Hinweis zur überschrittenen Sicherheitsgrenze</items>
                <items id="description">Ein bekanntes oder anerkanntes Sicherheitsproblem, das für dieses Medikament gilt, wie z. B. eine Allergie, ein Warnhinweis zur Vervielfältigung von Arzneimitteln oder eine Kontraindikation. Dieses Element wird normalerweise nur aufgezeichnet, wenn dieser Sicherheitshinweis außer Kraft gesetzt wird.</items>
                <items id="comment">Zum Beispiel: "Allergisch gegen Penicillin", "Atenolol dupliziert".</items>
            </items>
            <items code="at0173">
                <items id="text">Beschreibung der spezifischen Anweisungen</items>
                <items id="description">Freitextbeschreibung eines bestimmten Teils der Gesamtanweisung.</items>
                <items id="comment">In einigen Kontexten ist es üblich, die gesamte Freitextbeschreibung der Anweisung in spezifischere Segmente aufzuteilen. In Krankenhäusern kann es beispielsweise üblich sein, die gesamten Anweisungen in "Dosismenge" und "Verabreichungszeiten" zu unterteilen, beide als Freitext. Diese Begriffe können im Template oder zur Laufzeit der Anwendung angewendet werden.</items>
            </items>
            <items code="at0174">
                <items id="text">Begründung der Dosis</items>
                <items id="description">Eine Beschreibung der Begründung für die Berechnung einer Dosismenge oder Verabreichungsrate, wenn dies von einem anderen Faktor abhängt.</items>
                <items id="comment">Zum Beispiel: "Angepasst wegen Amputation".</items>
            </items>
            <items code="at0177">
                <items id="text">Strukturierte Dosis- und Zeitangaben</items>
                <items id="description">Details zu strukturierten Dosis- und Zeitangaben</items>
                <items id="comment">Dieser SLOT wurde für die Verwendung mit dem Archetyp CLUSTER.therapeutic_direction konzipiert, um die Erfassung einer komplexen Reihe von Dosierungs- und Zeitangaben zu ermöglichen. Es ist zwar möglich, andere CLUSTER-Archetypen innerhalb dieses SLOTs zu verwenden, aber es wird dringend empfohlen, dies nur dann zu tun, wenn die vorhersehbare Abfragefähigkeit keine Priorität hat.</items>
            </items>
            <items code="at0178">
                <items id="text">Sicherheitsgrenze überschritten</items>
                <items id="description">Überschreiten eines bekannten oder anerkannten Sicherheitshinweis des Medikaments, wie z. B. eine Allergie, eine Warnung vor Drogenmissbrauch oder eine Kontraindikation.</items>
            </items>
            <items code="at0179">
                <items id="text">Klinische Leitlinie</items>
                <items id="description">Empfehlung an die zukünftigen Verordner/Abgeber über die fortlaufende, langjährige Verordnung.</items>
                <items id="comment">Zum Beispiel: "keinen Markenersatz zulassen" oder Ratschläge zur Verwendung einer bestimmten Marke, um Füllstoffe zu vermeiden, die Reaktionen hervorrufen.</items>
            </items>
        </term_definitions>
        <term_definitions language="nb">
            <items code="at0000">
                <items id="text">Legemiddelordinering</items>
                <items id="description">Ordinering av et legemiddel, en vaksine, parenteral væske, ernæringsprodukt eller medisinsk forbruksmateriell, for et spesifikt individ.</items>
            </items>
            <items code="at0001">
                <items id="text">Ordinering</items>
                <items id="description">Detaljer knyttet til ordineringen.</items>
            </items>
            <items code="at0002">
                <items id="text">Tree</items>
                <items id="description">@ internal @</items>
            </items>
            <items code="at0004">
                <items id="text">Ordineringsidentifikator</items>
                <items id="description">Unik identifikator for ordineringen.</items>
                <items id="comment">Dette dataelementet tillater flere forekomster, som ved behov kan defineres mer spesifikt i applikasjonen.</items>
            </items>
            <items code="at0005">
                <items id="text">Tree</items>
                <items id="description">@ internal @</items>
            </items>
            <items code="at0008">
                <items id="text">Tilleggsinformasjon</items>
                <items id="description">Ytterligere informasjon som er nødvendig for å registrere lokalt innhold/kontekst, eller for å sammenstille med andre referansemodeller/formalismer.</items>
                <items id="comment">For eksempel lokale informasjonsbehov eller ytterligere metadata for å kunne tilpasse til tilsvarende konsepter i FHIR eller CIMI.</items>
            </items>
            <items code="at0009">
                <items id="text">Overordnet anvisningsbeskrivelse</items>
                <items id="description">En komplett fritekstbeskrivelse av hvordan den ordinerte varen skal brukes.</items>
                <items id="comment">Denne fritekstbeskrivelsen bør vanligvis omfatte data i "Dosemengde", "Timing" og eventuelle andre instruksjoner. I tilfeller hvor legemiddelets anvisning er fullt strukturert, bør dette feltet inneholde en fritekstekvivalent som vanligvis autogenereres. Er det ikke mulig å representere de ønskede anvisningene i en fullt strukturert form, anbefales ikke delvis strukturert form. I stedet bør anvisningen kun registreres som fritekst i dette dataelementet.</items>
            </items>
            <items code="at0011">
                <items id="text">Startkriterium</items>
                <items id="description">Et vilkår for at den ordinerte varen kan tas i bruk.</items>
                <items id="comment">For eksempel "Start dersom symptomer kommer tilbake". Dette er ment som et generelt kriterium som setter i gang hele ordineringen, og ikke for behovsadministrering i en pågående ordinering.</items>
            </items>
            <items code="at0012">
                <items id="text">Startdato/tid for ordineringen</items>
                <items id="description">Dato og valgfri tid for oppstart av den ordinerte varen.</items>
            </items>
            <items code="at0013">
                <items id="text">Dato/tid for seponering</items>
                <items id="description">Dato og valgfri tid når det er planlagt å seponere den ordinerte varen.</items>
            </items>
            <items code="at0016">
                <items id="text">Seponeringskriterium</items>
                <items id="description">Et vilkår for at den ordinerte varen skal seponeres.</items>
                <items id="comment">For eksempel "Seponer når symptomer forsvinner".</items>
            </items>
            <items code="at0018">
                <items id="text">Klinisk indikasjon</items>
                <items id="description">Den kliniske begrunnelsen for bruk av den ordinerte varen.</items>
                <items id="comment">For eksempel "Angina". Koding av klinisk indikasjon med en terminologi foretrekkes, der det er mulig. Dette dataelementet kan repeteres. Elementet er ikke ment for administrativ autorisering.</items>
            </items>
            <items code="at0044">
                <items id="text">Tilleggsinstruksjon</items>
                <items id="description">Tilleggsinstruksjon for hvordan bruke eller lagre den ordinerte varen.</items>
                <items id="comment">For eksempel forholdsregler som "tas med mat", "unngå grapefrukt", "løses opp i vann" eller "oppbevares på et kjølig tørt sted". Dette dataelementet kan repeteres, og bør dersom mulig kodes med en terminologi, f.eks. FEST.</items>
            </items>
            <items code="at0047">
                <items id="text">Maskinlesbare anvisninger</items>
                <items id="description">En maskinlesbar tekstfremstilling av anvisningene.</items>
                <items id="comment">Brukes vanligvis ved deling av informasjon mellom eldre systemer.</items>
            </items>
            <items code="at0050">
                <items id="text">Del av ordinering allerede administrert</items>
                <items id="description">Tidsperioden individet/pasienten har brukt den ordinerte varen i forkant av denne instruksjonen.</items>
                <items id="comment">Eksempel: For å registrere at pasienten har tatt antibiotika i 3 dager av en 7-dagerskur før en sykehusinnleggelse.</items>
            </items>
            <items code="at0051">
                <items id="text">Maksimumsdose</items>
                <items id="description">Detaljer om den maksimale kumulative dosen av den ordinerte varen som er tillatt i en definert tidsperiode.</items>
                <items id="comment">For eksempel "maks 1 g per dag". Dette clusteret kan repeteres for å gjøre det mulig å registrere flere maksimumsdoser som gjelder forskjellige tidsperioder. Maksimumsdose for individets levetid registreres ikke har da det viser til flere ordineringer over tid.</items>
            </items>
            <items code="at0053">
                <items id="text">Tidsperiode</items>
                <items id="description">Tidsperioden maksimumsdosen er kalkulert for.</items>
                <items id="comment">Eksempel: 24 timer.</items>
            </items>
            <items code="at0060">
                <items id="text">Antall administreringer utført</items>
                <items id="description">Antall administreringer av den ordinerte varen som er utført som del av den planlagte ordineringen, men i forkant av denne instruksjonen.</items>
                <items id="comment">For eksempel for å registrere at pasienten har tatt de to første antibiotikatablettene av en 3 dagers kur, i forkant av utskrivelse fra sykehus til sykehjem.</items>
            </items>
            <items code="at0062">
                <items id="text">Legemiddelsikkerhet</items>
                <items id="description">Detaljer knyttet til sikkerhet rundt den ordinerte varen.</items>
            </items>
            <items code="at0064">
                <items id="text">Overstyring av sikkerhetsgrenser?</items>
                <items id="description">Bekreftelse fra forskriveren om at den maksimale dosen eller andre sikkerhetsgrenser er overstyrt på grunn av spesielle omstendigheter.</items>
            </items>
            <items code="at0065">
                <items id="text">Utdelingsmengde</items>
                <items id="description">Detaljer om mengden av den ordinerte varen som skal utdeles.</items>
                <items id="comment">Dette SLOTet tillater lokal variasjon i regelverk for legemiddelutdeling mellom forskjellige myndighetsområder.</items>
            </items>
            <items code="at0069">
                <items id="text">Autoriseringsveiledning</items>
                <items id="description">Detaljer om autoriseringen for den ordinerte varen, støtter også selvadministrering, utlevering og retningslinjer for godkjenning.</items>
                <items id="comment">For eksempel detaljer om reiterering. Dette SLOTet tillater lokale variasjoner mellom forskjellige myndighetsområder når det gjelder legemiddelautorisering og re-autorisering.</items>
            </items>
            <items code="at0070">
                <items id="text">Legemiddel</items>
                <items id="description">Navnet på legemiddelet, vaksinen eller det medisinske forbruksmateriellet som ordineres.</items>
                <items id="comment">Avhengig av kontekst kan dette elementet brukes enten for generisk eller varebasert ordinering. Dataelementet kan brukes til å registrere tett sammenbundne ordineringer av forskjellige legemidler når de ordineres som en pakke. Det anbefales sterkt at "Legemiddel" kodes med en terminologi som understøtter beslutningsstøtte der dette er mulig, f.eks. FEST. Nivå av koding kan variere fra legemiddelnavn til strukturerte detaljer om den aktuelle legemiddelforpakningen som skal brukes. Fritekst bør bare brukes om ingen passende terminologi er tilgjengelig.</items>
            </items>
            <items code="at0091">
                <items id="text">Administreringsvei</items>
                <items id="description">Administreringsveien for den ordinerte varen.</items>
                <items id="comment">For eksempel "oral bruk", "intravenøst", "på huden" eller "enteralt".&#13;
Det bør om mulig benyttes terminologi, f.eks. FEST, for å angi administreringsvei. Det kan spesifiseres flere mulige administreringsveier.</items>
            </items>
            <items code="at0092">
                <items id="text">Anatomisk lokalisering</items>
                <items id="description">Navn på kroppsstedet der den ordinerte varen skal administreres.</items>
                <items id="comment">For eksempel "venstre overarm", "intravenøst kateter høyre hånd". Det bør om mulig benyttes terminologi, f.eks. SNOMED CT eller EDQM standardtermer, for å angi kroppssted.</items>
            </items>
            <items code="at0093">
                <items id="text">Strukturert anatomisk lokalisering</items>
                <items id="description">Strukturert beskrivelse av administreringsstedet for den ordinerte varen.</items>
            </items>
            <items code="at0094">
                <items id="text">Administreringsmetode</items>
                <items id="description">Teknikken eller utstyret som brukes for å administrere den ordinerte varen.</items>
                <items id="comment">For eksempel "via Z-trackinjeksjon", "via forstøver". Koding av administreringsmetoden med en terminologi er anbefalt, der det er mulig.</items>
            </items>
            <items code="at0095">
                <items id="text">Administreringsutstyr</items>
                <items id="description">Detaljer om det medisinske utstyret som brukes til å administrere den ordinerte varen.</items>
            </items>
            <items code="at0105">
                <items id="text">Bruksområde</items>
                <items id="description">Tilleggsinstruksjon primært rettet mot pasient og pårørende.</items>
                <items id="comment">For eksempel "Blodtrykksreduserende", "Blodfortynnende". Dette dataelementet kan repeteres, og bør dersom mulig kodes med en terminologi, f.eks. FEST. Ved behov kan man bruke en lenke for å assosiere dette elementet med f.eks. den opprinnelige diagnosen i en Problemliste, men det bør likevel registreres tekst her for å sikre data for fremtiden, siden målet for lenken kan endre seg over tid.</items>
            </items>
            <items code="at0106">
                <items id="text">Utdelingsinstruksjon</items>
                <items id="description">Tilleggsinstruksjon primært rettet mot personen som deler ut den ordinerte varen.</items>
                <items id="comment">Eksempel: Detaljerte instruksjoner for stegvis utdeling av opiater.</items>
            </items>
            <items code="at0107">
                <items id="text">Overvåkningsinstruksjon</items>
                <items id="description">Tilleggsinstruksjon som gir råd om anbefalt eller nødvendig overvåkning ved bruk av den ordinerte varen.</items>
                <items id="comment">For eksempel "kontroller nyrefunksjon om 2 uker". Dette dataelementet kan repeteres.</items>
            </items>
            <items code="at0112">
                <items id="text">Sammendrag av ordineringen</items>
                <items id="description">Oppsummerende informasjon om bruk av den ordinerte varen, f.eks. nåværende status eller nøkkeldatoer, som regel brukt i andre sammenhenger enn resepter.</items>
                <items id="comment">Sammendrag av ordineringsinformasjon kan være påkrevd når man overfører legemiddelinformasjon mellom systemer eller representerer et FHIR "Medication statement". Eksempler: Som del av en henvisning, overføringsnotat, eller epikrise/utskrivingsrapport.</items>
            </items>
            <items code="at0113">
                <items id="text">Ordineringsdetaljer</items>
                <items id="description">Detaljer om hele legemiddelordineringen.</items>
            </items>
            <items code="at0129">
                <items id="text">Utdelingsanvisning</items>
                <items id="description">Veiledning for utdeling av den ordinerte varen.</items>
            </items>
            <items code="at0130">
                <items id="text">Maksimum legemiddelmengde</items>
                <items id="description">Den maksimale kumulative legemiddelmengden som bør administreres i perioden.</items>
                <items id="comment">For eksempel 1 ml, 1.5 mg, 0.125 g.</items>
            </items>
            <items code="at0132">
                <items id="text">Generisk bytte</items>
                <items id="description">Indikerer om generisk bytte med en bioekvivalent vare er tillatt.</items>
                <items id="comment">I mange myndighetsområder er generisk bytte av en ordinert vare mot en bioekvivalent vare fra en annen produsent tillatt. I andre områder er bytte forutsatt, og ordinerende kliniker må eksplisitt avslå bytte.</items>
            </items>
            <items code="at0139">
                <items id="text">Prioritet</items>
                <items id="description">En indikator for hastegraden den ordinerte varen bør utdeles under.</items>
                <items id="comment">For eksempel "Haster". Dette kan spesifiseres i en templat eller spesalisering etter lokale verdisett. Noen myndighetsområder tillater at resepter merkes med "Haster" for at de skal klargjøres fort hos apoteket.</items>
            </items>
            <items code="at0143">
                <items id="text">Legemiddeldetaljer</items>
                <items id="description">Strukturerte detaljer om det overordnede legemiddelet, blant annet styrke, form og substansene det består av.</items>
                <items id="comment">Bruk dette SLOTet til å spesifisere en detaljert beskrivelse av den ordinerte varen. For eksempel form, styrke, fortynningsmiddel eller blandinger av ingredienser.</items>
            </items>
            <items code="at0148">
                <items id="text">Terapeutisk hensikt</items>
                <items id="description">Overordnet terapeutisk hensikt med den ordinerte varen.</items>
                <items id="comment">For eksempel "smertelindring", "palliasjon", "lavdose profylakse", "rehydrering" eller "ernæringsinfusjon".</items>
            </items>
            <items code="at0150">
                <items id="text">Total daglig effektiv dose</items>
                <items id="description">Detaljer om den totale daglige mengden av den ordinerte varen som skal administreres.</items>
                <items id="comment">Den totale daglige effektive dosen er den forventede effektive dosen, og støtter i så måte titrering av en i utgangspunktet lav dose mot en terapeutisk dose over en tidsperiode. Dette er ikke i seg selv måldosen, men den effektive daglige dosen mot måldosen. I noen sammenhenger kan den totale daglige dosen kalkuleres fra maskinlesbare anvisninger, mens den i andre må legges inn manuelt.</items>
            </items>
            <items code="at0151">
                <items id="text">Total daglig dosemengde</items>
                <items id="description">Mengden ordinert vare som skal tas per dag dersom det administreres som ordinert.</items>
                <items id="comment">For eksempel "20 mg".</items>
            </items>
            <items code="at0154">
                <items id="text">Begrunnelse for byttereservasjon</items>
                <items id="description">Begrunnelsen for beslutningen om at generisk bytte av den ordinerte varen ikke tillates.</items>
                <items id="comment">For eksempel "Generisk vare er ikke bioekvivalent".</items>
            </items>
            <items code="at0155">
                <items id="text">Startdato utlevering</items>
                <items id="description">Datoen den ordinerte varen kan utdeles for første gang.</items>
                <items id="comment">Kan brukes til å kontrollere utdelingstidspunkt for varer med misbrukspotensiale, f.eks. benzodiazepiner og sterke smertestillende.</items>
            </items>
            <items code="at0161">
                <items id="text">Utløpsdato utdeling</items>
                <items id="description">Dato da ordineringen ikke lenger er gyldig for utdeling.</items>
                <items id="comment">I noen myndighetsområder kan utleveringsanmodninger ha en utløpsdato, og etter denne datoen kan resepten ikke lenger utleveres.</items>
            </items>
            <items code="at0162">
                <items id="text">Årsak til overstyring</items>
                <items id="description">Begrunnelsen for hvorfor sikkerhetsgrensen eller maksimumsdosen er overstyrt.</items>
                <items id="comment">For eksempel "Ingen effekt ved maksimum anbefalte dose. Kritisk situasjon.". "Pencillin er den eneste mulige behandlingen, sannsynlighet for faktisk pencillinallergi er lav".</items>
            </items>
            <items code="at0165">
                <items id="text">Formål</items>
                <items id="description">Begrunnelsen for at det registreres en total daglig effektiv dose.</items>
                <items id="comment">For eksempel "Kontrollere hypertensjon", "Måldose 20 mg daglig". Beskrivelsen kan brukes for å oppgi et navn, en frase eller en setning om formålet med å registrere en total daglig effektiv dose, som regel for å muliggjøre titrering mot en spesifikk måldose. Måldosen kan registreres her, eller mer vanlig i en EVALUATION.goal-arketype som det lenkes til.</items>
            </items>
            <items code="at0166">
                <items id="text">Tilleggsinformasjon</items>
                <items id="description">Ytterligere strukturerte detaljer om den ordinerte varen som ikke omfattes av andre felt.</items>
            </items>
            <items code="at0167">
                <items id="text">Kommentar</items>
                <items id="description">Ytterligere fritekst om legemiddelordineringen som ikke er fanget i andre felt.</items>
            </items>
            <items code="at0168">
                <items id="text">Tillatt</items>
                <items id="description">Generisk bytte med bioekvivalent legemiddel er tillatt.</items>
            </items>
            <items code="at0169">
                <items id="text">Ikke tillatt</items>
                <items id="description">Generisk bytte med bioekvivalent legemiddel er ikke tillatt.</items>
            </items>
            <items code="at0170">
                <items id="text">Utdelingsdetaljer</items>
                <items id="description">Ytterligere detaljer relatert til utdelingsanvisningene.</items>
                <items id="comment">Dette SLOTet tillater lokal variasjon i regelverk for legemiddelutdeling mellom forskjellige myndighetsområder.</items>
            </items>
            <items code="at0171">
                <items id="text">Overstyrt sikkerhetsanbefaling</items>
                <items id="description">Et kjent problem relatert til legemiddelsikkerhet for dette individet og den ordinerte varen, f.eks. allergi, advarsel om legemiddelduplisering, eller kontraindikasjon. Registreres ordinært bare dersom anbefalingen overstyres.</items>
                <items id="comment">For eksempel "allergisk mot penicillin" eller "atenolol duplisert".</items>
            </items>
            <items code="at0173">
                <items id="text">Spesifikk anvisningsbeskrivelse</items>
                <items id="description">Fritekstbeskrivelse av en spesifikk del av den overordnede anvisningen.</items>
                <items id="comment">I noen sammenhenger er det vanlig å dele den samlede fritekstbeskrivelsen av anvisningen inn i mer spesifikke segmenter. For eksempel kan det i sykehus være vanlig å dele de samlede anvisningene opp i "Mengde" og "Administreringstidspunkt", selv om begge er i fritekst. Segmentnavnene kan legges til i et templat eller i applikasjonen.</items>
            </items>
            <items code="at0174">
                <items id="text">Begrunnelse for dose</items>
                <items id="description">Begrunnelsen for hvorfor en spesifikk dose er valgt, der dette er avhengig av en ytre faktor.</items>
                <items id="comment">For eksempel: "Justert pga amputasjon".</items>
            </items>
            <items code="at0177">
                <items id="text">Strukturerte anvisninger om dose og timing</items>
                <items id="description">Detaljerte og strukturerte anvisninger om dose og timing.</items>
                <items id="comment">Dette SLOTet er designet for å brukes med arketypen CLUSTER.therapeutic_direction for å tilrettelegge for å registrere et komplekst sett av anvisninger om dosering og timing. Det er mulig å bruke andre CLUSTER-arketyper i SLOTet, men det anbefales på det sterkeste å kun gjøre dette der det ikke er en prioritet å kunne gjøre forutsigbare spørringer på dataene.</items>
            </items>
            <items code="at0178">
                <items id="text">Sikkerhetsoverstyring</items>
                <items id="description">Overstyring av et kjent problem relatert til legemiddelsikkerhet for dette individet og den ordinerte varen, f.eks. allergi, advarsel om legemiddelduplisering, eller kontraindikasjon.</items>
            </items>
            <items code="at0179">
                <items id="text">Klinikerveiledning</items>
                <items id="description">Råd til personer som i fremtiden ordinerer eller deler ut legemiddelet, om den langvarige ordineringen.</items>
                <items id="comment">For eksempel "ikke tillat generisk bytte" eller råd om å bruke et spesifikt merke for å unngå hjelpestoffer som forårsaker reaksjoner.</items>
            </items>
        </term_definitions>
    </component_ontologies>
    <component_ontologies archetype_id="openEHR-EHR-OBSERVATION.pulse.v2">
        <term_definitions language="pt-br">
            <items code="at0000">
                <items id="text">Pulso/Batimento Cardíaco</items>
                <items id="description">*The rate and associated attributes for a pulse or heart beat. (en)</items>
            </items>
            <items code="at0001">
                <items id="text">structure</items>
                <items id="description">@ internal @</items>
            </items>
            <items code="at0002">
                <items id="text">history</items>
                <items id="description">@ internal @</items>
            </items>
            <items code="at0003">
                <items id="text">Algum evento</items>
                <items id="description">Predefinido, ponto não especificado ou evento de intervalo que pode ser explicitamente definido em um modelo ou em tempo de execução.</items>
            </items>
            <items code="at0004">
                <items id="text">Frequência</items>
                <items id="description">*The rate of the pulse or heart beat, measured in beats per minute. (en)</items>
            </items>
            <items code="at0005">
                <items id="text">Regular?</items>
                <items id="description">O pulso ou frequência cardíaca é regular?</items>
            </items>
            <items code="at0006">
                <items id="text">Regular</items>
                <items id="description">O padrão é regular.</items>
            </items>
            <items code="at0007">
                <items id="text">Irregular regularmente</items>
                <items id="description">O padrão é irregular em um padrão regular. Por exemplo: a cada "n" batimentos existe uma irregularidade.</items>
            </items>
            <items code="at0008">
                <items id="text">Irregular irregularmente</items>
                <items id="description">O padrão é irregular de forma caótica e imprevisível. Por exemplo, fibrilação atrial.</items>
            </items>
            <items code="at0010">
                <items id="text">List</items>
                <items id="description">@ internal @</items>
            </items>
            <items code="at0012">
                <items id="text">List</items>
                <items id="description">@ internal @</items>
            </items>
            <items code="at0013">
                <items id="text">Posição</items>
                <items id="description">A posição do corpo do sujeito da atenção durante a observação.</items>
            </items>
            <items code="at1000">
                <items id="text">Deitado</items>
                <items id="description">O sujeito estava deitado.</items>
            </items>
            <items code="at1001">
                <items id="text">Sentado</items>
                <items id="description">O sujeito estava sentado (por exemplo, na cama ou cadeira)</items>
            </items>
            <items code="at1002">
                <items id="text">Reclinado</items>
                <items id="description">O sujeito estava reclinado em um ângulo aproximado de 45°, com as pernas elevadas ao nível da pelve.</items>
            </items>
            <items code="at1003">
                <items id="text">Em pé</items>
                <items id="description">O sujeito estava em pé, andando ou correndo.</items>
            </items>
            <items code="at1005">
                <items id="text">Presença</items>
                <items id="description">Presença de pulso ou batimento cardíaco.</items>
                <items id="comment">*It can be implied that the pulse or heart beat is present if Rate &gt;0 /min. (en)</items>
            </items>
            <items code="at1013">
                <items id="text">Dispositivo</items>
                <items id="description">Detalhes sobre o dispositivo usado para mensurar a frequência do pulso ou frequência cardíaca.</items>
            </items>
            <items code="at1017">
                <items id="text">Esforço</items>
                <items id="description">Detalhes sobre o esforço físico que está sendo realizado durante o exame.</items>
            </items>
            <items code="at1018">
                <items id="text">Fatores de confusão</items>
                <items id="description">Descrição narrativa sobre quaisquer fatores incidentais que possam afetar a interpretação dos achados físicos.</items>
                <items id="comment">Por exemplo, presença de marcapasso, nível de ansiedade, dor ou febre, etc.</items>
            </items>
            <items code="at1019">
                <items id="text">Método</items>
                <items id="description">Método utilizado para observar o pulso ou frequência cardíaca.</items>
                <items id="comment">Por exemplo, ausculta ou monitorização eletrônica.</items>
            </items>
            <items code="at1022">
                <items id="text">Descrição clínica</items>
                <items id="description">Narrativa da descrição sobre o pulso ou batimento cardíaco.</items>
            </items>
            <items code="at1023">
                <items id="text">Interpretação clínica</items>
                <items id="description">Palavra única, frase ou breve descrição que representa o significado clínico e significância do pulso ou batimento cardíaco, incluindo o ritmo.</items>
                <items id="comment">A codificação com uma terminologia é preferida, quando possível. Por exemplo: bradicardia, extrassístoles ou ritmo sinusal. São permitidas várias afirmações.</items>
            </items>
            <items code="at1024">
                <items id="text">Presente</items>
                <items id="description">Um pulso ou batimento cardíaco podem ser detectados.</items>
            </items>
            <items code="at1025">
                <items id="text">Não detectado</items>
                <items id="description">Um pulso ou batimento cardíaco não podem ser detectados.</items>
            </items>
            <items code="at1028">
                <items id="text">Irregular</items>
                <items id="description">O padrão é irregular.</items>
            </items>
            <items code="at1030">
                <items id="text">Característica</items>
                <items id="description">Descrição da característica do pulso ou batimento cardíaco.</items>
                <items id="comment">A codificação com uma terminologia é desejada, quando possível. Por exemplo: cheio, filiforme, delimitado, aumento lento ou em colapso. Múltiplos termos podem ser registrados.</items>
            </items>
            <items code="at1032">
                <items id="text">Palpação</items>
                <items id="description">Os resultados são observados pelo toque físico no sujeito do cuidado pelo observador.</items>
            </items>
            <items code="at1033">
                <items id="text">Ausculta</items>
                <items id="description">Os resultados são observados com a ajuda de um dispositivo, como um estetoscópio.</items>
            </items>
            <items code="at1034">
                <items id="text">Automática, não invasiva</items>
                <items id="description">Os resultados são observados de forma não invasiva utilizando um dispositivo como um oxímetro de pulso ou um estetoscópio.</items>
            </items>
            <items code="at1036">
                <items id="text">Máximo</items>
                <items id="description">Frequência de pulso ou frequência cardíaca máximos observados durante o período de esforço.</items>
            </items>
            <items code="at1037">
                <items id="text">Local do corpo</items>
                <items id="description">Local do corpo onde o pulso ou batimento cardíaco foram observados.</items>
            </items>
            <items code="at1038">
                <items id="text">Artéria Radial - Esquerda</items>
                <items id="description">A artéria radial esquerda.</items>
            </items>
            <items code="at1039">
                <items id="text">Artéria Radial Direita</items>
                <items id="description">A artéria radial direita.</items>
            </items>
            <items code="at1040">
                <items id="text">Coração</items>
                <items id="description">A região do coração.</items>
            </items>
            <items code="at1041">
                <items id="text">Artéria Carótida Esquerda</items>
                <items id="description">A artéria carótida esquerda.</items>
            </items>
            <items code="at1042">
                <items id="text">Artéria Carótida Direita</items>
                <items id="description">A artéria carótida direita.</items>
            </items>
            <items code="at1043">
                <items id="text">Artéria Femural Esquerda</items>
                <items id="description">A artéria femural esquerda.</items>
            </items>
            <items code="at1044">
                <items id="text">Artéria femural Direita</items>
                <items id="description">A artéria femural direita.</items>
            </items>
            <items code="at1047">
                <items id="text">Dedo</items>
                <items id="description">Um dedo inespecífico.</items>
            </items>
            <items code="at1048">
                <items id="text">Artéria Braquial Esquerda</items>
                <items id="description">A artéria braquial esquerda.</items>
            </items>
            <items code="at1049">
                <items id="text">Artéria Braquial Direita</items>
                <items id="description">A artéria braquial direita.</items>
            </items>
            <items code="at1050">
                <items id="text">Automática, invasiva</items>
                <items id="description">Os achados são observados de forma invasiva utilizando um dispositivo como um catéter arterial.</items>
            </items>
            <items code="at1051">
                <items id="text">Lobo da orelha</items>
                <items id="description">Um lobo da orelha inespecífico.</items>
            </items>
            <items code="at1054">
                <items id="text">Dedo do pé</items>
                <items id="description">Um dedo do pé inespecífico.</items>
            </items>
            <items code="at1055">
                <items id="text">Tipo irregular</items>
                <items id="description">Padrão mais específico de um pulso ou batimento cardíaco irregular.</items>
                <items id="comment">A seleção de um valor a partir deste conjunto de valores só é válida se 'Irregular' for selecionado a partir do elemento de dados 'Regularidade'.</items>
            </items>
            <items code="at1056">
                <items id="text">Extensão</items>
                <items id="description">Informações adicionais necessárias para capturar conteúdo local ou alinhar com outros modelos/formalismos de referência.</items>
                <items id="comment">Por exemplo: requisitos de informação local ou metadados adicionais para alinhar com equivalentes FHIR ou CIMI.</items>
            </items>
            <items code="at1057">
                <items id="text">Interpretação clínica</items>
                <items id="description">Etiqueta genérica para permitir qualquer ou todas as declarações sobre o pulso ou batimento cardíaco.</items>
            </items>
            <items code="at1058">
                <items id="text">Ritmo</items>
                <items id="description">Conclusão específica sobre o ritmo do pulso ou batimento cardíaco, extraído de uma combinação da freqüência cardíaca, padrão e outras características observadas no exame.</items>
            </items>
            <items code="at1059">
                <items id="text">Comentários</items>
                <items id="description">Narrativa adicional sobre o pulso ou batimento cardíaco achados não capturados em outros campos.</items>
            </items>
        </term_definitions>
        <term_definitions language="sv">
            <items code="at0000">
                <items id="text">Puls/Hjärtslag</items>
                <items id="description">Pulsen eller hjärtslagens frekvens och tillhörande attribut.</items>
            </items>
            <items code="at0001">
                <items id="text">structure</items>
                <items id="description">@ internal @</items>
            </items>
            <items code="at0002">
                <items id="text">history</items>
                <items id="description">@ internal @</items>
            </items>
            <items code="at0003">
                <items id="text">Ospecificerad händelse</items>
                <items id="description">Ospecificerad standardhändelse vid en tidpunkt eller inom ett tidsintervall som explicit kan definieras i en template eller genereras automatiskt av vissa IT-system.</items>
            </items>
            <items code="at0004">
                <items id="text">Frekvens</items>
                <items id="description">Frekvensen av pulsen eller hjärtslagen, mätt i slag per minut.</items>
            </items>
            <items code="at0005">
                <items id="text">Regelbundenhet</items>
                <items id="description">Regelbundenhet hos pulsen eller hjärtslagen.</items>
            </items>
            <items code="at0006">
                <items id="text">Regelbunden</items>
                <items id="description">Mönstret är regelbundet.</items>
            </items>
            <items code="at0007">
                <items id="text">Regelbundet oregelbunden</items>
                <items id="description">Mönstret är oregelbundet i ett regelbundet mönster, exempelvis ett överhoppat hjärtslag var N:te slag.</items>
            </items>
            <items code="at0008">
                <items id="text">Oregelbundet oregelbunden</items>
                <items id="description">Mönstret är oregelbundet på ett kaotiskt och oförutsägbart sätt, exempelvis förmaksflimmer.</items>
            </items>
            <items code="at0010">
                <items id="text">List</items>
                <items id="description">@ internal @</items>
            </items>
            <items code="at0012">
                <items id="text">List</items>
                <items id="description">@ internal @</items>
            </items>
            <items code="at0013">
                <items id="text">Kroppsställning</items>
                <items id="description">Individens kroppsställning under observationen.</items>
            </items>
            <items code="at1000">
                <items id="text">Liggande</items>
                <items id="description">Individen låg raklång.</items>
            </items>
            <items code="at1001">
                <items id="text">Sittande</items>
                <items id="description">Individen satt, exempelvis på en säng eller en stol.</items>
            </items>
            <items code="at1002">
                <items id="text">Halvliggande</items>
                <items id="description">Individen låg i ungefär 45 graders vinkel, med benen upphöjda till bäckennivå.</items>
            </items>
            <items code="at1003">
                <items id="text">Stående eller upprätt</items>
                <items id="description">Individen stod upprätt, gick eller sprang.</items>
            </items>
            <items code="at1005">
                <items id="text">Närvaro</items>
                <items id="description">Närvaro av puls eller hjärtslag.</items>
                <items id="comment">Det kan antas att puls eller hjärtslag är närvarande om frekvensen är &gt;0 /min.</items>
            </items>
            <items code="at1013">
                <items id="text">Utrustning</items>
                <items id="description">Information om den utrustning som använts för att mäta puls eller hjärtfrekvens.</items>
            </items>
            <items code="at1017">
                <items id="text">Ansträngning</items>
                <items id="description">Uppgifter om fysisk ansträngning under undersökningen.</items>
            </items>
            <items code="at1018">
                <items id="text">Möjliga felkällor</items>
                <items id="description">Beskrivning av faktorer som kan påverka tolkningen av de fysiska fynden.</items>
                <items id="comment">Exempelvis närvaro av pacemaker, grad av oro, smärta eller feber.</items>
            </items>
            <items code="at1019">
                <items id="text">Metod</items>
                <items id="description">Metod som användes för att observera pulsen eller hjärtslagen.</items>
                <items id="comment">Exempelvis auskultation eller elektronisk övervakning.</items>
            </items>
            <items code="at1022">
                <items id="text">Klinisk beskrivning</items>
                <items id="description">Beskrivning av pulsen eller hjärtslagen.</items>
            </items>
            <items code="at1023">
                <items id="text">Klinisk tolkning</items>
                <items id="description">Enstaka ord, fras eller kort beskrivning om den kliniska innebörden och betydelsen av fynd från puls eller hjärtslag, inklusive rytm.</items>
                <items id="comment">Kodning med en terminologi är att föredra, om möjligt. Exempelvis takykardi, bradykardi, förmaksflimmer, prematura slag eller sinusrytm med extraslag. Flera utlåtanden är tillåtna.</items>
            </items>
            <items code="at1024">
                <items id="text">Närvaro</items>
                <items id="description">Puls eller hjärtslag kan detekteras.</items>
            </items>
            <items code="at1025">
                <items id="text">Frånvaro</items>
                <items id="description">Puls eller hjärtslag kan inte detekteras.</items>
            </items>
            <items code="at1028">
                <items id="text">Oregelbunden</items>
                <items id="description">Mönstret är oregelbundet.</items>
            </items>
            <items code="at1030">
                <items id="text">Karaktär</items>
                <items id="description">Beskrivning av pulsens eller hjärtslagets karaktär.</items>
                <items id="comment">Kodning med en terminologi är önskvärd, om möjligt. Exempelvis fyllig, svag, kraftig, långsamt stigande eller kollapsande. Flera termer kan registreras.</items>
            </items>
            <items code="at1032">
                <items id="text">Palpation</items>
                <items id="description">Fynden observeras genom fysisk beröring av individen.</items>
            </items>
            <items code="at1033">
                <items id="text">Auskultation</items>
                <items id="description">Fynden observeras med ett hjälpmedel, exempelvis ett stetoskop.</items>
            </items>
            <items code="at1034">
                <items id="text">Automatisk, icke-invasiv</items>
                <items id="description">Fynden observeras icke-invasivt med hjälp av utrustning såsom en pulsoximeter eller ett stetoskop.</items>
            </items>
            <items code="at1036">
                <items id="text">Maximum</items>
                <items id="description">Maxpuls eller maxfrekvens observerad under ansträngning.</items>
            </items>
            <items code="at1037">
                <items id="text">Kroppslokalisation</items>
                <items id="description">Lokalisation där pulsen eller hjärtslagen observerades.</items>
            </items>
            <items code="at1038">
                <items id="text">Radialisartär - Vänster</items>
                <items id="description">Vänstra radialisartären.</items>
            </items>
            <items code="at1039">
                <items id="text">Radialisartär - Höger</items>
                <items id="description">Högra radialisartären.</items>
            </items>
            <items code="at1040">
                <items id="text">Hjärta</items>
                <items id="description">Hjärtområdet.</items>
            </items>
            <items code="at1041">
                <items id="text">Carotisartär – Vänster</items>
                <items id="description">Vänstra carotisartären.</items>
            </items>
            <items code="at1042">
                <items id="text">Carotisartär - Höger</items>
                <items id="description">Högra carotisartären.</items>
            </items>
            <items code="at1043">
                <items id="text">Femoralartär - Vänster</items>
                <items id="description">Vänstra femoralartären.</items>
            </items>
            <items code="at1044">
                <items id="text">Femoralartär - Höger</items>
                <items id="description">Högra femoralartären.</items>
            </items>
            <items code="at1047">
                <items id="text">Finger</items>
                <items id="description">Ospecificerat finger.</items>
            </items>
            <items code="at1048">
                <items id="text">Brachialartär - Vänster</items>
                <items id="description">Vänstra brachialartären.</items>
            </items>
            <items code="at1049">
                <items id="text">Brachialartär - Höger</items>
                <items id="description">Högra brachialartären.</items>
            </items>
            <items code="at1050">
                <items id="text">Automatisk, invasiv</items>
                <items id="description">Fynden observeras invasivt med hjälp av utrustning såsom en arteriell kateter.</items>
            </items>
            <items code="at1051">
                <items id="text">Öronlob</items>
                <items id="description">Loben på ospecificerat öra.</items>
            </items>
            <items code="at1054">
                <items id="text">Tå</items>
                <items id="description">Ospecificerad tå.</items>
            </items>
            <items code="at1055">
                <items id="text">Typ av oregelbundenhet</items>
                <items id="description">Ett mer specifikt mönster av oregelbunden puls eller oregelbundna hjärtslag.</items>
                <items id="comment">Ett val från den här värdemängden är endast giltigt om "oregelbunden" väljs från komponenten "regelbunden".</items>
            </items>
            <items code="at1056">
                <items id="text">Tilläggsinformation</items>
                <items id="description">Plats för tilläggsinformation som krävs för lokala anpassningar eller anpassning till andra referensmodeller eller formella krav.</items>
                <items id="comment">Exempelvis lokala informationskrav eller metadata för anpassning till FHIR.</items>
            </items>
            <items code="at1057">
                <items id="text">Klinisk tolkning</items>
                <items id="description">Allmänt datafält för ett enskilt eller samtliga utlåtanden om pulsen eller hjärtrytmen.</items>
            </items>
            <items code="at1058">
                <items id="text">Rytm</items>
                <items id="description">Specifik slutsats om pulsens eller hjärtslagens rytm, härledd från en kombination av hjärtfrekvens, mönster och andra egenskaper som observerats vid undersökningen.</items>
            </items>
            <items code="at1059">
                <items id="text">Kommentar</items>
                <items id="description">Ytterligare beskrivning av fynden från puls eller hjärtslag som inte beskrivits i andra fält.</items>
            </items>
        </term_definitions>
        <term_definitions language="de">
            <items code="at0000">
                <items id="text">Pulsfrequenz/Herzfrequenz</items>
                <items id="description">Die Frequenz und zugehörige Attribute für die Puls- oder Herzfrequenz.</items>
            </items>
            <items code="at0001">
                <items id="text">Structure</items>
                <items id="description">@ internal @</items>
            </items>
            <items code="at0002">
                <items id="text">History</items>
                <items id="description">@ internal @</items>
            </items>
            <items code="at0003">
                <items id="text">Jedes Ereignis</items>
                <items id="description">Ein Standardwert, ein spezifizierter Zeitpunkt oder ein Intervallereignis, welches explizit in einem Template oder während der Laufzeit definiert werden kann.</items>
            </items>
            <items code="at0004">
                <items id="text">Frequenz</items>
                <items id="description">Die Frequenz, gemessen in Schlägen pro Minute.</items>
            </items>
            <items code="at0005">
                <items id="text">Regelmäßigkeit</items>
                <items id="description">Regelmäßigkeit der Puls-/Herzfrequenz.</items>
            </items>
            <items code="at0006">
                <items id="text">Regelmäßig</items>
                <items id="description">Der Verlauf ist regelmäßig.</items>
            </items>
            <items code="at0007">
                <items id="text">Normal unregelmäßig</items>
                <items id="description">Der Verlauf ist unregelmäßig, aber in einem regelmäßigen Muster. Zum Beispiel das Ausfallen eines Schlages alle "n" Schläge.</items>
            </items>
            <items code="at0008">
                <items id="text">Ungleichmäßig unregelmäßig</items>
                <items id="description">Der Verlauf ist auf chaotische und unvorhersehbare Weise unregelmäßig. Zum Beispiel: Vorhofflimmern.</items>
            </items>
            <items code="at0010">
                <items id="text">List</items>
                <items id="description">@ internal @</items>
            </items>
            <items code="at0012">
                <items id="text">List</items>
                <items id="description">@ internal @</items>
            </items>
            <items code="at0013">
                <items id="text">Körperhaltung</items>
                <items id="description">Die Körperhaltung des Patienten während der Untersuchung.</items>
            </items>
            <items code="at1000">
                <items id="text">Liegend</items>
                <items id="description">Der Patient lag flach.</items>
            </items>
            <items code="at1001">
                <items id="text">Sitzend</items>
                <items id="description">Der Patient saß (zum Beispiel auf einem Bett oder einem Stuhl).</items>
            </items>
            <items code="at1002">
                <items id="text">Zurücklehnend</items>
                <items id="description">Der Patient saß zurück gelehnt in einem Winkel von 45 Grad und seine Beine waren bis zur Höhe des Beckens angehoben.</items>
            </items>
            <items code="at1003">
                <items id="text">Stehend/Aufrecht</items>
                <items id="description">Der Patient stand, ging oder rannte.</items>
            </items>
            <items code="at1005">
                <items id="text">Vorhandensein</items>
                <items id="description">Vorhandensein einer Puls- oder Herzfrequenz.</items>
                <items id="comment">Eine Puls-/Herzfrequenz ist vorhanden, wenn die Frequenz &gt; 0 Schläge pro Minute ist.</items>
            </items>
            <items code="at1013">
                <items id="text">Gerät</items>
                <items id="description">Informationen zu dem Gerät, welches zur Messung der Puls- oder der Herzfrequenz verwendet wurde.</items>
            </items>
            <items code="at1017">
                <items id="text">Anstrengung</items>
                <items id="description">Details über die körperliche Anstrengung, die der Patient während der Untersuchung ausgesetzt war.</items>
            </items>
            <items code="at1018">
                <items id="text">Störfaktoren</items>
                <items id="description">Die Beschreibung aller zufälligen Faktoren, die die Interpretation der physikalischen Ergebnisse beeinflussen können.</items>
                <items id="comment">Zum Beispiel das Vorhandensein eines Herzschrittmacher; das Angstniveau; Schmerzen oder Fieber etc.</items>
            </items>
            <items code="at1019">
                <items id="text">Methode</items>
                <items id="description">Die Methode, mit der die Puls- oder Herzfrequenz gemessen wurde.</items>
                <items id="comment">Zum Beispiel auskultatorisch oder über elektronisches Monitoring, z.B. mit einem Blutdruckmessgerät.</items>
            </items>
            <items code="at1022">
                <items id="text">Klinische Beschreibung</items>
                <items id="description">Beschreibung der Puls- oder Herzfrequenz.</items>
            </items>
            <items code="at1023">
                <items id="text">Klinische Interpretation</items>
                <items id="description">Ein einzelnes Wort, ein Satz oder eine kurze Beschreibung, welches die klinische Bedeutung und die Signifikanz der Puls- oder der Herzfrequenz, einschließlich des Rhythmus, darstellt.</items>
                <items id="comment">Die Kodierung mit einer Terminologie wird, wenn möglich, bevorzugt. Zum Beispiel: Bradykardie, Extrasystolen oder Sinusrhythmus. Mehrere Aussagen sind erlaubt.</items>
            </items>
            <items code="at1024">
                <items id="text">Vorhanden</items>
                <items id="description">Eine Puls- oder eine Herzfrequenz kann ermittelt werden.</items>
            </items>
            <items code="at1025">
                <items id="text">Nicht ermittelbar</items>
                <items id="description">Eine Puls- oder eine Herzfrequenz kann nicht ermittelt werden.</items>
            </items>
            <items code="at1028">
                <items id="text">Unregelmäßig</items>
                <items id="description">Der Verlauf ist unregelmäßig.</items>
            </items>
            <items code="at1030">
                <items id="text">Merkmal</items>
                <items id="description">Beschreibung des Merkmals der Puls- oder Herzfrequenz.</items>
                <items id="comment">Die Kodierung mit einer Terminologie ist, wenn möglich, erwünscht. Zum Beispiel: kräftig, schwach, hämmernd, langsam ansteigend oder kollabierend. Mehrere Begriffe können dokumentiert werden.</items>
            </items>
            <items code="at1032">
                <items id="text">Palpation</items>
                <items id="description">Der Befund wurde durch physisches Tasten des Beobachters am Patienten erlangt.</items>
            </items>
            <items code="at1033">
                <items id="text">Auskultation</items>
                <items id="description">Die Untersuchungsergebnisse werden mit Hilfe eines Gerätes, wie zum Beispiel einem Stethoskop, gemessen.</items>
            </items>
            <items code="at1034">
                <items id="text">Automatisch, nicht-invasiv</items>
                <items id="description">Die Untersuchungsergebnisse werden nicht-invasiv unter Anwendung eines Gerätes, wie zum Beispiel mit Hilfe eines Pulsoximeters oder eines Stethoskops, gemessen.</items>
            </items>
            <items code="at1036">
                <items id="text">Maximum</items>
                <items id="description">Die maximale Puls- oder Herzfrequenz, die während einer Belastungsperiode gemessen wurde.</items>
            </items>
            <items code="at1037">
                <items id="text">Körperstelle</items>
                <items id="description">Die Körperstelle an der die Puls- oder die Herzfrequenz gemessen wird.</items>
            </items>
            <items code="at1038">
                <items id="text">Arteria radialis - links</items>
                <items id="description">Die linke Arteria radialis.</items>
            </items>
            <items code="at1039">
                <items id="text">Arteria radialis - rechts</items>
                <items id="description">Die rechte Arteria radialis.</items>
            </items>
            <items code="at1040">
                <items id="text">Herz</items>
                <items id="description">Die Region des Herzens.</items>
            </items>
            <items code="at1041">
                <items id="text">Arteria carotis - links</items>
                <items id="description">Die linke Arteria carotis.</items>
            </items>
            <items code="at1042">
                <items id="text">Arteria carotis - rechts</items>
                <items id="description">Die rechte Arteria carotis.</items>
            </items>
            <items code="at1043">
                <items id="text">Arteria femoralis - links</items>
                <items id="description">Die linke Arteria femoralis.</items>
            </items>
            <items code="at1044">
                <items id="text">Arteria femoralis - rechts</items>
                <items id="description">Die rechts Arteria femoralis.</items>
            </items>
            <items code="at1047">
                <items id="text">Finger</items>
                <items id="description">Ein nicht näher beschriebener Finger.</items>
            </items>
            <items code="at1048">
                <items id="text">Arteria brachialis - links</items>
                <items id="description">Die linke Arteria brachialis.</items>
            </items>
            <items code="at1049">
                <items id="text">Arteria brachialis - rechts</items>
                <items id="description">Die rechte Arteria brachialis.</items>
            </items>
            <items code="at1050">
                <items id="text">Automatisch, invasiv</items>
                <items id="description">Die Untersuchungsergebnisse werden invasiv durch die Verwendung eines Gerätes, wie zum Beispiel eines arteriellen Katheters, gemessen.</items>
            </items>
            <items code="at1051">
                <items id="text">Ohrläppchen</items>
                <items id="description">Das Ohrläppchen eines unbestimmten Ohres.</items>
            </items>
            <items code="at1054">
                <items id="text">Zeh</items>
                <items id="description">Ein nicht näher beschriebener Zeh.</items>
            </items>
            <items code="at1055">
                <items id="text">Unregelmäßiger Typ</items>
                <items id="description">Ein spezifischeres Verlaufsmuster einer unregelmäßigen Puls- oder Herzfrequenz.</items>
                <items id="comment">Die Auswahl eines Wertes dieser Wertemenge ist nur valide, wenn "Unregelmäßig" vom Datenelement "Regelmäßigkeit" angegeben wurde.</items>
            </items>
            <items code="at1056">
                <items id="text">Erweiterung</items>
                <items id="description">Zusätzliche Informationen zur Erfassung lokaler Inhalte oder Anpassung an andere Referenzmodelle/Formalismen.</items>
                <items id="comment">Zum Beispiel: Lokaler Informationsbedarf oder zusätzliche Metadaten zur Anpassung an FHIR-Ressourcen oder CIMI-Modelle.</items>
            </items>
            <items code="at1057">
                <items id="text">Klinische Interpretation</items>
                <items id="description">Eine allgemeine Bezeichnung, um alle oder einen Teil der Aussagen über die Puls- oder die Herzfrequenz zu ermöglichen.</items>
            </items>
            <items code="at1058">
                <items id="text">Rhythmus</items>
                <items id="description">Spezifische Schlussfolgerung über den Rhythmus der Puls- oder der Herzfrequenz, die sich aus einer Kombination von Herzfrequenz, dem Verlaufsmuster und anderen bei der Untersuchung beobachteten Merkmalen ergibt.</items>
            </items>
            <items code="at1059">
                <items id="text">Kommentar</items>
                <items id="description">Zusätzliche Informationen über die Puls- oder die Herzfrequenz, die in anderen Bereichen nicht erfasst wurden.</items>
            </items>
        </term_definitions>
        <term_definitions language="nb">
            <items code="at0000">
                <items id="text">Puls/Hjertefrekvens</items>
                <items id="description">Måling av puls/hjertefrekvens, eller eksplisitt puls eller hjertefrekvens, og beskrivelse av tilhørende egenskaper.</items>
            </items>
            <items code="at0001">
                <items id="text">structure</items>
                <items id="description">@ internal @</items>
            </items>
            <items code="at0002">
                <items id="text">history</items>
                <items id="description">@ internal @</items>
            </items>
            <items code="at0003">
                <items id="text">Uspesifisert hendelse</items>
                <items id="description">Standard, uspesifisert tidspunkt eller tidsintervall som kan defineres mer eksplisitt i en template eller i en applikasjon.</items>
            </items>
            <items code="at0004">
                <items id="text">Frekvens</items>
                <items id="description">Puls- eller hjertefrekvens, målt i støt/slag per minutt.</items>
                <items id="comment">Det er spesifisert begrensninger i navn for å gjøre det lettere å eksplisitt merke dette elementet som Pulsfrekvens eller Hjertefrekvens ved behov.</items>
            </items>
            <items code="at0005">
                <items id="text">Rytme</items>
                <items id="description">Observert regularitet av puls- eller hjerteslag.</items>
            </items>
            <items code="at0006">
                <items id="text">Regelmessig</items>
                <items id="description">Rytmen er regelmessig.</items>
            </items>
            <items code="at0007">
                <items id="text">Regelmessig uregelmessig</items>
                <items id="description">Rytmen er uregelmessig på en regelmessig måte.</items>
            </items>
            <items code="at0008">
                <items id="text">Uregelemessig uregelmessig</items>
                <items id="description">Mønsteret er uregelmessig på en kaotisk og ikkeforutsigbar måte. For eksempel, atrieflimmer.</items>
            </items>
            <items code="at0010">
                <items id="text">List</items>
                <items id="description">@ internal @</items>
            </items>
            <items code="at0012">
                <items id="text">List</items>
                <items id="description">@ internal @</items>
            </items>
            <items code="at0013">
                <items id="text">Stilling</items>
                <items id="description">Individets stilling ved tidspunktet for målingen.</items>
            </items>
            <items code="at1000">
                <items id="text">Liggende</items>
                <items id="description">Liggende flatt ved tidspunkt for målingen.</items>
            </items>
            <items code="at1001">
                <items id="text">Sittende</items>
                <items id="description">Sittende (for eksempel på en stol eller på en seng med føttene på gulvet) ved tidspunktet for målingen.</items>
            </items>
            <items code="at1002">
                <items id="text">Tilbakelent</items>
                <items id="description">Sittende tilbakelent ca 45º og med beina hevet til hoftehøyde ved tidspunkt for målingen.</items>
            </items>
            <items code="at1003">
                <items id="text">Stående</items>
                <items id="description">Stående, gående eller løpende ved tidspunktet for målingen.</items>
            </items>
            <items code="at1005">
                <items id="text">Tilstedeværelse</items>
                <items id="description">Tilstedeværelse av puls eller hjerteslag.</items>
                <items id="comment">Det er spesifisert begrensninger i navn for å gjøre det lettere å eksplisitt merke dette elementet som tilstedeværelse av Puls eller Hjertefrekvens ved behov.</items>
            </items>
            <items code="at1013">
                <items id="text">Måleapparat</items>
                <items id="description">Detaljer om måleapparatet brukt for å observere pulsen eller hjerteslagene.</items>
            </items>
            <items code="at1017">
                <items id="text">Fysisk anstrengelse</items>
                <items id="description">Detaljer om fysisk aktivitet på tidspunkt for målingen.</items>
            </items>
            <items code="at1018">
                <items id="text">Konfunderende faktorer</items>
                <items id="description">Tekstlig beskrivelse av eventuelle andre faktorer som kan påvirke tolkningen av funnene.</items>
                <items id="comment">Eksempel: pacemaker, nervøsitet, smerte, feber, gråt og annen uro, sedativa eller andre medikamenter.</items>
            </items>
            <items code="at1019">
                <items id="text">Målemetode</items>
                <items id="description">Metode brukt for å observere pulsen eller hjerteslagene.</items>
                <items id="comment">For eksempel palpasjon, auskultasjon eller elektronisk monitorering.</items>
            </items>
            <items code="at1022">
                <items id="text">Klinisk beskrivelse</items>
                <items id="description">Tekstlig beskrivelse av puls- eller hjerteslag.</items>
            </items>
            <items code="at1023">
                <items id="text">Klinisk tolkning</items>
                <items id="description">Kort beskrivelse av den kliniske betydningen av funnene.</items>
                <items id="comment">Koding med en terminologi er en fordel, hvis mulig. Eksempel: Bradykardi, ekstrasystoler, sinusrytme. Flere registreringer er tillatt.</items>
            </items>
            <items code="at1024">
                <items id="text">Tilstede</items>
                <items id="description">Puls eller hjerteslag finnes.</items>
            </items>
            <items code="at1025">
                <items id="text">Fraværende</items>
                <items id="description">Puls eller hjerteslag kan ikke finnes.</items>
            </items>
            <items code="at1028">
                <items id="text">Uregelmessig</items>
                <items id="description">Rytmen er uregelmessig.</items>
            </items>
            <items code="at1030">
                <items id="text">Karakter</items>
                <items id="description">Tekstlig beskrivelse av pulsens eller hjerteslag karakter.</items>
                <items id="comment">Koding med en terminologi er en fordel der det er mulig. Flere svar skal kunne registreres. Eksempler: Tydelig, svak, overfladisk.</items>
            </items>
            <items code="at1032">
                <items id="text">Palpasjon</items>
                <items id="description">Funnene observeres ved at observatøren med fingertuppene kjenner på pulsen eller hjerteslagene til individet.</items>
            </items>
            <items code="at1033">
                <items id="text">Auskultasjon</items>
                <items id="description">Funnene er observert ved hjelp av et hjelpemiddel som f.eks. et stetoskop.</items>
            </items>
            <items code="at1034">
                <items id="text">Automatisk, non-invasivt</items>
                <items id="description">Funnene er observert non-invasivt ved hjelp av en maskin, som f.eks. et pulsoksimeter eller et skop.</items>
            </items>
            <items code="at1036">
                <items id="text">Maksimum</items>
                <items id="description">Maksimumsfrekvens observert i løpet av et intervall med anstrengelse.</items>
            </items>
            <items code="at1037">
                <items id="text">Målested</items>
                <items id="description">Anatomisk sted hvor pulsen eller hjerteslagene ble observert.</items>
            </items>
            <items code="at1038">
                <items id="text">Radialisarterien, venstre</items>
                <items id="description">Den venstre radialisarterien.</items>
            </items>
            <items code="at1039">
                <items id="text">Radialisarterien, høyre</items>
                <items id="description">Den høyre radialisarterien.</items>
            </items>
            <items code="at1040">
                <items id="text">Hjertet</items>
                <items id="description">Hjerteregionen.</items>
            </items>
            <items code="at1041">
                <items id="text">Carotisarterien, venstre</items>
                <items id="description">Den venstre carotisarterien.</items>
            </items>
            <items code="at1042">
                <items id="text">Carotisarterien, høyre</items>
                <items id="description">Den høyre carotisarterien.</items>
            </items>
            <items code="at1043">
                <items id="text">Femoralisarterien, venstre</items>
                <items id="description">Den venstre femoralisarterien.</items>
            </items>
            <items code="at1044">
                <items id="text">Femoralisarterien, høyre</items>
                <items id="description">Den høyre femoralisarterien.</items>
            </items>
            <items code="at1047">
                <items id="text">Finger</items>
                <items id="description">En uspesifisert finger.</items>
            </items>
            <items code="at1048">
                <items id="text">Brachialisarterien, venstre</items>
                <items id="description">Den venstre brachialisarterien.</items>
            </items>
            <items code="at1049">
                <items id="text">Brachialisarterien, høyre</items>
                <items id="description">Den høyre brachialisarterien.</items>
            </items>
            <items code="at1050">
                <items id="text">Automatisk, invasivt</items>
                <items id="description">Funnene er observert invasivt ved hjelp av en maskin, som f.eks. et arteriekateter.</items>
            </items>
            <items code="at1051">
                <items id="text">Øreflipp</items>
                <items id="description">Øreflippen.</items>
            </items>
            <items code="at1054">
                <items id="text">Tå</items>
                <items id="description">En uspesifisert tå.</items>
            </items>
            <items code="at1055">
                <items id="text">Type uregelmessighet</items>
                <items id="description">Mer spesifikt mønster for en uregelmessig puls eller hjerteslag.</items>
                <items id="comment">Dette dataelementet er kun relevant dersom "Uregelmessig" er valgt fra dataelementet "Regelmessighet.</items>
            </items>
            <items code="at1056">
                <items id="text">Tilleggsinformasjon</items>
                <items id="description">Ytterligere informasjon som trengs for å kunne registrere lokalt definert innhold eller for å tilpasse til andre referansemodeller/formalismer.</items>
                <items id="comment">For eksempel lokale informasjonsbehov eller ytterligere metadata for å kunne tilpasse til tilsvarende konsepter i FHIR eller CIMI.</items>
            </items>
            <items code="at1057">
                <items id="text">Klinisk tolkning</items>
                <items id="description">Generisk elementnavn for å tillate øvrige eller alle utsagn om puls og hjerteslag.</items>
            </items>
            <items code="at1058">
                <items id="text">Rytme</items>
                <items id="description">Spesifik konklusjon om pulsrytme eller hjerteslag, hentet fra en kombinasjon av hjertefrekvens, mønster og andre karakteristika som observeres.</items>
            </items>
            <items code="at1059">
                <items id="text">Kommentar</items>
                <items id="description">Ytterligere fritekst om målingen som ikke er dekket av andre felt.</items>
            </items>
        </term_definitions>
    </component_ontologies>
    <component_ontologies archetype_id="openEHR-EHR-OBSERVATION.blood_pressure.v2">
        <term_definitions language="pt-br">
            <items code="at0000">
                <items id="text">Pressão Arterial</items>
                <items id="description">A medida local da pressão sanguínea arterial, a qual é uma substituta da pressão arterial na circulação arterial sistêmica. Mais comumente o uso do termo pressão arterial se refere à medida da pressão da artéria braquial no antebraço.</items>
                <items id="comment">*Most commonly, use of the term 'blood pressure' refers to measurement of brachial artery pressure in the upper arm.(en)</items>
            </items>
            <items code="at0001">
                <items id="text">história</items>
                <items id="description">nodo Estrutural história</items>
            </items>
            <items code="at0003">
                <items id="text">*blood pressure(en)</items>
                <items id="description">*@ internal @(en)</items>
            </items>
            <items code="at0004">
                <items id="text">Sistólica</items>
                <items id="description">Pressão arterial sistêmica máxima - medida na fase sistólica ou de contração do ciclo cardíaco.</items>
            </items>
            <items code="at0005">
                <items id="text">Diastólica</items>
                <items id="description">Pressão arterial sistêmica mínima - medida na fase diastólica ou de dilatação do ciclo cardíaco.</items>
            </items>
            <items code="at0006">
                <items id="text">Qualquer evento</items>
                <items id="description">Padrão, ponto especificado no tempo ou evento de intervalo que pode ser explicitamente definido em um modelo ou em tempo de execução.</items>
            </items>
            <items code="at0007">
                <items id="text">*state structure(en)</items>
                <items id="description">*@ internal @(en)</items>
            </items>
            <items code="at0008">
                <items id="text">Posição</items>
                <items id="description">A posição do sujeito na hora da medida.</items>
            </items>
            <items code="at0011">
                <items id="text">estrutura de lista</items>
                <items id="description">estrutura de lista</items>
            </items>
            <items code="at0013">
                <items id="text">Tamanho da braçadeira</items>
                <items id="description">Tamanho da braçadeira usada para medir a pressão arterial.</items>
                <items id="comment">Sem comentários</items>
            </items>
            <items code="at0014">
                <items id="text">Localização da medição</items>
                <items id="description">Local do corpo simples em que a pressão arterial foi medida.</items>
            </items>
            <items code="at0015">
                <items id="text">Coxa de adulto</items>
                <items id="description">Uma braçadeira usada na coxa de um aduto - manguito de aproximadamente 20cm x 42cm.</items>
            </items>
            <items code="at0016">
                <items id="text">Adulto Grande</items>
                <items id="description">Uma braçadeira para adultos com braço largo - manguito de aproximadamente 16cm x 38cm.</items>
            </items>
            <items code="at0017">
                <items id="text">Adulto</items>
                <items id="description">Uma braçadeira padrão para adultos - manguito de aproximadamente 13cm x 30cm.</items>
            </items>
            <items code="at0025">
                <items id="text">Braço direito</items>
                <items id="description">O braço direito da pessoa.</items>
            </items>
            <items code="at0026">
                <items id="text">Braço esquerdo</items>
                <items id="description">O braço esquerdo da pessoa.</items>
            </items>
            <items code="at0027">
                <items id="text">Coxa direita</items>
                <items id="description">A coxa direita da pessoa.</items>
            </items>
            <items code="at0028">
                <items id="text">Coxa esquerda</items>
                <items id="description">A coxa esquerda da pessoa.</items>
            </items>
            <items code="at0033">
                <items id="text">Comentário</items>
                <items id="description">Narrativa adicional sobre a medição, não capturada em outros campos.</items>
            </items>
            <items code="at1000">
                <items id="text">Em pé</items>
                <items id="description">Em pé na hora da medida da pressão arterial.</items>
            </items>
            <items code="at1001">
                <items id="text">Sentado</items>
                <items id="description">Sentado (por exemplo na cama ou em uma cadeira) na hora da medida da pressão arterial.</items>
            </items>
            <items code="at1002">
                <items id="text">Reclinado</items>
                <items id="description">Reclinado na hora da medida da pressão arterial.</items>
            </items>
            <items code="at1003">
                <items id="text">Deitado</items>
                <items id="description">Deitado sem reclinação hora da medida da pressão arterial.</items>
            </items>
            <items code="at1005">
                <items id="text">Inclinado</items>
                <items id="description">A inclinação craniocaudal da superfície na qual a pessoa está deitada no momento da medição.</items>
                <items id="comment">* ATENÇÃO: '°' é uma unidade UCUM válida. Por favor, use 'graus' como a unidade correta.</items>
            </items>
            <items code="at1006">
                <items id="text">Pressão arterial Média</items>
                <items id="description">A pressão arterial média que ocorrre ao longo de todo o ciclo de contração e dilatação do coração.</items>
            </items>
            <items code="at1007">
                <items id="text">Pressão de Pulso</items>
                <items id="description">A diferença entre a pressão sistólica e diastólica.</items>
            </items>
            <items code="at1008">
                <items id="text">Adulto pequeno</items>
                <items id="description">Uma braçadeira usada para adultos pequenos -manguito de aproximadamente 10cm x 24cm.</items>
            </items>
            <items code="at1009">
                <items id="text">Criança/Pediátrico</items>
                <items id="description">Manguito apropriao para uma criança ou um adulto com um braço fino - bolsa de aproximadamente 8cm x 21cm.</items>
            </items>
            <items code="at1010">
                <items id="text">Final da diástole</items>
                <items id="description">Registro do som Korotkoff usado para determinar a pressão arterial diastólica, usando o método auscultativo.</items>
            </items>
            <items code="at1011">
                <items id="text">Fhase IV.</items>
                <items id="description">O quarto som de Korotkoff é identificado como um súbito abafamento dos sons.</items>
            </items>
            <items code="at1012">
                <items id="text">Phase V</items>
                <items id="description">O quinto som de Korotkoff é identificado pela ausência de sons, pois a pressão da braçadeira cai abaixo da pressão diastólica do sangue.</items>
            </items>
            <items code="at1014">
                <items id="text">Deitado com inclinação para esquerda</items>
                <items id="description">Deitado sem reclinação com alguma inclinação lateral, usualmente com angulação para o lado esquerdo. Comumente requerido no último trimestre da gravidez para aliviar a compressão aortocaval.</items>
            </items>
            <items code="at1018">
                <items id="text">Criança pequena</items>
                <items id="description">Uma braçadeira utilizada em crianças pequenas - manguito de aproximadamente 5cm x 15cm.</items>
            </items>
            <items code="at1019">
                <items id="text">Neonatal</items>
                <items id="description">Uma braçadeira usada para um recém-nascido, supondo que o tamanho é apropriado para a maturidade e o peso ao nascer do neonato.</items>
            </items>
            <items code="at1020">
                <items id="text">Pulso direito</items>
                <items id="description">O pulso direito da pessoa.</items>
            </items>
            <items code="at1021">
                <items id="text">Pulso esquerdo</items>
                <items id="description">O pulso esquerdo da pessoa.</items>
            </items>
            <items code="at1025">
                <items id="text">Aparelho</items>
                <items id="description">Detalhes sobre o esfigmomanômetro ou outro aparelho utilizado para medir a pressão sanguínea.</items>
            </items>
            <items code="at1026">
                <items id="text">Tornozelo direito</items>
                <items id="description">O tornozelo direito da pessoa.</items>
            </items>
            <items code="at1030">
                <items id="text">Esforço físico</items>
                <items id="description">Detalhes sobre atividade física realizada na hora da medida da pressão arterial.</items>
            </items>
            <items code="at1031">
                <items id="text">Tornozelo esquerdo</items>
                <items id="description">O tornozelo esquerdo da pessoa.</items>
            </items>
            <items code="at1032">
                <items id="text">Dedo</items>
                <items id="description">Um dedo do indivíduo.</items>
            </items>
            <items code="at1035">
                <items id="text">Método</items>
                <items id="description">Método de medida da pressão arterial.</items>
            </items>
            <items code="at1036">
                <items id="text">Ausculta</items>
                <items id="description">Método de medir a pressão externamente, usando o estetoscópiso e os sons Korotkoff.</items>
            </items>
            <items code="at1037">
                <items id="text">Palpação</items>
                <items id="description">Método de medir a pressão arterial externamente, usando a palpação (geralmente artérias braquiais ou radiais).</items>
            </items>
            <items code="at1038">
                <items id="text">Fórmula de Pressão Arterial Média</items>
                <items id="description">Fórmula usada para calcular a pressão arterial média (PAM), se registrada em dados.</items>
            </items>
            <items code="at1039">
                <items id="text">Aparelho de pressão</items>
                <items id="description">Método de medir a pressão arterial externamente, usando o aparelho de pressão arterial.</items>
            </items>
            <items code="at1040">
                <items id="text">Invasivo</items>
                <items id="description">Método de medir a pressão arterial internamente, isto é, envolvendo a penetração da pele e a medida interior dos vasos sanguíneos.</items>
            </items>
            <items code="at1042">
                <items id="text">Media de 24 horas</items>
                <items id="description">Estimativa da pressão arterial média em um período de 24 horas.</items>
            </items>
            <items code="at1043">
                <items id="text">Status do sono</items>
                <items id="description">Status do sono - apóia a interpretação do registro do mapa de pressão arterial (ambulatorial de 24 horas).</items>
            </items>
            <items code="at1044">
                <items id="text">Alerta e acordado</items>
                <items id="description">Sujeito está totalmente consciente.</items>
            </items>
            <items code="at1045">
                <items id="text">Dormindo</items>
                <items id="description">Sujeito está no estado natural de descanso corporal.</items>
            </items>
            <items code="at1051">
                <items id="text">Dedo do pé</items>
                <items id="description">Um dedo do pé do indivíduo.</items>
            </items>
            <items code="at1052">
                <items id="text">Fatores confundidores</items>
                <items id="description">Comentários sobre e registros de outros fatores incidentais que possam estar contribuindo na medida da pressão sanguínea. Por exemplo, nível de ansiedade ou "síndrome do jaleco branco"; dor ou febre; mudanças na pressão atmosférica, etc.</items>
            </items>
            <items code="at1053">
                <items id="text">Intra-arterial</items>
                <items id="description">Medição invasiva via linha de acesso do transdutor dentro de uma artéria.</items>
            </items>
            <items code="at1054">
                <items id="text">Fórmula de pressão sistólica</items>
                <items id="description">Fórmula utilizada para calcular a pressão sistólica a partir da pressão arterial média (se registrada nos dados).</items>
            </items>
            <items code="at1055">
                <items id="text">Fórmula da pressão diastólica</items>
                <items id="description">Fórmula utilizada para calcular a pressão diastólica da pressão arterial média (se registrada nos dados).</items>
            </items>
            <items code="at1056">
                <items id="text">Dorso do pé</items>
                <items id="description">O dorso do pé do indivíduo.</items>
            </items>
            <items code="at1057">
                <items id="text">Localização de medição estruturada</items>
                <items id="description">Localização anatômica estruturada de onde a medição foi feita.</items>
            </items>
            <items code="at1058">
                <items id="text">Extensão</items>
                <items id="description">Informações adicionais necessárias para capturar o contexto local ou para alinhar com outros modelos / formalismos de referência.</items>
                <items id="comment">Por exemplo: Informações locais de departamentos de hospitais ou metadados adicionais para alinhar a equivalentes FHIR ou CIMI</items>
            </items>
            <items code="at1059">
                <items id="text">Interpretação clínica</items>
                <items id="description">Palavra única, frase ou breve descrição que representa o significado clínico e o significado da medida da pressão arterial.</items>
            </items>
            <items code="mm[Hg]">
                <items id="text">mmHg</items>
                <items id="description">millimeters of mercury</items>
            </items>
        </term_definitions>
        <term_definitions language="sv">
            <items code="at0000">
                <items id="text">Blodtryck</items>
                <items id="description">Den lokala mätningen av artärblodtrycket som är ett substitut för artärtryck i den systemiska cirkulationen.</items>
                <items id="comment">Vanligtvis refererar användningen av termen blodtryck till mätningen av brakialartärtrycket i överarmen.</items>
            </items>
            <items code="at0001">
                <items id="text">Anamnes</items>
                <items id="description">Strukturerad anamnes.</items>
            </items>
            <items code="at0003">
                <items id="text">Tree</items>
                <items id="description">@ internal @</items>
            </items>
            <items code="at0004">
                <items id="text">Systoliskt</items>
                <items id="description">Det högsta värdet på systemartärtrycket under systole, det vill säga under sammandragningsfasen av hjärtcykeln.</items>
            </items>
            <items code="at0005">
                <items id="text">Diastoliskt</items>
                <items id="description">Det minsta värdet på systemartärtrycket under diastole, det vill säga under avslappningsfasen av hjärtcykeln.</items>
            </items>
            <items code="at0006">
                <items id="text">Ospecificerad händelse</items>
                <items id="description">Ospecificerad standardhändelse vid en tidpunkt eller inom ett tidsintervall som explicit kan definieras i en template eller genereras automatiskt av vissa IT-system.</items>
            </items>
            <items code="at0007">
                <items id="text">Tree</items>
                <items id="description">@ internal @</items>
            </items>
            <items code="at0008">
                <items id="text">Ställning</items>
                <items id="description">Individens kroppsställning under mätningen.</items>
            </items>
            <items code="at0011">
                <items id="text">Träd</items>
                <items id="description">Liststruktur</items>
            </items>
            <items code="at0013">
                <items id="text">Manschettstorlek</items>
                <items id="description">Storleken på manschetten som används för blodtrycksmätning.</items>
                <items id="comment">Perloff D, Grim C, Flack J, Frohlich ED, Hill M, McDonald M, Morgenstern BZ. Human blood pressure determination by sphygmomanometry. Circulation 1993;88;2460-2470.</items>
            </items>
            <items code="at0014">
                <items id="text">Mätställe</items>
                <items id="description">Beskrivning av anatomiskt ställe där blodtrycket mäts.</items>
            </items>
            <items code="at0015">
                <items id="text">Vuxet lår</items>
                <items id="description">En lårmanschett för vuxna.</items>
            </items>
            <items code="at0016">
                <items id="text">Stor vuxen</items>
                <items id="description">En manschett för vuxna med kraftigare armar.</items>
            </items>
            <items code="at0017">
                <items id="text">Vuxen</items>
                <items id="description">En standardmanschett för vuxna.</items>
            </items>
            <items code="at0025">
                <items id="text">Höger arm</items>
                <items id="description">Individens högra arm.</items>
            </items>
            <items code="at0026">
                <items id="text">Vänster arm</items>
                <items id="description">Individens vänstra arm.</items>
            </items>
            <items code="at0027">
                <items id="text">Höger lår</items>
                <items id="description">Individens högra lår.</items>
            </items>
            <items code="at0028">
                <items id="text">Vänster lår</items>
                <items id="description">Individens vänstra lår.</items>
            </items>
            <items code="at0033">
                <items id="text">Kommentar</items>
                <items id="description">Ytterligare beskrivning av mätningen som inte beskrivits i andra fält.</items>
            </items>
            <items code="at1000">
                <items id="text">Stående</items>
                <items id="description">Stående upprätt under blodtrycksmätningen.</items>
            </items>
            <items code="at1001">
                <items id="text">Sittande</items>
                <items id="description">Sittande ställning under blodtrycksmätningen, exempelvis på en säng eller stol.</items>
            </items>
            <items code="at1002">
                <items id="text">Halvliggande</items>
                <items id="description">Halvliggande ställning under blodtrycksmätningen.</items>
            </items>
            <items code="at1003">
                <items id="text">Liggande</items>
                <items id="description">Liggande raklång under blodtrycksmätningen.</items>
            </items>
            <items code="at1005">
                <items id="text">Lutning</items>
                <items id="description">Lutning vid huvudet på ytan som individen ligger på vid tidpunkten för mätningen.</items>
            </items>
            <items code="at1006">
                <items id="text">Medelartärtryck</items>
                <items id="description">Det genomsnittliga systemartärtrycket under hela hjärtcykeln, det vill säga under både sammandragningsfas och avslappningsfas.</items>
            </items>
            <items code="at1007">
                <items id="text">Pulstryck</items>
                <items id="description">Differensen mellan systoliskt och diastoliskt blodtryck.</items>
            </items>
            <items code="at1008">
                <items id="text">Liten Vuxen</items>
                <items id="description">En manschett för vuxna med smalare armar.</items>
            </items>
            <items code="at1009">
                <items id="text">Pediatrisk/Barn</items>
                <items id="description">En manschett för barn eller vuxna med smala armar.</items>
            </items>
            <items code="at1010">
                <items id="text">Diastoliskt effektmått</items>
                <items id="description">Registrerat Korotkoff-ljud som används för att avgöra diastoliskt tryck med hjälp av auskultatorisk metod.</items>
            </items>
            <items code="at1011">
                <items id="text">Fas IV</items>
                <items id="description">Det fjärde Korotkoff-ljudet identifieras som en plötslig ljuddämpning.</items>
            </items>
            <items code="at1012">
                <items id="text">Fas V</items>
                <items id="description">Det femte Korotkoff-ljudet identifieras genom avsaknad av ljud då manschettrycket sjunker under det diastoliska blodtrycket.</items>
            </items>
            <items code="at1014">
                <items id="text">Liggande i vänster sidoläge</items>
                <items id="description">Liggande raklång med viss lateral lutning, vanligtvis mot vänster sida. Det krävs vanligtvis i graviditetens sista trimester för att lindra aortokaval kompression.</items>
            </items>
            <items code="at1018">
                <items id="text">Spädbarn</items>
                <items id="description">En manschett för spädbarn.</items>
            </items>
            <items code="at1019">
                <items id="text">Nyfödd</items>
                <items id="description">En manschett för nyfödda.</items>
            </items>
            <items code="at1020">
                <items id="text">Höger handled</items>
                <items id="description">Individens högra handled.</items>
            </items>
            <items code="at1021">
                <items id="text">Vänster handled</items>
                <items id="description">Individens vänstra handled.</items>
            </items>
            <items code="at1025">
                <items id="text">Utrustning</items>
                <items id="description">Detaljer om sfygmomanometer eller annan utrustning som används för att mäta blodtrycket.</items>
            </items>
            <items code="at1026">
                <items id="text">Höger ankel</items>
                <items id="description">Individens högra ankel.</items>
            </items>
            <items code="at1030">
                <items id="text">Ansträngning</items>
                <items id="description">Detaljer om den fysiska aktiviteten som utförts vid tidpunkten av blodtrycksmätningen.</items>
            </items>
            <items code="at1031">
                <items id="text">Vänster ankel</items>
                <items id="description">Individens vänstra ankel.</items>
            </items>
            <items code="at1032">
                <items id="text">Finger</items>
                <items id="description">Individens finger.</items>
            </items>
            <items code="at1035">
                <items id="text">Metod</items>
                <items id="description">Metod för mätning av blodtryck.</items>
            </items>
            <items code="at1036">
                <items id="text">Auskultation</items>
                <items id="description">Metod för icke-invasiv mätning av blodtryck med hjälp av sfygmomanometri, såsom manschett, stetoskop, Korotkoff-ljud.</items>
            </items>
            <items code="at1037">
                <items id="text">Palpation</items>
                <items id="description">Metod för att mäta det systoliska blodtrycket med hjälp av palpation, vanligtvis av brakiala eller radiella artärer.</items>
            </items>
            <items code="at1038">
                <items id="text">Formel för medelartärtryck</items>
                <items id="description">Formel som används för att beräkna medelartärtrycket (om det finns registrerat).</items>
            </items>
            <items code="at1039">
                <items id="text">Blodtrycksmaskin</items>
                <items id="description">Icke-invasiv blodtrycksmätning med hjälp av oscillometri i en halvautomatisk blodtrycksmätare.</items>
            </items>
            <items code="at1040">
                <items id="text">Invasiv</items>
                <items id="description">Metod för att mäta blodtrycket intravenöst, dvs. genom att penetrera huden och mäta inuti blodkärlen.</items>
            </items>
            <items code="at1042">
                <items id="text">24 timmars blodtrycksmätning</items>
                <items id="description">Beräkning av det genomsnittliga blodtrycket under en 24-timmarsperiod.</items>
            </items>
            <items code="at1043">
                <items id="text">Sömnstatus</items>
                <items id="description">Sömnstatus som stöder tolkningen av 24-timmars ambulatoriska blodtrycksmätningar.</items>
            </items>
            <items code="at1044">
                <items id="text">Alert och vaken</items>
                <items id="description">Patienten är vid fullt medvetande.</items>
            </items>
            <items code="at1045">
                <items id="text">Sover</items>
                <items id="description">Patienten är i det naturliga tillståndet av kroppslig vila.</items>
            </items>
            <items code="at1051">
                <items id="text">Tå</items>
                <items id="description">Individens tå.</items>
            </items>
            <items code="at1052">
                <items id="text">Möjliga felkällor</items>
                <items id="description">Andra faktorer som kan påverka blodtrycksmätningen, exempelvis grad av oro, "vitrockseffekt", smärta, feber eller förändringar i lufttryck.</items>
            </items>
            <items code="at1053">
                <items id="text">Intraarteriell</items>
                <items id="description">Invasiv mätning via artärkateter.</items>
            </items>
            <items code="at1054">
                <items id="text">Formel för systoliskt tryck</items>
                <items id="description">Formel som används för att beräkna det systoliska trycket från medelartärtrycket (om det finns registrerat).</items>
            </items>
            <items code="at1055">
                <items id="text">Formel för diastoliskt tryck</items>
                <items id="description">Formel som används för att beräkna det diastoliska trycket från medelartärtrycket (om det finns registrerat).</items>
            </items>
            <items code="at1056">
                <items id="text">Fotryggen</items>
                <items id="description">Individens fotrygg.</items>
            </items>
            <items code="at1057">
                <items id="text">Strukturerat mätställe</items>
                <items id="description">Strukturerat anatomiskt ställe där mätningen gjordes.</items>
            </items>
            <items code="at1058">
                <items id="text">Tilläggsinformation</items>
                <items id="description">Plats för tilläggsinformation som krävs för lokala anpassningar eller anpassning till andra referensmodeller eller formella krav.</items>
                <items id="comment">Exempelvis lokala informationskrav eller metadata för anpassning till FHIR.</items>
            </items>
            <items code="at1059">
                <items id="text">Klinisk tolkning</items>
                <items id="description">Ord, fras eller kort beskrivning som representerar den kliniska betydelsen och signifikansen av blodtrycksmätningen.</items>
            </items>
            <items code="mm[Hg]">
                <items id="text">mmHg</items>
                <items id="description">millimeters of mercury</items>
            </items>
        </term_definitions>
        <term_definitions language="de">
            <items code="at0000">
                <items id="text">Blutdruck</items>
                <items id="description">Die lokale Messung des arteriellen Blutdrucks als Surrogat für den arteriellen Druck in der systemischen Zirkulation.</items>
                <items id="comment">Häufig wird der Ausdruck 'Blutdruck' zur Bezeichung der Messung des brachialen Ateriendrucks im Oberarm verwendet.</items>
            </items>
            <items code="at0001">
                <items id="text">Historie</items>
                <items id="description">Historie</items>
            </items>
            <items code="at0003">
                <items id="text">Blutdruck</items>
                <items id="description">@ internal @</items>
            </items>
            <items code="at0004">
                <items id="text">Systolisch</items>
                <items id="description">Der höchste arterielle Blutdruck eines Zyklus - gemessen in der systolischen oder Kontraktionsphase des Herzens.</items>
            </items>
            <items code="at0005">
                <items id="text">Diastolisch</items>
                <items id="description">Der minimale systemische arterielle Blutdruck eines Zyklus - gemessen in der diastolischen oder Entspannungsphase des Herzens.</items>
            </items>
            <items code="at0006">
                <items id="text">Beliebiges Ereignis</items>
                <items id="description">Standardmäßiger, nicht näher beschriebener Zeitpunkt oder Intervall Ereignis welches in einem Template oder bei der Anwendung genauer definiert werden kann.</items>
            </items>
            <items code="at0007">
                <items id="text">state structure</items>
                <items id="description">@ internal @</items>
            </items>
            <items code="at0008">
                <items id="text">Position</items>
                <items id="description">Die Position der untersuchten Person während der Messung.</items>
            </items>
            <items code="at0011">
                <items id="text">Listenstruktur</items>
                <items id="description">Listenstruktur</items>
            </items>
            <items code="at0013">
                <items id="text">Manschettengröße</items>
                <items id="description">Die Größe der Manschette, die zur Blutdruckmessung benutzt wurde.</items>
                <items id="comment">Perloff D, Grim C, Flack J, Frohlich ED, Hill M, McDonald M, Morgenstern BZ. Human blood pressure determination by sphygmomanometry. Circulation 1993;88;2460-2470.</items>
            </items>
            <items code="at0014">
                <items id="text">Stelle der Messung</items>
                <items id="description">Einfache Körperstelle an der der Blutdruck gemessen wurde.</items>
            </items>
            <items code="at0015">
                <items id="text">Oberschenkel eines Erwachsenen</items>
                <items id="description">Eine Manschette für den Oberschenkel eines Erwachsenen - ca. 20cm x 42cm.</items>
            </items>
            <items code="at0016">
                <items id="text">Großer Erwachsener</items>
                <items id="description">Eine Manschette für Erwachsene mit größeren Armen - ca. 16cm x 38cm.</items>
            </items>
            <items code="at0017">
                <items id="text">Erwachsener</items>
                <items id="description">Eine Standard-Manschette für einen Erwachsenen - ca. 13cm x 30cm.</items>
            </items>
            <items code="at0025">
                <items id="text">Rechter Arm</items>
                <items id="description">Der rechte Arm der Person.</items>
            </items>
            <items code="at0026">
                <items id="text">Linker Arm</items>
                <items id="description">Der linke Arm der Person.</items>
            </items>
            <items code="at0027">
                <items id="text">Rechter Oberschenkel</items>
                <items id="description">Der rechte Oberschenkel der Person.</items>
            </items>
            <items code="at0028">
                <items id="text">Linker Oberschenkel</items>
                <items id="description">Der linke Oberschenkel der Person.</items>
            </items>
            <items code="at0033">
                <items id="text">Kommentar</items>
                <items id="description">Zusätzlicher Freitext über die Messung, der nicht in anderen Felder erfasst werden konnte.</items>
            </items>
            <items code="at1000">
                <items id="text">Stehend</items>
                <items id="description">Stehend zum Zeitpunkt der Blutdruckmessung.</items>
            </items>
            <items code="at1001">
                <items id="text">Sitzend</items>
                <items id="description">Sitzend zum Zeitpunkt der Blutdruckmessung (z.B. auf einem Bett oder Stuhl).</items>
            </items>
            <items code="at1002">
                <items id="text">Zurückgelehnt</items>
                <items id="description">Patient zurückgelehnt zum Zeitpunkt der Blutdruckmessung.</items>
            </items>
            <items code="at1003">
                <items id="text">Liegend</items>
                <items id="description">Flach liegend zum Zeitpunkt der Blutdruckmessung.</items>
            </items>
            <items code="at1005">
                <items id="text">Neigung</items>
                <items id="description">Die kraniokaudale Neigung der Oberfläche auf der die Person zum Zeitpunkt der Messung liegt.</items>
            </items>
            <items code="at1006">
                <items id="text">Mittlerer arterieller Druck</items>
                <items id="description">Der mittlerer arterielle Druck über den gesamten Verlauf der Konktraktions- und Entspannungsphase des Herzens.</items>
            </items>
            <items code="at1007">
                <items id="text">Pulsdruck</items>
                <items id="description">Der Abstand zwischen dem systolischen und dem diastolischen Blutdruckwert.</items>
            </items>
            <items code="at1008">
                <items id="text">Kleiner Erwachsener</items>
                <items id="description">Eine Manschette für einen kleinen Erwachsenen - ca. 10cm x 24cm.</items>
            </items>
            <items code="at1009">
                <items id="text">Pädiatrisch/Kind</items>
                <items id="description">Eine Manschette für ein Kind oder auch einen Erwachsenen mit einem schmalen Arm - 8cm x 21cm.</items>
            </items>
            <items code="at1010">
                <items id="text">Diastolischer Endpunkt</items>
                <items id="description">Dient der Dokumentation des Korotkoff-Geräusches, das verwendet wird, um bei auskultarischer Messung den diastolischen Blutdruck zu bestimmen.</items>
            </items>
            <items code="at1011">
                <items id="text">Phase IV</items>
                <items id="description">Das 4. Korotkoff-Geräusch - Die Geräusche klingen plätzlich gedämpft.</items>
            </items>
            <items code="at1012">
                <items id="text">Phase V</items>
                <items id="description">Das 5. Korotkoff-Geräusch - die Geräusche verschwinden völlig während der Manschettendruck unter den diastolischen Blutdruck fällt.</items>
            </items>
            <items code="at1014">
                <items id="text">Nach links geneigt liegend</items>
                <items id="description">Flach liegend mit seitlicher Neigung, normalerweise zur linken Seite. Häufig verwendet im letzten Drittel eine Schwangerschaft, um aorto-cavale Kompression zu vermeiden.</items>
            </items>
            <items code="at1018">
                <items id="text">Kleinkind</items>
                <items id="description">Eine Manschette für Kleinkinder und Säuglinge - ca. 5cm x 15cm.</items>
            </items>
            <items code="at1019">
                <items id="text">Neonatal</items>
                <items id="description">Eine Manschette für Neugeborene mit passender Größe für die Reife und das Geburtsgewicht des Neugeborenen.</items>
            </items>
            <items code="at1020">
                <items id="text">Rechtes Handgelenk</items>
                <items id="description">Das rechte Handgelenk der Person.</items>
            </items>
            <items code="at1021">
                <items id="text">Linkes Handgelenk</items>
                <items id="description">Das linke Handgelenk der Person.</items>
            </items>
            <items code="at1025">
                <items id="text">Gerät</items>
                <items id="description">Details über das Sphygmomanometer oder ein anderes Gerät, dass zur Blutdruckmessung verwendet wird.</items>
            </items>
            <items code="at1026">
                <items id="text">Rechtes Fußgelenk</items>
                <items id="description">Das rechte Fußgelenk der Person.</items>
            </items>
            <items code="at1030">
                <items id="text">Anstrengung</items>
                <items id="description">Details über physische Aktivitäten zur Zeit der Blutdruckmessung.</items>
            </items>
            <items code="at1031">
                <items id="text">Linkes Fußgelenk</items>
                <items id="description">Das linke Fußgelenk der Person</items>
            </items>
            <items code="at1032">
                <items id="text">Finger</items>
                <items id="description">Ein Finger des Individuums.</items>
            </items>
            <items code="at1035">
                <items id="text">Methode</items>
                <items id="description">Methode der Messung des Blutdrucks.</items>
            </items>
            <items code="at1036">
                <items id="text">Auskultation</items>
                <items id="description">Auskulatorische Messung unter Benutzung eines Stethoskops und der Korotkoff-Geräusche.</items>
            </items>
            <items code="at1037">
                <items id="text">Palpation</items>
                <items id="description">Palpatorische Messung, normalerweise an den brachialen oder radialen Arterien.</items>
            </items>
            <items code="at1038">
                <items id="text">Formel für mittleren arterieller Druck</items>
                <items id="description">Die Formel die ggf. verwendet wurde, um den mittleren arteriellen Druck zu berechnen.</items>
            </items>
            <items code="at1039">
                <items id="text">Machine</items>
                <items id="description">Messung durch eine Blutdruckmaschine.</items>
            </items>
            <items code="at1040">
                <items id="text">Invasiv</items>
                <items id="description">Invasive Messung des Blutdrucks innerhalb eines Gefäßes.</items>
            </items>
            <items code="at1042">
                <items id="text">24 Stunden Durchschnitt</items>
                <items id="description">Schätzung des durchschnittlichen Blutdrucks über einen 24-stündigen Zeitraum.</items>
            </items>
            <items code="at1043">
                <items id="text">Schlafzustand</items>
                <items id="description">Schlafzustand - unterstützt die Auswertung von 24-stündigen ambulanten Aufzeichnungen des Blutdrucks.</items>
            </items>
            <items code="at1044">
                <items id="text">Aufmerksam und wach</items>
                <items id="description">Die untersuchte Person ist bei vollem Bewusstsein.</items>
            </items>
            <items code="at1045">
                <items id="text">Schlafend</items>
                <items id="description">Die untersuchte Person schläft.</items>
            </items>
            <items code="at1051">
                <items id="text">Zeh</items>
                <items id="description">Ein Zeh des Individuums.</items>
            </items>
            <items code="at1052">
                <items id="text">Einflussfaktoren</items>
                <items id="description">Kommentar und Aufzeichung anderer Faktoren die ggf. zu dem Ergebnis der Blutdruckmessung beitragen können. Die kann z.B. bei belastenden Situationen der Fall sein (z.B. sog. Weißkittelhypertonie, Schmerzen, Fieber, Änderungen im atmosphärischen Druck).</items>
            </items>
            <items code="at1053">
                <items id="text">Intraarteriell</items>
                <items id="description">Invasive Messung mittels Transducer über einen arteriellen Zugang.</items>
            </items>
            <items code="at1054">
                <items id="text">Formel für systolischen Druck</items>
                <items id="description">Formel, die benutzt wurde, um den systolischen Druck vom mittleren arteriellen Druck zu berechnen (wenn erfasst).</items>
            </items>
            <items code="at1055">
                <items id="text">Formel für diastolischen Druck</items>
                <items id="description">Formel, die benutzt wurde, um den distolischen Druck vom mittleren arteriellen Druck zu berechnen (wenn erfasst).</items>
            </items>
            <items code="at1056">
                <items id="text">Fußrücken</items>
                <items id="description">Fußrücken des Individuums.</items>
            </items>
            <items code="at1057">
                <items id="text">Strukturierte Stelle der Messung</items>
                <items id="description">Strukturierte Körperstelle an der der Blutdruck gemessen wurde.</items>
            </items>
            <items code="at1058">
                <items id="text">Erweiterung</items>
                <items id="description">Zusätzliche Information, die für die Erfassung des lokalen Kontexts oder für die Anpassung an andere Referenzmodelle/Formalismen benötigt wird.</items>
                <items id="comment">Zum Beispiel: Informationen bzgl. der lokalen Krankenhausabteilung oder zusätzliche Metadata zur Anpassung an entsprechende FHIR oder CIMI Gegenstücke.</items>
            </items>
            <items code="at1059">
                <items id="text">Klinische Interpretation</items>
                <items id="description">Einzelnes Wort, Ausdruck oder Kurzbeschreibung der klinischen Bedeutung und Aussagekraft der Blutdruckmessung.</items>
            </items>
            <items code="mm[Hg]">
                <items id="text">mmHg</items>
                <items id="description">millimeters of mercury</items>
            </items>
        </term_definitions>
        <term_definitions language="nb">
            <items code="at0000">
                <items id="text">Blodtrykk</items>
                <items id="description">Måling av blodtrykket som uttrykk for det arterielle blodtrykk i det systemiske kretsløp.</items>
                <items id="comment">Vanligvis brukes begrepet "blodtrykk" om måling av brakialt arterietrykk i overarmen.</items>
            </items>
            <items code="at0001">
                <items id="text">Historikk</items>
                <items id="description">History Structural node.</items>
            </items>
            <items code="at0003">
                <items id="text">*blood pressure(en)</items>
                <items id="description">*@ internal @(en)</items>
            </items>
            <items code="at0004">
                <items id="text">Systolisk</items>
                <items id="description">Maksimalt systemisk arterielt blodtrykk - målt i systolen, det vil si i hjertets kontraksjonsfase.</items>
            </items>
            <items code="at0005">
                <items id="text">Diastolisk</items>
                <items id="description">Laveste systemiske arterielle blodtrykk - målt i diastolen, det vil si under hjertets relaksasjonsfase.</items>
            </items>
            <items code="at0006">
                <items id="text">Uspesifisert hendelse</items>
                <items id="description">Standard, uspesifisert tidspunkt eller tidsintervall som kan defineres mer eksplisitt i et templat eller i en applikasjon.</items>
            </items>
            <items code="at0007">
                <items id="text">*state structure(en)</items>
                <items id="description">*@ internal @(en)</items>
            </items>
            <items code="at0008">
                <items id="text">Stilling</items>
                <items id="description">Individets posisjon ved tidspunktet for målingen.</items>
            </items>
            <items code="at0011">
                <items id="text">Tre</items>
                <items id="description">Struktur liste</items>
            </items>
            <items code="at0013">
                <items id="text">Mansjettstørrelse</items>
                <items id="description">Størrelse på blodtrykkmansjetten som anvendes til måling av blodtrykket. (Cuffstørrelse)</items>
                <items id="comment">Perloff D, Grim C, Flack J, Frohlich ED, Hill M, McDonald M, Morgenstern BZ. Human blood pressure determination by sphygmomanometry. Circulation 1993;88;2460-2470.</items>
            </items>
            <items code="at0014">
                <items id="text">Målested</items>
                <items id="description">Anatomisk sted hvor blodtrykket måles. Bruk listen over interne koder for valg av vanlige målesteder. Bruk fri eller kodet tekst for registrering av mer spesifikke detaljer eller et målested som ikke inngår i listen over vanlige steder. Henvis eventuelt til ekstern terminologi.</items>
            </items>
            <items code="at0015">
                <items id="text">Lår voksne</items>
                <items id="description">Mansjett for bruk rundt låret til voksne individer.</items>
            </items>
            <items code="at0016">
                <items id="text">Store voksne</items>
                <items id="description">En blodtrykksmansjett for voksne med store armer.</items>
            </items>
            <items code="at0017">
                <items id="text">Voksne</items>
                <items id="description">En standard blodtrykksmansjett til voksne.</items>
            </items>
            <items code="at0025">
                <items id="text">Overarm, høyre</items>
                <items id="description">Individets høyre overarm.</items>
            </items>
            <items code="at0026">
                <items id="text">Overarm, venstre</items>
                <items id="description">Individets venstre overarm.</items>
            </items>
            <items code="at0027">
                <items id="text">Lår, høyre</items>
                <items id="description">Individets høyre lår.</items>
            </items>
            <items code="at0028">
                <items id="text">Lår, venstre</items>
                <items id="description">Individets venstre lår.</items>
            </items>
            <items code="at0033">
                <items id="text">Kommentar</items>
                <items id="description">Ytterligere fritekst om målingen, som ikke omfattes av andre felt.</items>
            </items>
            <items code="at1000">
                <items id="text">Stående</items>
                <items id="description">Stående ved tidspunktet for målingen.</items>
            </items>
            <items code="at1001">
                <items id="text">Sittende</items>
                <items id="description">Sittende (for eksempel på en stol eller på en seng med føttene på gulvet) på tidspunkt for blodtrykksmålingen.</items>
            </items>
            <items code="at1002">
                <items id="text">Tilbakelent</items>
                <items id="description">Sittende tilbakelent ca 45º og med beina hevet til samme høyde som hoften på tidspunkt for blodtrykksmålingen.</items>
            </items>
            <items code="at1003">
                <items id="text">Liggende</items>
                <items id="description">Liggende flatt på tidspunkt for blodtrykksmålingen.</items>
            </items>
            <items code="at1005">
                <items id="text">Tilt</items>
                <items id="description">Kranio-caudal tilt av overflaten som individet ligger på på tidspunkt for blodtrykksmåling.</items>
                <items id="comment">Negative verdier betegner posisjoner med hodet ned.</items>
            </items>
            <items code="at1006">
                <items id="text">Middelarterietrykk</items>
                <items id="description">Det gjennomsnittlige trykket mot arterieveggen gjennom en enkelt hjertesyklus. Middeltrykk/MAP måles direkte eller beregnes ut fra systolisk og diastolisk trykk ved hjelp av en matematisk formel.</items>
            </items>
            <items code="at1007">
                <items id="text">Pulstrykk</items>
                <items id="description">Differansen mellom det systoliske og diastoliske arterielle blodtrykket.</items>
            </items>
            <items code="at1008">
                <items id="text">Små voksne</items>
                <items id="description">En blodtrykksmansjett for små voksne.</items>
            </items>
            <items code="at1009">
                <items id="text">Barn</items>
                <items id="description">En blodtrykksmansjett til barn eller små voksne med tynne armer.</items>
            </items>
            <items code="at1010">
                <items id="text">Diastolisk endepunkt</items>
                <items id="description">Registrering av hvilken av Korotkofflydene som brukes for å bestemme det diastoliske blodtrykket ved hjelp av auskultasjon.</items>
            </items>
            <items code="at1011">
                <items id="text">Fase IV</items>
                <items id="description">Den fjerde Korotkoff lyd som identifieres som en brå demping av lydene.</items>
            </items>
            <items code="at1012">
                <items id="text">Fase V</items>
                <items id="description">Den femte Korotkoff lyd som identifiseres som fraværet av lyder idet mansjettrykket faller under det diastoliske blodtrykket.</items>
            </items>
            <items code="at1014">
                <items id="text">Liggende lent mot venstre</items>
                <items id="description">Liggende flatt med noe lateral tilt, vanligvis vinklet mot venstre side. Vanligvis nødvendig i siste trimester av svangerskapet for å avlaste aortocaval komprimering.</items>
            </items>
            <items code="at1018">
                <items id="text">Spedbarn</items>
                <items id="description">En blodtrykksmansjett til bruk for spedbarn.</items>
            </items>
            <items code="at1019">
                <items id="text">Neonatale</items>
                <items id="description">En blodtrykksmansjett til bruk for neonatale, forutsatt at blodtrykksmansjetten er tilpasset i størrelse for modenhet og fødselsvekt.</items>
            </items>
            <items code="at1020">
                <items id="text">Håndledd, høyre</items>
                <items id="description">Individets høyre håndledd.</items>
            </items>
            <items code="at1021">
                <items id="text">Håndledd, venstre</items>
                <items id="description">Individets venstre håndledd.</items>
            </items>
            <items code="at1025">
                <items id="text">Måleapparat</items>
                <items id="description">Detaljer om sfygmomanometeret eller annet måleapparat brukt til blodtrykksmåling.</items>
            </items>
            <items code="at1026">
                <items id="text">Ankel, høyre</items>
                <items id="description">Individets høyre ankel.</items>
            </items>
            <items code="at1030">
                <items id="text">Fysisk anstrengelse</items>
                <items id="description">Detaljer om fysisk aktivitet på tidspunkt for blodtrykksmåling.</items>
            </items>
            <items code="at1031">
                <items id="text">Ankel, venstre</items>
                <items id="description">Individets venstre ankel.</items>
            </items>
            <items code="at1032">
                <items id="text">Finger</items>
                <items id="description">Individets finger. Dersom identifikasjon av den spesifikke fingeren er nødvendig, kan dette legges inn ved hjelp av feltet med fri eller kodet tekst.</items>
            </items>
            <items code="at1035">
                <items id="text">Målemetode</items>
                <items id="description">Metode for måling av blodtrykket.</items>
            </items>
            <items code="at1036">
                <items id="text">Auskultasjon</items>
                <items id="description">Metode for måling av blodtrykk eksternt, ved hjelp av stetoskop og Korotkofflyder.</items>
            </items>
            <items code="at1037">
                <items id="text">Palpasjon</items>
                <items id="description">Metode for måling av blodtrykket eksternt, ved hjelp av palpasjon (vanligvis av arteriene brachialis eller radialis).</items>
            </items>
            <items code="at1038">
                <items id="text">Formel for beregning av MAP</items>
                <items id="description">Eventuell formel som er anvendt til beregning av middeltrykket (MAP).</items>
            </items>
            <items code="at1039">
                <items id="text">Automatisk, non-invasivt</items>
                <items id="description">Metode for non-invasiv måling av blodtrykket ved hjelp av en maskin som automatisk måler blodtrykket, for eksempel et måleapparat eller en blodtrykksmåler for hjemmebruk.</items>
            </items>
            <items code="at1040">
                <items id="text">Automatisk, invasivt</items>
                <items id="description">Metode for måling av blodtrykket invasivt med innleggelse av intravasalkateter i en blodåre.</items>
            </items>
            <items code="at1042">
                <items id="text">24-timers gjennomsnitt</items>
                <items id="description">Estimert gjennomsnittsblodtrykk over en 24-timers periode.</items>
            </items>
            <items code="at1043">
                <items id="text">Søvnstatus</items>
                <items id="description">Søvnstatus - understøtter tolkning av 24 timers ambulant blodtrykksmåling.</items>
            </items>
            <items code="at1044">
                <items id="text">Våken</items>
                <items id="description">Individet er ved full bevissthet.</items>
            </items>
            <items code="at1045">
                <items id="text">Sovende</items>
                <items id="description">Individet er i den naturlige tilstand av kroppslig hvile.</items>
            </items>
            <items code="at1051">
                <items id="text">Tå</items>
                <items id="description">Individets tå. Dersom identifikasjon av den spesifikke tåen er nødvendig, kan dette legges inn ved hjelp av feltet med fri eller kodet tekst.</items>
            </items>
            <items code="at1052">
                <items id="text">Konfunderende faktorer</items>
                <items id="description">Kommentar til og registrering av andre faktorer som kan påvirke blodtrykksmålingen. For eksempel angst eller "hvit frakk syndrom", smerter eller feber, endringer i atmosfærisk trykk osv.</items>
            </items>
            <items code="at1053">
                <items id="text">Intra-arterielt</items>
                <items id="description">Invasiv måling i en artiere via en transducer.</items>
            </items>
            <items code="at1054">
                <items id="text">Formel for beregning av systolisk trykk</items>
                <items id="description">Formelen som anvendes til beregning av systolisk blodtrykk dersom det benyttes en maskin som måler middeltrykket og beregner systolisk og diastolisk trykk.</items>
            </items>
            <items code="at1055">
                <items id="text">Formel for beregning av diastolisk trykk</items>
                <items id="description">Formelen som anvendes til beregning av diastolisk blodtrykk dersom det benyttes en maskin som måler middeltrykket og beregner systolisk og diastolisk trykk.</items>
            </items>
            <items code="at1056">
                <items id="text">Fotrygg</items>
                <items id="description">Individets fotrygg.</items>
            </items>
            <items code="at1057">
                <items id="text">Strukturert målested</items>
                <items id="description">Strukturert anatomisk lokalisering av stedet målingen ble gjort.</items>
            </items>
            <items code="at1058">
                <items id="text">Tilleggsinformasjon</items>
                <items id="description">Ytterligere informasjon som trengs for å kunne registrere lokalt definert innhold eller for å tilpasse til andre referansemodeller/formalismer.</items>
                <items id="comment">For eksempel lokale informasjonsbehov eller ytterligere metadata for å kunne tilpasse til tilsvarende konsepter i FHIR eller CIMI.</items>
            </items>
            <items code="at1059">
                <items id="text">Klinisk tolkning</items>
                <items id="description">Enkeltord, frase eller kort beskrivelse som representerer den kliniske betydningen og signifikansen av blodtrykksmålingen.</items>
            </items>
            <items code="mm[Hg]">
                <items id="text">mmHg</items>
                <items id="description">millimeters of mercury</items>
            </items>
        </term_definitions>
    </component_ontologies>
    <component_ontologies archetype_id="openEHR-EHR-OBSERVATION.height.v2">
        <term_definitions language="pt-br">
            <items code="at0000">
                <items id="text">Altura / comprimento</items>
                <items id="description">Altura ou comprimento do corpo, é medida a partir da coroa da cabeça a sola do pé.&#13;
A altura é medida com o indivíduo na posição de pé e comprimento do corpo na posição decúbito dorsal.</items>
                <items id="comment">A altura é medida com o indivíduo em uma posição em pé e o comprimento do corpo em uma posição reclinada.</items>
            </items>
            <items code="at0001">
                <items id="text">history</items>
                <items id="description">@ internal @</items>
            </items>
            <items code="at0002">
                <items id="text">Qualquer evento</items>
                <items id="description">Padrão, ponto não específico no tempo ou intrvalo que pode ser definido em um modelo ou em tempo de execução.</items>
            </items>
            <items code="at0003">
                <items id="text">Simple</items>
                <items id="description">@ internal @</items>
            </items>
            <items code="at0004">
                <items id="text">Altura / comprimento</items>
                <items id="description">O comprimento do corpo da coroa da cabeça a sola do pé.</items>
            </items>
            <items code="at0007">
                <items id="text">List</items>
                <items id="description">@ internal @</items>
            </items>
            <items code="at0011">
                <items id="text">Dispositivo</items>
                <items id="description">Descrição do dispositivo utilizado para medir altura ou comprimento do corpo.</items>
            </items>
            <items code="at0013">
                <items id="text">Tree</items>
                <items id="description">@ internal @</items>
            </items>
            <items code="at0014">
                <items id="text">Posição</items>
                <items id="description">Posição individual quando medido.</items>
            </items>
            <items code="at0016">
                <items id="text">De pé</items>
                <items id="description">A altura é medida de pé sobre os dois pés com o peso distribuído uniformemente, calcanhares juntos e as nádegas e os calcanhares em contato com uma placa traseira vertical.</items>
            </items>
            <items code="at0018">
                <items id="text">Comentário</items>
                <items id="description">Narrativa adicional sobre a medida, não capturada em outros campos.</items>
            </items>
            <items code="at0019">
                <items id="text">Fatores de confundimento</items>
                <items id="description">Descrição narrativa de quaisquer problemas ou fatores que podem impactar a medição.</items>
                <items id="comment">Por exemplo: observação de amputação.</items>
            </items>
            <items code="at0020">
                <items id="text">Decúbito dorsal</items>
                <items id="description">O comprimento é medido em uma posição totalmente estendida, deitada com a pelve plana, pernas estendidas e os pés flexionados.</items>
            </items>
            <items code="at0021">
                <items id="text">Nascimento</items>
                <items id="description">Normalmente a primeira medição de comprimento, registrada logo após o nascimento. Este evento será usado somente uma vez por registro.</items>
            </items>
            <items code="at0022">
                <items id="text">Extensão</items>
                <items id="description">Informação adicional requerida para capturar conteúdo local ou alinhar a outros modelos de referência/formalismos.</items>
                <items id="comment">Por exemplo: requisitos de informações locais ou metadados adicionais para alinhar com equivalentes FHIR ou CIMI.</items>
            </items>
            <items code="[in_i]">
                <items id="text">in</items>
                <items id="description">inch</items>
            </items>
        </term_definitions>
        <term_definitions language="sv">
            <items code="at0000">
                <items id="text">Kroppslängd</items>
                <items id="description">Kroppslängd mäts från hjässa till fotsula.</items>
                <items id="comment">Kroppslängd mäts med individen stående eller liggande.</items>
            </items>
            <items code="at0001">
                <items id="text">history</items>
                <items id="description">@ internal @</items>
            </items>
            <items code="at0002">
                <items id="text">Händelse</items>
                <items id="description">Ospecificerad standardhändelse vid en tidpunkt eller inom ett tidsintervall som explicit kan definieras i en template eller genereras automatiskt av vissa IT-system.</items>
            </items>
            <items code="at0003">
                <items id="text">Simple</items>
                <items id="description">@ internal @</items>
            </items>
            <items code="at0004">
                <items id="text">Kroppslängd</items>
                <items id="description">Kroppslängd från hjässa till fotsula.</items>
            </items>
            <items code="at0007">
                <items id="text">List</items>
                <items id="description">@ internal @</items>
            </items>
            <items code="at0011">
                <items id="text">Utrustning</items>
                <items id="description">Beskrivning av den utrustning som används vid mätning av kroppslängd.</items>
            </items>
            <items code="at0013">
                <items id="text">Tree</items>
                <items id="description">@ internal @</items>
            </items>
            <items code="at0014">
                <items id="text">Kroppsställning</items>
                <items id="description">Individens kroppsställning vid mätning.</items>
            </items>
            <items code="at0016">
                <items id="text">Stående</items>
                <items id="description">Kroppslängden mäts i stående ställning med jämn viktfördelning mellan fötterna, hälarna ihop, samt båda skinkorna och hälarna i kontakt med en vertikal yta.</items>
            </items>
            <items code="at0018">
                <items id="text">Kommentar</items>
                <items id="description">Kommentarer avseende mätningen av kroppslängden som inte beskrivs i övriga datafält.</items>
            </items>
            <items code="at0019">
                <items id="text">Möjliga felkällor</items>
                <items id="description">Beskrivning av faktorer och felkällor som kan påverka mätningen av kroppslängd.</items>
                <items id="comment">Exempelvis notering om amputation.</items>
            </items>
            <items code="at0020">
                <items id="text">Liggande</items>
                <items id="description">Kroppslängden mäts i liggande helt utsträckt ställning med bäckenet platt, benen utsträckta och fötterna vinklade.</items>
            </items>
            <items code="at0021">
                <items id="text">Födelse</items>
                <items id="description">Vanligtvis den första mätningen av barnet strax efter födseln. Den här händelsen används endast en gång per patientjournal.</items>
            </items>
            <items code="at0022">
                <items id="text">Tilläggsinformation</items>
                <items id="description">Plats för att infoga tilläggsinformation som krävs för lokala anpassningar eller anpassning till andra referensmodeller eller formella krav.</items>
                <items id="comment">Exempelvis lokala informationskrav eller metadata för anpassning till FHIR.</items>
            </items>
            <items code="[in_i]">
                <items id="text">in</items>
                <items id="description">inch</items>
            </items>
        </term_definitions>
        <term_definitions language="de">
            <items code="at0000">
                <items id="text">Größe/Länge</items>
                <items id="description">Größe bzw. Körperlänge wird vom Scheitel bis zur Fußsohle gemessen.</items>
                <items id="comment">Die Größe wird bei der Person in stehender Position und die Körperlänge in liegender Position gemessen.</items>
            </items>
            <items code="at0001">
                <items id="text">History</items>
                <items id="description">@ internal @</items>
            </items>
            <items code="at0002">
                <items id="text">Beliebiges Ereignis</items>
                <items id="description">Standardwert, ein undefinierter/s Zeitpunkt oder Intervallereignis, das explizit im Template oder zur Laufzeit der Anwendung definiert werden kann.</items>
            </items>
            <items code="at0003">
                <items id="text">Simple</items>
                <items id="description">@ internal @</items>
            </items>
            <items code="at0004">
                <items id="text">Größe/Länge</items>
                <items id="description">Die Länge des Körpers vom Scheitel bis zur Fußsohle.</items>
            </items>
            <items code="at0007">
                <items id="text">List</items>
                <items id="description">@ internal @</items>
            </items>
            <items code="at0011">
                <items id="text">Gerät</items>
                <items id="description">Beschreibung des Geräts, das zur Messung der Größe oder Länge verwendet wurde.</items>
            </items>
            <items code="at0013">
                <items id="text">Tree</items>
                <items id="description">@ internal @</items>
            </items>
            <items code="at0014">
                <items id="text">Position</items>
                <items id="description">Position des Individiums bei der Messung.</items>
            </items>
            <items code="at0016">
                <items id="text">Stehend</items>
                <items id="description">Die Größe wird auf beiden Füßen stehend gemessen, wobei das Gewicht gleichmäßig verteilt ist, die Fersen zusammen und sowohl das Gesäß als auch die Fersen in Kontakt mit einem vertikalen Rückenbrett.</items>
            </items>
            <items code="at0018">
                <items id="text">Kommentar</items>
                <items id="description">Zusätzliche Darstellung der Messung, die in anderen Bereichen nicht erfasst wurde.</items>
            </items>
            <items code="at0019">
                <items id="text">Einflussfaktoren</items>
                <items id="description">Beschreibung aller Probleme oder Faktoren, die sich auf die Messung auswirken können.</items>
                <items id="comment">Zum Beispiel: Feststellung einer Amputation.</items>
            </items>
            <items code="at0020">
                <items id="text">Liegend</items>
                <items id="description">Länge wird in einer voll ausgestreckten, liegenden Position gemessen. Hierbei wird das Becken flach gehalten, die Beine ausgestreckt und die Füße gebeugt.&#13;
</items>
            </items>
            <items code="at0021">
                <items id="text">Geburt</items>
                <items id="description">Normalerweise wird die erste Längenmessung kurz nach der Geburt aufgezeichnet. Dieses Ereignis wird nur einmal pro Gesundheitsakte verwendet.</items>
            </items>
            <items code="at0022">
                <items id="text">Erweiterung</items>
                <items id="description">Zusätzliche Informationen zur Erfassung lokaler Inhalte oder Anpassung an andere Referenzmodelle/Formalismen.</items>
                <items id="comment">Zum Beispiel: Lokaler Informationsbedarf oder zusätzliche Metadaten zur Anpassung an FHIR-Ressourcen oder CIMI-Modelle.</items>
            </items>
            <items code="[in_i]">
                <items id="text">in</items>
                <items id="description">inch</items>
            </items>
        </term_definitions>
        <term_definitions language="nb">
            <items code="at0000">
                <items id="text">Høyde/Lengde</items>
                <items id="description">Individets høyde eller lengde målt fra isse til fotsåle.</items>
                <items id="comment">Høyde måles stående og lengde liggende.</items>
            </items>
            <items code="at0001">
                <items id="text">history</items>
                <items id="description">@ internal @</items>
            </items>
            <items code="at0002">
                <items id="text">Uspesifisert hendelse</items>
                <items id="description">Standard, uspesifisert tidspunkt eller tidsintervall som kan defineres mer eksplisitt i et templat eller i en applikasjon.</items>
            </items>
            <items code="at0003">
                <items id="text">Simple</items>
                <items id="description">@ internal @</items>
            </items>
            <items code="at0004">
                <items id="text">Høyde/lengde</items>
                <items id="description">Høyde/lengde fra isse til fotsåle.</items>
            </items>
            <items code="at0007">
                <items id="text">List</items>
                <items id="description">@ internal @</items>
            </items>
            <items code="at0011">
                <items id="text">Måleutstyr</items>
                <items id="description">Beskrivelse av måleutstyret brukt til måling av høyde eller lengde.</items>
            </items>
            <items code="at0013">
                <items id="text">Tree</items>
                <items id="description">@ internal @</items>
            </items>
            <items code="at0014">
                <items id="text">Kroppsstilling</items>
                <items id="description">Individets kroppsstilling på måletidspunktet.</items>
            </items>
            <items code="at0016">
                <items id="text">Stående</items>
                <items id="description">Høyde måles optimalt uten sko, uten sokker (for å se fotstillingen skikkelig), rumpen inntil veggen, skuldrene inntil veggen, hodet i Frankfurt stilling (nedre orbitalkant horisontalt med ytre øregang). En skal si til vedkommende "stå rett", men ikke skyve opp hodet.</items>
            </items>
            <items code="at0018">
                <items id="text">Kommentar</items>
                <items id="description">Ytterligere beskrivelse av målingen av høyde/lengde som ikke dekkes i andre felt.</items>
            </items>
            <items code="at0019">
                <items id="text">Konfunderende faktorer</items>
                <items id="description">Registrering av faktorer som kan ha innflytelse på måling av kroppslengden.</items>
                <items id="comment">For eksempel: Notat om amputasjon, lue, håroppsett, klemmer eller lignende.</items>
            </items>
            <items code="at0020">
                <items id="text">Liggende</items>
                <items id="description">Lengde måles i en helt utstrakt, liggende posisjon med bekkenet flatt, beina strekte og føtter verken flektert eller ekstendert.</items>
            </items>
            <items code="at0021">
                <items id="text">Fødsel</items>
                <items id="description">Den første lengden målt etter fødselen. Denne hendelsen skal kun benyttes én gang per journal.</items>
            </items>
            <items code="at0022">
                <items id="text">Tilleggsinformasjon</items>
                <items id="description">Ytterligere informasjon som trengs for å kunne registrere lokalt definert innhold eller for å tilpasse til andre referansemodeller/formalismer.</items>
                <items id="comment">For eksempel lokale informasjonsbehov eller ytterligere metadata for å kunne tilpasse til tilsvarende konsepter i FHIR eller CIMI.</items>
            </items>
            <items code="[in_i]">
                <items id="text">in</items>
                <items id="description">inch</items>
            </items>
        </term_definitions>
    </component_ontologies>
    <component_ontologies archetype_id="openEHR-EHR-OBSERVATION.body_weight.v2">
        <term_definitions language="pt-br">
            <items code="at0000">
                <items id="text">Peso corporal</items>
                <items id="description">A medição do peso corporal de um indivíduo.</items>
            </items>
            <items code="at0001">
                <items id="text">Simple</items>
                <items id="description">@ internal @</items>
            </items>
            <items code="at0002">
                <items id="text">history</items>
                <items id="description">@ internal @</items>
            </items>
            <items code="at0003">
                <items id="text">Qualquer evento</items>
                <items id="description">Padrão, ponto específico no tempo ou intervalo que pode ser explicitamente definido em template ou em tempo de execução.</items>
            </items>
            <items code="at0004">
                <items id="text">Peso</items>
                <items id="description">O peso do indivíduo.</items>
            </items>
            <items code="at0008">
                <items id="text">state structure</items>
                <items id="description">@ internal @</items>
            </items>
            <items code="at0009">
                <items id="text">Situação do vestuário</items>
                <items id="description">Descrição da situação do vestuário do indivíduo no momento da pesagem.</items>
            </items>
            <items code="at0010">
                <items id="text">Totalmente vestida, incluindo sapatos</items>
                <items id="description">Roupas que podem aumentar significativamente o peso, incluindo sapatos.</items>
            </items>
            <items code="at0011">
                <items id="text">Levemente vestido / roupa íntimas</items>
                <items id="description">Roupas que não irão acrescentar ao peso de forma significativa.</items>
            </items>
            <items code="at0013">
                <items id="text">Despido</items>
                <items id="description">Sem nenhuma roupa.</items>
            </items>
            <items code="at0015">
                <items id="text">protocol structure</items>
                <items id="description">@ internal @</items>
            </items>
            <items code="at0017">
                <items id="text">Fralda</items>
                <items id="description">Vestindo apenas uma fralda - pode adicionar peso significativo.</items>
            </items>
            <items code="at0020">
                <items id="text">Dispositivo</items>
                <items id="description">Detalhes sobre o dispositivo de pesagem.</items>
            </items>
            <items code="at0024">
                <items id="text">Comentário</items>
                <items id="description">Narrativa adicional sobre a medida de peso corporal, não capturado em outros campos.</items>
            </items>
            <items code="at0025">
                <items id="text">Fatores de confundimento</items>
                <items id="description">Registra qualquer problemas ou fatores que impactam na medida do peso corporal pe período menstrual, período recente de movimento peristáltico e observação de amputação.</items>
            </items>
            <items code="at0026">
                <items id="text">Nascimento</items>
                <items id="description">Normalmente o primeiro peso, medido ao nascer.</items>
            </items>
            <items code="at0027">
                <items id="text">Extensão</items>
                <items id="description">Informação adicional requerida para capturar conteúdo local ou para alinhar a outros modelos de referência/formalismos.</items>
                <items id="comment">Por exemplo: informações locais necessárias ou metadados adicionais para alinhamento ao FHIR ou outras iniciativas equivalentes de modelagem do conhecimento clínico.</items>
            </items>
            <items code="at0028">
                <items id="text">Totalmente vestida, sem sapatos</items>
                <items id="description">Roupas que podem aumentar significativamente o peso.</items>
            </items>
            <items code="[lb_av]">
                <items id="text">lbm</items>
                <items id="description">pound mass</items>
            </items>
        </term_definitions>
        <term_definitions language="sv">
            <items code="at0000">
                <items id="text">Kroppsvikt</items>
                <items id="description">Mätning av en individs kroppsvikt.</items>
            </items>
            <items code="at0001">
                <items id="text">Simple</items>
                <items id="description">@ internal @</items>
            </items>
            <items code="at0002">
                <items id="text">history</items>
                <items id="description">@ internal @</items>
            </items>
            <items code="at0003">
                <items id="text">Ospecificerad händelse</items>
                <items id="description">Ospecificerad standardhändelse vid en tidpunkt eller inom ett tidsintervall som explicit kan definieras i en mall eller genereras automatiskt av vissa IT-system.</items>
            </items>
            <items code="at0004">
                <items id="text">Vikt</items>
                <items id="description">Individens vikt.</items>
            </items>
            <items code="at0008">
                <items id="text">state structure</items>
                <items id="description">@ internal @</items>
            </items>
            <items code="at0009">
                <items id="text">Klädsel</items>
                <items id="description">Beskrivning av individens klädsel vid tidpunkten för vägning.</items>
            </items>
            <items code="at0010">
                <items id="text">Fullt påklädd, inklusive skor</items>
                <items id="description">Kläder, inklusive skor, som kan öka vikten avsevärt.</items>
            </items>
            <items code="at0011">
                <items id="text">Lätt klädd/underkläder</items>
                <items id="description">Kläder som inte ökar vikten avsevärt.</items>
            </items>
            <items code="at0013">
                <items id="text">Naken</items>
                <items id="description">Inga kläder alls.</items>
            </items>
            <items code="at0015">
                <items id="text">protocol structure</items>
                <items id="description">@ internal @</items>
            </items>
            <items code="at0017">
                <items id="text">Blöja</items>
                <items id="description">Iklädd endast blöja, som kan öka vikten avsevärt.</items>
            </items>
            <items code="at0020">
                <items id="text">Utrustning</items>
                <items id="description">Detaljer om den utrustning som används för att mäta vikten.</items>
            </items>
            <items code="at0024">
                <items id="text">Kommentar</items>
                <items id="description">Kommentarer avseende mätningen av kroppsvikt, som inte beskrivs i övriga datafält.</items>
            </items>
            <items code="at0025">
                <items id="text">Möjliga felkällor</items>
                <items id="description">Beskrivning av faktorer och felkällor som kan påverka mätningen av kroppsvikt, exempelvis tidpunkt i menstruationscykeln, tid sedan senaste tarmtömning eller amputation.</items>
            </items>
            <items code="at0026">
                <items id="text">Födelse</items>
                <items id="description">Vanligtvis den första vägningen av barnet, strax efter födseln. Den här händelsen registreras endast en gång per patientjournal.</items>
            </items>
            <items code="at0027">
                <items id="text">Tilläggsinformation</items>
                <items id="description">Plats för att infoga tilläggsinformation som krävs för lokala anpassningar eller anpassning till andra referensmodeller eller formella krav.</items>
                <items id="comment">Exempelvis lokala informationskrav eller metadata för anpassning till FHIR.</items>
            </items>
            <items code="at0028">
                <items id="text">Fullt påklädd, utan skor</items>
                <items id="description">Kläder som kan öka vikten avsevärt.</items>
            </items>
            <items code="[lb_av]">
                <items id="text">lbm</items>
                <items id="description">pound mass</items>
            </items>
        </term_definitions>
        <term_definitions language="de">
            <items code="at0000">
                <items id="text">Körpergewicht</items>
                <items id="description">Messung des Körpergewichts eines Individuums.</items>
            </items>
            <items code="at0001">
                <items id="text">Simple</items>
                <items id="description">@ internal @</items>
            </items>
            <items code="at0002">
                <items id="text">History</items>
                <items id="description">@ internal @</items>
            </items>
            <items code="at0003">
                <items id="text">Beliebiges Ereignis</items>
                <items id="description">Standardwert, ein undefinierter/s Zeitpunkt oder Intervallereignis, das explizit im Template oder zur Laufzeit der Anwendung definiert werden kann.</items>
            </items>
            <items code="at0004">
                <items id="text">Gewicht</items>
                <items id="description">Das Gewicht eines Individuums.</items>
            </items>
            <items code="at0008">
                <items id="text">State structure</items>
                <items id="description">@ internal @</items>
            </items>
            <items code="at0009">
                <items id="text">Status der Bekleidung</items>
                <items id="description">Beschreibung des Kleidungszustands der Person zum Zeitpunkt des Wiegens.</items>
            </items>
            <items code="at0010">
                <items id="text">Voll bekleidet, mit Schuhen</items>
                <items id="description">Bekleidung, die signifikant zum Gewicht beiträgt, mit Schuhen.</items>
            </items>
            <items code="at0011">
                <items id="text">Leicht bekleidet / Unterwäsche</items>
                <items id="description">Bekleidung, die nicht signifikant zum Gewicht beiträgt.</items>
            </items>
            <items code="at0013">
                <items id="text">Unbekleidet</items>
                <items id="description">Ohne Kleidung.</items>
            </items>
            <items code="at0015">
                <items id="text">Protocol structure</items>
                <items id="description">@ internal @</items>
            </items>
            <items code="at0017">
                <items id="text">Windel</items>
                <items id="description">Trägt Windel; kann signifikant zum Gewicht beitragen.</items>
            </items>
            <items code="at0020">
                <items id="text">Gerät</items>
                <items id="description">Details über die benutzte Waage.</items>
            </items>
            <items code="at0024">
                <items id="text">Kommentar</items>
                <items id="description">Zusätzliche Darstellung der Messung des Körpergewichts, die in anderen Bereichen nicht erfasst wurde.&#13;
	</items>
            </items>
            <items code="at0025">
                <items id="text">Einflussfaktoren</items>
                <items id="description">Beschreibung aller Probleme oder Faktoren, die sich auf die Messung des Körpergewichts auswirken können, z. B. das Timing im Menstruationszyklus, das Timing des letzten Stuhlgangs oder das Feststellen einer Amputation.</items>
            </items>
            <items code="at0026">
                <items id="text">Geburt</items>
                <items id="description">Normalerweise das erste Gewicht, gemessen kurz nach der Geburt. Dieses Ereignis wird nur einmal pro Gesundheitsakte verwendet.</items>
            </items>
            <items code="at0027">
                <items id="text">Erweiterung</items>
                <items id="description">Zusätzliche Informationen zur Erfassung lokaler Inhalte oder Anpassung an andere Referenzmodelle/Formalismen.</items>
                <items id="comment">Zum Beispiel: Lokaler Informationsbedarf oder zusätzliche Metadaten zur Anpassung an FHIR-Ressourcen oder CIMI-Modelle.</items>
            </items>
            <items code="at0028">
                <items id="text">Voll bekleidet, ohne Schuhen</items>
                <items id="description">Bekleidung, die signifikant zum Gewicht beiträgt.</items>
            </items>
            <items code="[lb_av]">
                <items id="text">lbm</items>
                <items id="description">pound mass</items>
            </items>
        </term_definitions>
        <term_definitions language="nb">
            <items code="at0000">
                <items id="text">Kroppsvekt</items>
                <items id="description">Individets kroppsvekt.</items>
            </items>
            <items code="at0001">
                <items id="text">Simple</items>
                <items id="description">@ internal @</items>
            </items>
            <items code="at0002">
                <items id="text">history</items>
                <items id="description">@ internal @</items>
            </items>
            <items code="at0003">
                <items id="text">Uspesifisert hendelse</items>
                <items id="description">Standard, uspesifisert tidspunkt eller tidsintervall som kan defineres mer eksplisitt i et templat eller i en applikasjon.</items>
            </items>
            <items code="at0004">
                <items id="text">Kroppsvekt</items>
                <items id="description">Et individs totale kroppsmasse.</items>
            </items>
            <items code="at0008">
                <items id="text">state structure</items>
                <items id="description">@ internal @</items>
            </items>
            <items code="at0009">
                <items id="text">Påkledning</items>
                <items id="description">Beskrivelse av personens påkledning på måletidspunktet.</items>
            </items>
            <items code="at0010">
                <items id="text">Fullt påkledt inklusive sko</items>
                <items id="description">Påkledning som kan øke vekten signifikant, inklusive sko.</items>
            </items>
            <items code="at0011">
                <items id="text">Lette klær / undertøy</items>
                <items id="description">Påkledning som ikke endrer vekten signifikant.</items>
            </items>
            <items code="at0013">
                <items id="text">Naken</items>
                <items id="description">Uten klær.</items>
            </items>
            <items code="at0015">
                <items id="text">protocol structure</items>
                <items id="description">@ internal @</items>
            </items>
            <items code="at0017">
                <items id="text">Bleie</items>
                <items id="description">Bare ikledt bleie - kan legge til signifikant vekt.</items>
            </items>
            <items code="at0020">
                <items id="text">Måleapparat</items>
                <items id="description">Detaljer om måleapparatet brukt til vektmålingen.</items>
            </items>
            <items code="at0024">
                <items id="text">Kommentar</items>
                <items id="description">Ytterligere beskrivelse av målingen av kroppsvekt som ikke dekkes i andre felt.</items>
            </items>
            <items code="at0025">
                <items id="text">Konfunderende faktorer</items>
                <items id="description">Registering av emner eller faktorer som kan ha betydning for måling av kroppsvekten, f.eks. inntak av mat og drikke, stort saltinntak, menstruasjonssyklus, tidspunkt for avføring, ødem eller uke av graviditet.</items>
            </items>
            <items code="at0026">
                <items id="text">Fødsel</items>
                <items id="description">Den første vekten målt etter fødselen. Denne hendelsen skal kun benyttes én gang per journal.</items>
            </items>
            <items code="at0027">
                <items id="text">Tilleggsinformasjon</items>
                <items id="description">Ytterligere informasjon som trengs for å kunne registrere lokalt definert innhold eller for å tilpasse til andre referansemodeller/formalismer.</items>
                <items id="comment">For eksempel lokale informasjonsbehov eller ytterligere metadata for å kunne tilpasse til tilsvarende konsepter i FHIR eller CIMI.</items>
            </items>
            <items code="at0028">
                <items id="text">Fullt påkledt, uten sko</items>
                <items id="description">Påkledning som kan øke vekten signifikant.</items>
            </items>
            <items code="[lb_av]">
                <items id="text">lbm</items>
                <items id="description">pound mass</items>
            </items>
        </term_definitions>
    </component_ontologies>
</template>
